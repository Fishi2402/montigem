/* (c) https://github.com/MontiCore/monticore */
umlp BaseArtifactsTest {

  abstract class Artifact {
    String simpleName;
    String nameExtension;
    String modified;
    String name;
    String fullName;
  }

  class FileArtifact extends Artifact {}

  association refersTo [*] Artifact -> (referred) Artifact [*];

  association produces [*] Artifact -> (produced) Artifact [*];

  class RootArtifact {
    boolean isExternal;
    String fullName;
    String name;
  }

  association root [*] Artifact -> (root) RootArtifact [1];

  association descendants [1] RootArtifact -> (descendant) Artifact [*];

  association artifactRepresentation [1] RootArtifact -> (artifactRepresentation) Artifact [*]; // TODO Optional because of technical issue 1 <-> 1 cycles not allowed

  abstract class ArtifactContainer extends Artifact {}

  class Directory extends ArtifactContainer {}

  class Archive extends ArtifactContainer {}

  association contains [0..1] ArtifactContainer -> (contains) Artifact [*];

  abstract class ArtifactView{}

  association views [1] Artifact <-> ArtifactView [*];

  abstract class ArtifactInternal{}

  association internals [1] ArtifactView <-> ArtifactInternal [*];

  // TODO: fill/convert to interface
  abstract class Metric{}
}
