import java.time.LocalDateTime;

// TODO: CD2GUI: No private members allowed (COCO 0xF737F)


/**
* An application which represents a car rental place
*/
umlp Carrental {
// One could also use "classdiagram Carrental {", but the umlp tool prefers the first syntax

  interface Rentable {
    boolean isAvailable();
  }

  abstract class RentableItem implements Rentable  {
    String name;
    // TODO: java.util.List<capture#1 of ? extends java.lang.Object> cannot be converted to java.util.List<mc.fenix.input.Option>
    //RentableStatus rentableStatus; // TODO: MUST NOT BE AN ASSOC
  }


  // EX: Add implements?
  class Car extends RentableItem  {
    String model;
    String make;
    derived float mileage;   // EX: Implement
  }

// TODO CD2GUI: enum leads to: CarDetailsEdit.gui:<17,565>: 0xF737F given expression of type Car unable to derive the type of the access ".rentableStatus"
  enum RentableStatus {
    AVAILABLE, RENTED, MAINTENANCE; // EX: Add MAINTENANCE
 }
//  association Car -> RentableStatus [1]; //  MUST NOT BE AN ASSOC

  class RentalTransaction {
    // We can also use Java types, such as LocalDateTime (which we have imported above)
    LocalDateTime rentalDate;
    LocalDateTime returnDate;  // EX: Add return Date
    float totalCost;
  }
  // TODO: MUSE BE -> (?)
// TODO: Fails to compile? //  association [1] RentalTransaction -> Customer [*];
  association [*] RentalTransaction <-> Customer [1];

   class Customer {
     String name;
     String email; //EX: Add E-Mail
   }


  <<singleton>>  // There only ever exists one instance of a singleton
  class RentalService {
    RentalTransaction rentItem (Customer customer, Rentable rentable);
    void returnItem(RentalTransaction rentalTransaction);
    void processPayment(RentalTransaction rentalTransaction);  // EX: add another command
  }

   association [1] RentalService -> RentableItem [*]; // TODO: using the interface: 0xF737F given expression of type Rentable unable to derive the type of the access ".gemId"
   association [1] RentalService -> RentalTransaction [*]; // EX: Add assoc


  // EX: Add VIP Status
   // Some customers are special to the car rental agency
   class VIPStatus {
     String personalGreetingAtTheDesk;
   }
   //association Customer -> VIPStatus [0..1]; // TODO: [0..1] no (CD2)GUI
   association Customer -> VIPStatus [*]; // TODO: vIPStatus_VIPStatusList = CarrentalManager.gemList<VIPStatus>();



   class MileageDataPoint {
      LocalDateTime recordDate;
      float mileage;
   }
   // To be able to create a histogram, the mileage is tracked along with the data entry date.
   // TODO:  this.mileageDataPoint_MileageDataPointList = CarrentalManager.gemList<MileageDataPoint>();
   //association [1] Car -> MileageDataPoint [*];


  // Derived classes are ethereal, not stored in the database and without an identifier
  derived class CarRecommendation {
    String salesPitch;
    float estimatedCostPerMile;
  }


}
