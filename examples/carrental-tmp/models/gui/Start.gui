package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

// data class
import Carrental.Car;

page Start(List<Car> cars){
  @GemText(value = "Hello World, one of the following cars:");
  @iterate(Car c : cars) {
    @GemText(value = "Got a car");
  }
  @GemText(value = "---");


  @GemButton(label = "AddAnotherCar", leftClick = addCar);
}
