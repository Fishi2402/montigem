package coverage;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import mc.fenix.charts.GemPieChart;

import CoverageDashboard.CoverageReport;
import CoverageDashboard.App;

page AggregationDetails(App app, CoverageReport report) {
  @GemGrid(
    width = "100%",
    height = "100%",
    y = ["auto", "auto", "1fr"],
    rows = [
      [
        @GemButton(
          label = "Back",
          leftClick = backToOverview()
        )
      ],
      [
        @GemText(
          value = "Aggregated Coverage Details: " + report.name,
          size = "3.5rem",
          weight = "bold")
      ],
      [
        @GemRow(
          hAlign = "stretch",
          width = "100%",
          height = "600px",
          colGap = "15px",
          components = [
            @GemCard(
              title = "Direct coverage",
              width = "100%",
              height = "100%",
              component = @GemPieChart(data = app.getCoverageData(report.directPerspective))
            ),
            @iterate(CoveragePerspective perspective : report.aggregatedPerspectives){
              @GemCard(
                title = "Aggregated coverage - " + perspective.name,
                width = "100%",
                height = "100%",
                component = @GemPieChart(data = app.getAggregatedCoverageData(perspective))
              );
            }
          ]
        )
      ]
    ]
  );
}
