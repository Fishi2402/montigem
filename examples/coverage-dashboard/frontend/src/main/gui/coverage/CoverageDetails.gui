package coverage;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import coverage.components.SourceMapViewer;
import coverage.components.SourceViewer;
import coverage.components.ModuleTreeView;


import CoverageDashboard.App;
import CoverageDashboard.CoverageReport;
import CoverageDashboard.CoverageSourceFile;

page CoverageDetails(App app, CoverageReport report, Optional<CoverageSourceFile> selectedFile) {
    @GemGrid(
      width = "100%",
      height = "100%",
      rowGap = "20px",
      y = ["auto", "1fr"],
      rows = [
        [
          @GemButton(
            label = "Back",
            leftClick = backToOverview()
          )
        ],
        [
          @GemColumn(
            width = "100%",
            hAlign = "center",
            components = [
              @GemText(
                value = "Coverage Details",
                size = "3.5rem",
                weight = "bold")
            ])
        ],
        [
          @GemGrid(
            width = "100%",
            height = "100%",
            colGap = "10px",
            x = ["1fr", "4fr"],
            y = ["750px"],
            cols = [
              [moduleTreeView@ModuleTreeView(
                rootModule = report.module,
                name = report.name,
                fileSelect = onFileSelect())],
              [
                // Check if double-editor view is required
                @guard(isSourceMapViewRequired(report, selectedFile)){
                  @SourceMapViewer(
                    targetFile=selectedFile);
                }else{
                  @SourceViewer(
                    file = selectedFile);
                }
              ]
            ]
          )
        ]
      ]
    );
}
