package coverage;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import coverage.components.SourceMapViewer;
import coverage.components.SourceViewer;
import coverage.components.SourceUsageViewer;
import coverage.components.FileView;


import CoverageDashboard.App;
import CoverageDashboard.CoverageReport;
import CoverageDashboard.CoverageSourceFile;

page CoverageDetails(
  App app,
  CoverageReport report,
  CoveragePerspective selectedPerspective,
  List<CoverageSourceFile> activeFiles) {
    @GemGrid(
      width = "100%",
      height = "100%",
      rowGap = "20px",
      y = ["auto", "auto", "minmax(0, 1fr)"],
      rows = [
        [
          @GemButton(
            label = "Back",
            leftClick = backToOverview()
          )
        ],
        [
          @GemText(
            value = getTitle(report),
            size = "3.5rem",
            weight = "bold")
        ],
        [
          @GemGrid(
            width = "100%",
            height = "100%",
            colGap = "10px",
            x = ["1fr", "4fr"],
            y = ["minmax(0, 1fr)"],
            cols = [
              [fileView@FileView(
                report = report,
                selectedPerspective = selectedPerspective,
                activeFiles = activeFiles,
                perspectiveSelect = onPerspectiveSelect(),
                fileSelect = onFileSelect())],
              [
                // Check if double-editor view is required
                @guard(isSourceMapViewRequired(report, selectedPerspective)){
                  sourceMapViewer@SourceMapViewer(
                    targetFile = getBaseFile(activeFiles),
                    openSource = onOpenSource());
                }else{
                  @guard(isUsageViewRequired(report, selectedPerspective)){
                    sourceUsageViewer@SourceUsageViewer(
                      directPerspective = report.directPerspective,
                      file = getBaseFile(activeFiles),
                      usageSelect = onUsageSelect()
                    );
                  }else{
                    sourceViewer@SourceViewer(
                      file = getBaseFile(activeFiles));
                  }
                }
              ]
            ]
          )
        ]
      ]
    );
}
