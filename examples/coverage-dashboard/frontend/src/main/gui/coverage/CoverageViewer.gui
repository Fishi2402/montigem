package coverage;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;

import mc.fenix.editor.MonacoEditor;

import CoverageDashboard.CoverageSourceFile;

component CoverageViewer(
  CoverageSourceFile file
){
  @GemCard(title = "Coverage", height = "auto", component =
    @GemColumn(height = "100%", components = [
      @MonacoEditor(entry=file.content, language=file.type, disabled = true, autoHeight = true, highlighting = getHighlights())
    ])
  );
}
