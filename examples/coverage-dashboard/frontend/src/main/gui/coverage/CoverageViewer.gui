package coverage;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemText;

import mc.fenix.editor.MonacoEditor;

import CoverageDashboard.DummyContent;

component CoverageViewer(
  DummyContent content
){
  @GemCard(title = "Coverage", height = "auto", component =
    @GemColumn(height = "100%", components = [
      @MonacoEditor(entry=content.content, language="java", disabled = true, autoHeight = true, highlighting = getHighlights()),
      @MonacoEditor(entry=content.content, language="java", disabled = true, autoHeight = true, highlighting = getHighlights())
    ])
  );
}
