package coverage;

import java.util.List;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import mc.fenix.charts.GemLineChart;
import mc.fenix.charts.GemLineChartTypes.GemLineChartData;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.Option;

import coverage.components.GeneralDashboard;

import CoverageDashboard.App;
import CoverageDashboard.Run;

page Dashboard(
    App app,
    List<Option> runOptions,
    String selectedRunId,
    List<Run> selectedRuns,
    boolean showCciTrend,
    String cciTrendLabel,
    GemLineChartData cciChartData) {
  dashboardGrid@GemGrid(
    width = "100%",
    height = "auto",
    rowGap = "20px",
    y = ["auto", "auto", "auto"],
    rows = [
      [
        headerGrid@GemGrid(
          width = "100%",
          height = "auto",
          colGap = "16px",
          x = ["1fr", "auto", "1fr"],
          y = ["auto"],
          cols = [
            [
              @GemText(value = "")
            ],
            [
              @GemColumn(
                width = "100%",
                hAlign = "center",
                components = [
                  @GemText(
                    value = "MontiGem Coverage",
                    size = "3.5rem",
                    weight = "bold")
                ])
            ],
            [
              @GemRow(
                width = "100%",
                hAlign = "right",
                vAlign = "center",
                colGap = "10px",
                components = [
                  runDropdown@GemDropdownInput(
                    width = "440px",
                    entry = selectedRunId,
                    options = runOptions
                  ),
                  cciTrendButton@GemButton(
                    width = "auto",
                    label = cciTrendLabel,
                    leftClick = onToggleCciTrend()
                  )
                ])
            ]
          ]
        )
      ],
      [
        @guard(showCciTrend) {
          @GemCard(
            title = "CCI Development Over Runs",
            width = "100%",
            height = "450px",
            component = @GemLineChart(
              data = cciChartData,
              minValue = 0,
              maxValue = 100,
              showConfig = false
            )
          );
        }
      ],
      [
        @GeneralDashboard(app = app, runs = selectedRuns)
      ]
    ]
  );
}
