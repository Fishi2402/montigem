package coverage;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemText;

import coverage.components.GeneralDashboard;

import CoverageDashboard.App;

page Dashboard(App app) {
  @GemGrid(
    width = "100%",
    height = "100%",
    rowGap = "20px",
    y = ["auto", "1fr"],
    rows = [
      [
        @GemColumn(
          width = "100%",
          hAlign = "center",
          components = [
            @GemText(
              value = "MontiGem Coverage",
              size = "3.5rem",
              weight = "bold")
          ])
      ],
      [
        @GeneralDashboard()
      ]
    ]
  );
}
