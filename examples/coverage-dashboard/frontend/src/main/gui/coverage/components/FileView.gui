package coverage.components;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;

import CoverageDashboard.CoverageReport;
import CoverageDashboard.CoveragePerspective;
import CoverageDashboard.CoverageSourceFile;
import CoverageDashboard.ModuleFileType;

import coverage.components.ModuleTreeView;

component FileView(
    CoverageReport report,
    CoveragePerspective selectedPerspective,
    Event<CoverageSourceFile> fileSelect){
  mainGrid@GemGrid(
    width = "100%",
    height = "100%",
    rowGap = "5px",
    y = ["minmax(0, 1fr)", "auto"],
    rows = [
      [moduleTreeView@ModuleTreeView(
        rootModule = selectedPerspective.rootModule,
        name = report.name,
        fileSelect = fileSelect)],
      [
        // switch between different view -> defined by module
        viewsContainer@GemRow(
          width = "100%",
          height = "100%",
          components = [
            @iterate(String view : getPossibleViews(report)){
              @GemButton(
                label = view,
                leftClick = onViewClicked(view));
            }
          ]
        )
      ]
    ]
  );
}
