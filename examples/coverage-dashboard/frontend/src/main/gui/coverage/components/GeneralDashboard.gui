package coverage.components;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

import mc.fenix.charts.GemLineChart;

import coverage.components.ReportOverview;

import CoverageDashboard.App;

component GeneralDashboard(App app) {
  @GemGrid(
    height = "100%",
    width = "100%",
    rowGap = "15px",
    y = ["100%"],
    cols =[
     [
       @ReportOverview(app = app, report = app.getLatestComponentTest())
     ],
     [
       @ReportOverview(app = app, report = app.getLatestIntegrationTest())
     ],
     [
       @ReportOverview(app = app, report = app.getLatestGeneratedCodeTest())
     ]
    ]
  );
}
