package coverage.components;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

import mc.fenix.charts.GemLineChart;

import coverage.components.ReportOverview;

import CoverageDashboard.App;
import CoverageDashboard.TestGroup;
import CoverageDashboard.CoverageReport;

component GeneralDashboard(App app) {
  @GemColumn(
    width = "100%",
    rowGap = "20px",
    components = [
      @iterate(TestGroup group : app.getLatestTestGroups()){
        groupCard@GemCard(
          title = group.name,
          width = "100%",
          component = @GemGrid(
            width = "100%",
            colGap = "20px",
            rowGap = "20px",
            hAlign = "start",
            x = ["1fr", "1fr", "1fr"],
            rows = [
              [
                @iterate(CoverageReport report : getReportsForGroup(group)){
                  @ReportOverview(app = app, report = report);
                }
              ]
            ]
          )
        );
      }
    ]
  );
}
