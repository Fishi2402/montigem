package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemTreeNode;

import mc.fenix.basic.GemText;

import CoverageDashboard.CoverageModule;
import CoverageDashboard.CoverageSourceFile;

import coverage.components.FileItem;

component ModuleTreeView(
    CoverageModule rootModule,
    String name,
    CoverageSourceFile selectedFile,
    Boolean rootPerspective,
    Event<CoverageSourceFile> fileSelect) {
  rootNode@GemTreeNode(
    content = title@GemRow(
      width = "100%",
      components = [
        titleName@GemText(value = name, color = getCoverageColor(rootModule.metrics)),
        titleCoverage@GemText(value = getCoveragePercent(rootModule.metrics), color = getCoverageColor(rootModule.metrics))
      ]
    ),
    children = [
      // At first, show possible sub-modules
      @iterate(CoverageModule subModule : rootModule.subModules){
        subNode@GemTreeNode(
          children = [
            @ModuleTreeView(
              rootModule = subModule,
              name = subModule.name,
              selectedFile = selectedFile,
              fileSelect = fileSelect)
          ]
        );
      },
      // Then the files
      @iterate(CoverageSourceFile file : rootModule.sourceFiles){
       fileNode@GemTreeNode(
         content = content@GemRow(
           width = "100%",
           components = [
             fileName@GemText(value = getFileDisplayName(file, selectedFile), color = getCoverageColor(file.metrics)),
             fileCoverage@GemText(value = getCoveragePercent(file.metrics), color = getCoverageColor(file.metrics))
           ]
         ),
         onClick = onFileNodeClick(file)
       );
     }
    ]
  );
}
