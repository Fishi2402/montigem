package coverage.components;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemTreeNode;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import mc.fenix.charts.GemPieChart;

import CoverageDashboard.CoverageReport;
import CoverageDashboard.App;

component ReportOverview(App app, CoverageReport report) {
  reportCard@GemCard(
    title = report.name,
    component = cardGrid@GemGrid(
      x = ["1fr"],
      rows = [
        [
          @GemGrid(
            width = "100%",
            height = "100%",
            y = ["600px", "auto"],
            rows = [
              [
                directChart@GemPieChart(data = app.getCoverageData(report.directPerspective))
              ],
              [
                @guard(report.aggregatedPerspectives.size() > 0){
                  @GemButton(label = "Aggregated Coverage", leftClick = showAggregatedCoverage(report));
                }
              ]
            ]
          )
        ],
        [
          @GemButton(label = "Details", leftClick = showDetails(report))
        ]
      ]
    )
  );
}
