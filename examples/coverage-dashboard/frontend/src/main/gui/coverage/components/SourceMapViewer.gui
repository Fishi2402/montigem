package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemText;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.Option;

import mc.fenix.editor.MonacoEditor;
import mc.fenix.editor.MonacoEditorTypes.InlineDecoration;

import CoverageDashboard.CoverageSourceFile;
import coverage.components.SourceMapViewerTypes.JumpToLineEvent;

component SourceMapViewer(
    Optional<CoverageSourceFile> targetFile,
    ?String sourceContent,
    ?String targetContent,
    int jumpSourceFileLine,
    List<InlineDecoration> targetDecoration,
    List<InlineDecoration> sourceDecoration,
    String selectedSourceFile,
    List<Option> sourceFileOptions,
    String targetFileName) {
  rootGrid@GemGrid(
    width = "100%",
    height = "100%",
    colGap = "16px",
    x = ["minmax(0, 1fr)", "minmax(0, 1fr)"],
    y = ["minmax(0, 1fr)"],
    cols = [
      [
      sourceColumn@GemColumn(
        width = "100%",
        height = "100%",
        components = [
          sourceHeader@GemRow(
            width = "100%",
            height = "100%",
            hAlign = "left",
            vAlign = "center",
            components = [
              sourceLabel@GemText(width = "auto", value="Source: "),
              sourceDropdown@GemDropdownInput(
                width = "100%",
                entry = selectedSourceFile,
                options = sourceFileOptions
              )
            ]
          ),
          sourceEditor@MonacoEditor(
            width = "100%",
            height = "100%",
            entry = sourceContent,
            disabled = true,
            language = getSourceLanguage(targetFile),
            highlighting = sourceDecoration,
            jumpToLine = jumpSourceFileLine)
        ])
      ],
      [
      transpiledColumn@GemColumn(
        width = "100%",
        height = "100%",
        components = [
          transpiledHeader@GemRow(
            width = "100%",
            height = "100%",
            hAlign = "left",
            vAlign = "center",
            components = [
              transpiledLabel@GemText(width = "auto", value="Transpiled: "),
              transpiledText@GemText(width = "100%", value= targetFileName)
            ]
          ),
          targetEditor@MonacoEditor(
            width = "100%",
            height = "100%",
            entry = targetContent,
            disabled = true,
            language = getTargetLanguage(targetFile),
            highlighting = targetDecoration,
            lineClick = onTargetClick())
        ])
      ]
    ]
  );
}
