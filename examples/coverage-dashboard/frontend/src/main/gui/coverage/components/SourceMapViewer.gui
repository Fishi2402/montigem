package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;

import mc.fenix.input.GemTextInput;

import mc.fenix.editor.MonacoEditor;

import CoverageDashboard.CoverageSourceFile;
import coverage.components.SourceMapViewerTypes.JumpToLineEvent;

component SourceMapViewer(App app, ?Optional<CoverageSourceFile> targetFile, ?String sourceContent, ?String targetContent, int jumpSourceFileLine) {
  @GemGrid(
    width = "100%",
    height = "100%",
    x = ["1fr", "1fr"],
    cols = [
      [sourceEditor@MonacoEditor(
        width = "100%",
        height = "600px",
        entry = sourceContent,
        disabled = true,
        language = getSourceLanguage(targetFile),
        highlighting = getSourceHighlighting(targetFile),
        jumpToLine = jumpSourceFileLine)
      ],
      [targetEditor@MonacoEditor(
        width = "100%",
        height = "600px",
        entry = targetContent,
        disabled = true,
        language = getTargetLanguage(targetFile),
        highlighting = getTargetHighlighting(targetFile),
        lineClick = onTargetClick())
      ]
    ]
  );
}
