package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;

import mc.fenix.input.GemTextInput;

import mc.fenix.editor.MonacoEditor;
import mc.fenix.editor.MonacoEditorTypes.InlineDecoration;

import CoverageDashboard.CoverageSourceFile;
import coverage.components.SourceMapViewerTypes.JumpToLineEvent;

component SourceMapViewer(
    Optional<CoverageSourceFile> targetFile,
    ?String sourceContent,
    ?String targetContent,
    int jumpSourceFileLine,
    List<InlineDecoration> targetDecoration,
    List<InlineDecoration> sourceDecoration) {
  @GemGrid(
    width = "100%",
    height = "100%",
    x = ["minmax(0, 1fr)", "minmax(0, 1fr)"],
    cols = [
      [sourceEditor@MonacoEditor(
        width = "100%",
        height = "600px",
        entry = sourceContent,
        disabled = true,
        language = getSourceLanguage(targetFile),
        highlighting = sourceDecoration,
        jumpToLine = jumpSourceFileLine)
      ],
      [targetEditor@MonacoEditor(
        width = "100%",
        height = "600px",
        entry = targetContent,
        disabled = true,
        language = getTargetLanguage(targetFile),
        highlighting = targetDecoration,
        lineClick = onTargetClick())
      ]
    ]
  );
}
