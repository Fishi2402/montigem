package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import coverage.components.SourceViewer;

component SourceUsageViewer(
    CoveragePerspective directPerspective,
    Optional<CoverageSourceFile> file,
    Event<CoverageSourceFile> usageSelect) {
  rootGrid@GemGrid(
    width = "100%",
    height = "100%",
    x = ["3fr", "1fr"],
    y = ["minmax(0, 1fr)"],
    cols = [
      [
        sourceViewer@SourceViewer(file = file)
      ],
      [
        usagesColumn@GemGrid(
          width = "100%",
          height = "100%",
          rowGap = "8px",
          y = ["auto", "minmax(0, 1fr)"],
          rows = [
            [
              usagesHeader@GemRow(
                width = "100%",
                vAlign = "center",
                hAlign = "space-between",
                components = [
                  headerTitle@GemText(value = "Used in Generated Files", weight = "bold", size = "1.1rem"),
                  headerCount@GemText(value = getUsagesCount(file), color = "var(--text-muted)")
                ]
              )
            ],
            [
              @guard(hasUsages(file)){
                usagesList@GemColumn(
                  width = "100%",
                  height = "100%",
                  components = [
                    @iterate(CoverageSourceFile usedBy : getUsages(file)){
                      usageItem@GemButton(
                        width = "100%",
                        content = [
                          itemRow@GemRow(
                            width = "100%",
                            vAlign = "center",
                            hAlign = "space-between",
                            components = [
                              fileName@GemText(
                                value = usedBy.name,
                                weight = "medium"),
                              fileCoverage@GemText(
                                value = getCoveragePercent(usedBy.metrics),
                                color = getCoverageColor(usedBy.metrics)
                              )
                            ]
                          )
                        ],
                        leftClick = onUsedByFileSelected(usedBy)
                      );
                    }
                  ]
                );
              }else{
                emptyNotice@GemRow(
                  width = "100%",
                  components = [
                    @GemText(value = "No generated files use this template.", color = "var(--text-muted)")
                  ]
                );
              }
            ]
          ]
        )
      ]
    ]
  );
}
