package coverage.components;

import java.util.Optional;

import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import mc.fenix.basic.GemText;

import mc.fenix.editor.MonacoEditor;
import mc.fenix.editor.MonacoEditorTypes.InlineDecoration;

import CoverageDashboard.CoverageSourceFile;

component SourceViewer(
    Optional<CoverageSourceFile> file,
    ?String content,
    List<InlineDecoration> decoration,
    String language,
    String fileName) {
  rootGrid@GemGrid(
    width = "100%",
    height = "100%",
    x = ["minmax(0, 1fr)"],
    y = ["minmax(0, 1fr)"],
    cols = [
      [
      sourceColumn@GemColumn(
        width = "100%",
        height = "100%",
        components =[
          sourceHeader@GemRow(
            width = "100%",
            height = "100%",
            hAlign = "left",
            vAlign = "center",
            components = [
              fileLabel@GemText(width = "auto", value="File: "),
              fileText@GemText(width = "100%", value= fileName)
            ]
          ),
          viewer@MonacoEditor(
            width = "100%",
            entry = content,
            disabled = true,
            language = language,
            highlighting = decoration)
        ])
      ]
    ]
  );
}
