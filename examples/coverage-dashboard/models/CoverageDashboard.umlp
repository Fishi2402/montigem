import java.time.LocalDateTime;
import java.util.List;

import mc.fenix.charts.GemLineChartTypes.GemLineChartData;
import mc.fenix.charts.GemPieChartTypes.GemPieChartData;

classdiagram CoverageDashboard{

  class Run{
    String commitHash;
    LocalDateTime timestamp;
    String branchName;
    double cci;
  }

  class CoverageReport{
    String name;
    double coverageValue;
  }

  class AggregatedCoverageReport{
    String name;
    double coverageValue;
  }

  class TestGroup{
    String name;
    double cci;
  }

  enum ReportType{
    GENERATOR_UNIT_TEST,
    GENERATOR_COMPILATION_TEST,
    GENERATED_CODE_TEST;
  }

  class CoveragePerspective{
    String name;
    double coverageValue;
  }

  class CoverageModule{
    String name;
  }

  enum PerspectiveType{
    MEASURED_ROOT,
    AGGREGATED;
  }

  class CoverageSourceFile{
    String name;
    String path;
    String physicalPath;
  }

  enum ArtifactCategory{
    TEMPLATE,
    GENERATED,
    HANDWRITTEN;
  }

  class CoverageScope{
    String name;
    int startLine;
    int startColumn;
    int endLine;
    int endColumn;
  }

  abstract class CoverageLine{
    int lineNumber;
  }

  class MeasuredLine extends CoverageLine{
    int missedInstructions;
    int coveredInstructions;
    int missedBranches;
    int coveredBranches;
  }

  class UnmappedLine extends CoverageLine{
  }

  class CoverageMetrics{
    int coveredInstructions;
    int missedInstructions;
    int coveredBranches;
    int missedBranches;
    int coveredLines;
    int partialLines;
    int missedLines;
    int unmappedLines;
  }

  class CoverageColumnRange{
    int fromColumn;
    int toColumn;
    int hits;
  }

  enum ColumnRangeType{
    BRANCH,
    STATEMENT,
    PARTIAL;
  }

  <<pojo>>
  class TemplateUsage{
    CoverageSourceFile targetFile;
    List<CoverageSourceFile> chain;
  }

  composition [1] Run -> (testGroups) TestGroup [1..*];
  composition [1] Run -> (aggregatedReports) AggregatedCoverageReport [*];

  association [1] TestGroup -> (reports) CoverageReport [1..*];
  association [*] AggregatedCoverageReport -> (sourceReports) CoverageReport [1..*];
  composition [1] AggregatedCoverageReport -> (perspectives) CoveragePerspective [1..*];

  composition [1] CoverageReport -> (directPerspective) CoveragePerspective [1];
  composition [1] CoverageReport -> (aggregatedPerspectives) CoveragePerspective [*];
  association [1] CoverageReport -> (type) ReportType [1];

  association [1] CoveragePerspective -> (type) PerspectiveType [1];
  composition [1] CoveragePerspective -> (rootModule) CoverageModule [1];

  composition [1] CoverageModule -> (sourceFiles) CoverageSourceFile [*];
  composition [1] CoverageModule -> (metrics) CoverageMetrics [1];
  composition [1] CoverageModule -> (subModules) CoverageModule [*];


  composition [1] CoverageSourceFile -> (lines) CoverageLine[1..*];
  composition [1] CoverageSourceFile -> (metrics) CoverageMetrics [1];
  composition [1] CoverageSourceFile -> (scopes) CoverageScope[*];
  association [1] CoverageSourceFile -> (category) ArtifactCategory [1];
  association [1] CoverageSourceFile -> (generatedBy) CoverageSourceFile [*];


  composition [1] CoverageScope -> (metrics) CoverageMetrics [1];
  composition [1] CoverageScope -> (subScopes) CoverageScope [*];

  composition [1] MeasuredLine -> (columnRanges) CoverageColumnRange [*];

  association [1] CoverageColumnRange -> (type) ColumnRangeType [1];



  <<singleton>>
  class App{
    String getFileContent(CoverageSourceFile file);
    List<String> getLineMapping(CoverageSourceFile file);
    List<TemplateUsage> getTemplateUsages(CoverageSourceFile template, CoveragePerspective directPerspective);
    CoverageReport getLatestComponentTest(TestGroup group);
    CoverageReport getLatestIntegrationTest(TestGroup group);
    CoverageReport getLatestGeneratedCodeTest(TestGroup group);
    List<Run> getAllRuns();
    GemLineChartData getCciTrajectory();

    GemPieChartData getCoverageData(CoveragePerspective perspective);
    GemPieChartData getAggregatedCoverageData(CoveragePerspective perspective);
  }
}
