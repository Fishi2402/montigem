/* (c) https://github.com/MontiCore/monticore */
import java.time.LocalDateTime;
import java.util.List;

import mc.fenix.charts.GemLineChartTypes.GemLineChartData;

classdiagram CoverageDashboard{

  class Run{
    String commitHash;
    LocalDateTime timestamp;
    String branchName;
  }

  class CoverageReport{
    String name;
  }

  enum ReportType{
    GENERATOR_UNIT_TEST,
    GENERATOR_COMPILATION_TEST,
    GENERATED_CODE_TEST;
  }

  class CoverageModule{
    String name;
  }

  class CoverageSourceFile{
    String name;
    String path;
    String physicalPath;
  }

  enum ArtifactCategory{
    TEMPLATE,
    MODEL,
    GENERATED,
    HANDWRITTEN;
  }

  class CoverageScope{
    String name;
    int startLine;
    int startColumn;
    int endLine;
    int endColumn;
  }

  class CoverageLine{
    int lineNumber;
    int missedInstructions;
    int coveredInstructions;
    int missedBranches;
    int coveredBranches;
  }

  class CoverageMetrics{
    int coveredInstructions;
    int missedInstructions;
    int coveredBranches;
    int missedBranches;
    int coveredLines;
    int missedLines;
  }

  class CoverageColumnRange{
    int fromColumn;
    int toColumn;
    int hits;
  }

  enum ColumnRangeType{
    BRANCH,
    STATEMENT,
    PARTIAL;
  }

  association [1] Run -> (reports) CoverageReport [1..*];

  association [1] CoverageReport -> (module) CoverageModule [1];
  association [1] CoverageReport -> (type) ReportType [1];

  association [1] CoverageModule -> (sourceFiles) CoverageSourceFile [*];
  association [1] CoverageModule -> (metrics) CoverageMetrics [1];
  association [1] CoverageModule -> (subModules) CoverageModule [*];


  association [1] CoverageSourceFile -> (lines) CoverageLine[1..*];
  association [1] CoverageSourceFile -> (metrics) CoverageMetrics [1];
  association [1] CoverageSourceFile -> (scopes) CoverageScope[*];
  association [1] CoverageSourceFile -> (category) ArtifactCategory [1];
  association [1] CoverageSourceFile -> (generatedBy) CoverageSourceFile [*];


  association [1] CoverageScope -> (metrics) CoverageMetrics [1];
  association [1] CoverageScope -> (subScopes) CoverageScope [*];

  association [1] CoverageLine -> (columnRanges) CoverageColumnRange [*];

  association [1] CoverageColumnRange -> (type) ColumnRangeType [1];



  <<singleton>>
  class App{
    GemLineChartData getCoverageTrajectory();
    CoverageReport getDummyCoverageReport();
    String getFileContent(CoverageSourceFile file);
    List<String> getLineMapping(CoverageSourceFile file);
  }
}
