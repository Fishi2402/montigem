package gui.pipelines;

import mc.fenix.charts.GemBarChart;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemButton;


import Dtcockpit.Project;

page PipelineStats(Project p) {

  @GemCard(
    title = "Dashboard ",
    component = barChartForPipelineRuns@GemBarChart(
      data = null,
      stacked = false,
      maxValue = 100,
      minValue = 0
    )
  );
  @GemButton(
    label="Load PipelineInformation into Backend",
    leftClick=loadPipelineInfoIntoBackend(p),
    disabled=false
  );
}
