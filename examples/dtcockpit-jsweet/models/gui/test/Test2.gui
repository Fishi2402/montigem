package gui.test;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;

import Dtcockpit.Project;

import gui.test.TestNav;

// Show a text, different for every entry of a list
page Test2(List<Project> projects) {
  @TestNav();
  @GemText(value = "Show a text, different for every item:");
  @iterate(Project p : projects) {
    @GemText(value = "Got project named: " + p.name);
  }
  @GemText(value = "---");


  @GemButton(label = "AddProject", leftClick = addProject);
}
