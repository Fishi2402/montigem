package gui.widgets;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;


component Widget(String widgetTitle, GUIViewElement content) {
    @GemCard(
      title = widgetTitle,
      /*
      titleComponent = @GemRow(hAlign="space-between",
        components = [

          @GemText(value = widgetTitle),

          @GemRow(hAlign = "right", vAlign = "center", width = "100px", component =
            @GemButton(
              label="Edit",
              leftClick=editWidget(),
              disabled=false
            )
          )

        ]),
        */
      component = @GemColumn(
        width = "400px",
        height="300px",
        rowGap = "10px",
        component = content
      )
    );
}
