import input.GemTextInputTypes.GemTextInputValidity;

classdiagram Dtcockpit {

  <<singleton>>
  class App{
    <<command>> void sendMail(User email, String subject, String message, List<String> forwards);
  }

  association [1] App -> User [*];
  association [1] App -> Room [*];
  association [1] App -> Project [*];
  association [1] App -> Group [*];
  association [1] App -> (dashboardGroup) Group [0..1];

  class User {
    <<dbColumn = "unique=true">>
    String username;
    String password;
    java.time.LocalDateTime registrationDate;
   // ActivationStatus activated;
    <<dbColumn = "unique=true">>
    String email;
    DtcockpitRole role;
    String validityUsername();
    String validityEmail();
    String validityPassword();
  }

  enum ActivationStatus {
    AKTIVIERT,
    MAIL_NICHT_GESENDET,
    MAIL_FEHLERHAFT,
    MAIL_GESENDET;
  }

  enum DtcockpitRole {
    USER,
    ADMIN;
  }

  class Room {
    int roomNumber;
    int level;
    double temperature; // in °C
    double atmosphericPressure; // in hPa
    double humidity; // relative, in %
    boolean motionDetected;
  }

  association [1] Room <-> (rStatistics) RoomStatistic [*];

  class RoomStatistic {
    java.time.LocalDate time;
    double temperature;
    double nominalTemperature;
    boolean acActivated;
    boolean occupied;
  }

  class Group {
    String name;
    String git;
  }

  association [0..1] Group -> (subProjects) Project [*];
  association [0..1] Group -> (subGroups) Group [*];

  class Project {
    String name;
    String git;
  }

  class Branch {
    String name;
    String git;
  }

  class CIInformation {
    String variableName;
    String branchName;
  }

  association [0..1] Project -> (ciInfos) CIInformation [0..1];

  association [0..1] Project -> (dependentProjects) Project [*];

  association [0..1] Project <-> (branches) Branch [*];

  association [0..1] Project <-> (pStatistics) PipelineStatistic [*];

  class PipelineStatistic {
    java.time.LocalDate time;
    long duration;
    boolean successful;
  }

  class AggregatedPipelineStatisticsOverDate {
    java.time.LocalDate time;
    int numberOfSuccessfulRuns;
    int numberOfUnsuccessfulRuns;
  }

  association [0..1] Group <-> (statistics) AggregatedPipelineStatisticsOverDate [*];

  class Server {
    String hostname;
  }

  class ServerStatus {
    java.time.LocalDateTime time;
    int diskUsage;        // In GB
    int maxDisk;          // In GB
    int ramUsage;         // In MB
    int maxRam;           // In MB
    float processorUsage; // 0 to 1
  }

  association [1] Server -> ServerStatus [*];

  // Welcome board  @ SE front door LCD
  association [1] App -> (montiCoreProjects) Project [*];

  class Meeting {
    java.time.LocalDateTime start;
    java.time.LocalDateTime end;

    String title;
    Optional<String> location;
    Optional<String> description;
    List<String> categories;
  }

  class MessageOfTheDay {
    java.time.LocalDate date;
    String message;
  }
}
