classdiagram Dtcockpit {

  class User {
                                       <<dbColumn = "unique=true">>
    String username;
    String password;
    java.time.LocalDateTime registrationDate;
   // ActivationStatus activated;
                                        <<dbColumn = "unique=true">>
    String email;
    DtcockpitRole role;
  }

  enum ActivationStatus {
    AKTIVIERT,
    MAIL_NICHT_GESENDET,
    MAIL_FEHLERHAFT,
    MAIL_GESENDET;
  }

  enum DtcockpitRole {
    GUEST,
    REPORTER,
    DEVELOPER,
    MAINTAINER,
    OWNER;
  }

  class App {
    <<command>> void sendMail(User email, String subject, String message, List<String> forwards);
  }

}
