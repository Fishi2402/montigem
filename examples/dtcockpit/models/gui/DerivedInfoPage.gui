package gui;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemOverlay;
import mc.fenix.arrange.GemOverlayItem;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.charts.GemLineChart;

import gui.navigation.DtCockpitNavigation;
import gui.widgets.Welcome;
import gui.rooms.RoomStats;
import gui.pipelines.PipelineStatsPerGroup;

import Dtcockpit.App;
import Dtcockpit.Project;
import Dtcockpit.Group;
import Dtcockpit.RoomStatistic;
import Dtcockpit.Server;
import Dtcockpit.ServerStatus;
import Dtcockpit.DerivedInfo;
import Dtcockpit.Meeting;

page DerivedInfoPage(DerivedInfo ci) {
    @GemText(value = "someNumber" + ci.someNumber);
    @GemText(value = "someString" + ci.someString);
    @GemText(value = "randomMSG.message" + ci.randomMSG.message);
    @guard(ci.randomMeeting != null) {
      @GemText(value = "randomMeeting" + ci.randomMeeting.title);
    }
    @guard(ci.randomMeeting == null) {
      @GemText(value = "No random meeting today");
    }

    @iterate(Meeting meeting : ci.monthlyMeetings){
      @GemText(value = "meeting" + meeting.title);
    }

    @iterate(String x : ci.manyStrings){
        @GemText(value = "manyStrings" + x);
    }
}
