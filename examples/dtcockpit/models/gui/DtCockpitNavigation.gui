package gui;

import arrange.GemRow;
import arrange.GemColumn;

import basic.GemText;
import basic.GemButton;

import Dtcockpit.App;
import Dtcockpit.Project;
import Dtcockpit.Group;

import navigation.NavItem;
import navigation.NavList;

// We have to pass the list of projects as an argument, as only pages are able to observe
// The parent component should be styled like `styles: [":host{ display: flex; flex-direction: row }"]`
component DtCockpitNavigation(String username, List<Group> groups, List<Project> projects) {
@GemColumn(height="auto", components = [
  @guard(username != null){
    @GemRow(height="auto",components = [
      @NavItem(title = "User: " + username)
    ]);
  },
  @GemRow(height="auto",components = [
    @NavItem(title = "Home" , target = "/gui/Start")
  ]),
  @GemRow(height="auto",components = [
    @NavItem(title = "Projects" , target = "/gui/DtcockpitMainPage")
  ]),

  @GemRow(height="auto",components = [
    @NavList( components = [
     @iterate(Group g : groups) {
       @GemRow(height="auto",components = [
         @NavItem(title = g.getName() , target = "/gui/pipelines/PipelineStatsPerGroup/" + g.getGemId())
       ]);
     },
     @iterate(Project p : projects) {
       @GemRow(height="auto",components = [
         @NavItem(title = p.getName() , target = "/gui/pipelines/PipelineStats/" + p.getGemId())
       ]);
     }
    ]
  )]),

  @GemRow(height="auto",components = [
    @NavItem(title = "Settings" , target = "/gui/settings")
  ])
]);
}
