package gui;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;
import basic.src.lib.gemtext.GemText;
import arrange.src.lib.gemrow.GemRow;
import basic.src.lib.gemimage.GemImage;

page Start() {
  @GemColumn(width = "100%", hAlign = "center", component =
    @GemCard(title = "DT Cockpit | Welcome", component =
      @GemColumn(width = "50vw", rowGap = "10px", components = [
        @GemText(value =
          "This platform was developed using the MontiCore language workbench in a model-driven approach."),

        @GemRow(hAlign = "right", vAlign = "center", width = "300px", component =
          @GemImage(source = "assets/images/rwth_se_bild_weiss_rgb.png")
        )
      ])
    ) //card
  );
}
