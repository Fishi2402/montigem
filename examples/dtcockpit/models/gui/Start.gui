package gui;

import arrange.GemColumn;
import arrange.GemRow;
import arrange.GemCard;
import arrange.GemOverlay;
import arrange.GemOverlayItem;
import basic.GemText;
import basic.GemImage;
import charts.GemLineChart;

import gui.navigation.NavContainer;
import gui.widgets.Welcome;
import gui.rooms.RoomStats;
import gui.pipelines.PipelineStatsPerGroup;

import Dtcockpit.App;
import Dtcockpit.Project;
import Dtcockpit.Group;
import Dtcockpit.RoomStatistic;
import Dtcockpit.Server;
import Dtcockpit.ServerStatus;

page Start(
  List<App> apps,
  List<Project> projects,
  List<Group> groups,
  List<Room> rooms,
  List<Server> servers
) {
  @NavContainer(projects = projects, groups = groups, content = [
    pageRow@GemRow(wrap = "wrap", width = "100%", rowGap = "10px", colGap = "10px", hAlign = "center", components = [
      // Welcome Widget
      welcomeRow@GemRow(width = "100%", hAlign = "center", component = @GemCard(title = "Welcome", component = @Welcome())),
      // TODO: App is a singleton
      @iterate(App app : apps) {
        @GemColumn(width = "50vw", component = @PipelineStatsPerGroup(g = app.dashboardGroup));
      },
      @GemCard(title = "RamUsage (MB)", component = @GemColumn(width = "30vw", components = [
        serverChart@GemLineChart(data = null, showConfig = false)
      ])),
      @GemCard(title = "Rooms' characteristics", component = @RoomStats(stats = rooms))
    ])
  ]);
}
