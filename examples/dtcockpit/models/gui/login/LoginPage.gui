package gui.login;

import gui.login.UserLogin;
import gui.login.LoginContainer;
import Dtcockpit.DoesNotRequireLogin;

import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemLink;

page LoginPage(DoesNotRequireLogin doesNotRequireLogin) {
  @LoginContainer(component =
    @GemColumn(width = "400px", rowGap = "20px", hAlign = "center", components = [
      @UserLogin()
    ])
  );
}
