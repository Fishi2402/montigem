package gui.login;

import Dtcockpit.User;

import arrange.GemCard;
import arrange.GemRow;
import arrange.GemColumn;

import basic.GemButton;
import basic.GemText;
import input.GemTextInput;

component ResetPassword(List<User> users, User user) {
  @GemCard(title = "Reset password", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(
        labelText = "E-mail address",
        inputType = "text",
        entry = user.email,
        validity = user.validityEmail
      ),
      @GemTextInput(labelText = "New password ", inputType = "password", entry = user.password),
      @GemRow(hAlign = "center", colGap = "10px", components = [
        @GemButton(label = "Cancel", leftClick = navigateBack),
        @GemButton(label = "Reset password", leftClick = resetPassword)
      ]),
      error@GemText(value = "")
      /*
      @GemTextInput(labelText = "E-mail address", inputType = "string", entry = user.email),
      @GemRow(hAlign = "center", component =
        @GemButton(label = "Neues Passwort anfordern", leftClick = resetPassword)
      )
      /**/
    ])
  );
}
