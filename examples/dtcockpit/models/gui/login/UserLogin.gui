package gui.login;

import Dtcockpit.User;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

import basic.src.lib.gembutton.GemButton;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextinput.GemTextInput;

component UserLogin(List<User> users, User loginUser) {
  @GemCard(title = "Login", component =
    @GemColumn(hAlign = "center", rowGap = "20px", components = [
      @GemTextInput(
        labelText = "Account",
        inputType = "text",
        entry = loginUser.username,
        validity = loginUser.validityUsername,
        keyRelease = loginOnEnter
      ),
      @GemTextInput(
        labelText = "Password",
        inputType = "password",
        entry = loginUser.password,
        validity = loginUser.validityPassword,
        keyRelease = loginOnEnter
      ),
      // @GemButton(label = "Cancel", leftClick = navigateBack),
      @GemButton(label = "Sign in", leftClick = login),
      error@GemText(value = "")
    ])
  );
}
