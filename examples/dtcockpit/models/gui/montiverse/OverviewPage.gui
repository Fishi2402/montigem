package gui.montiverse;

import gui.navigation.NavContainer;
import gui.pipelines.PipelineStats;
import Dtcockpit.Project;
import Dtcockpit.Group;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemTextareaInput;

page OverviewPage(Project project, List<Group> groups, List<Project> projects) {
  @NavContainer(projects = projects, groups = groups, content = [
    @GemCard(
      title = "MontiVerse Lite",
      component = @GemColumn(hAlign = "left", rowGap = "15px", components = [
        projectList@GemRow(rowGap = "10px", colGap = "15px", wrap = "wrap", components = [
          @iterate(Project dependentProject : project.dependentProjects) {
            branchDropdown@GemDropdownInput(
              labelText = dependentProject.name,
              options = null, // via TOP
              entry = dependentProject.ciInfos.branchName,
              width = "40ch"
            );
          }
        ]),
        startButton@GemButton(
          label = "Start pipeline",
          leftClick = startPipeline(project),
          width = "fit-content"
        )
      ])
    )
  ]);
}
