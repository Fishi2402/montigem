package gui.montiverse;

import Dtcockpit.Project;
import Dtcockpit.Group;

import basic.GemButton;
import arrange.GemCard;
import arrange.GemColumn;
import arrange.GemRow;
import basic.GemText;
import input.GemTextInput;
import input.GemTextareaInput;

page OverviewPage(Group g, List<Group> groups, List<Project> projects) {
 @GemColumn(hAlign = "left", component =
    @GemCard(
      title = "MontiVerse Lite",
      component = projectList@GemRow(
        rowGap="20px",
        colGap="5px",
        components=[
          @iterate(Project p: g.subProjects) {
            pButton@GemButton(label = p.name, leftClick = showBranches(p));
          }
        ]
      )
    )
  );
  startButton@GemButton(label = "start pipeline", leftClick = startButton);
}
