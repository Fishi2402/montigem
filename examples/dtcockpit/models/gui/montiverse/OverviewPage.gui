package gui.montiverse;

import Dtcockpit.Project;
import Dtcockpit.Group;
import Dtcockpit.App;
import Dtcockpit.Room;
import Dtcockpit.Server;

import basic.GemButton;
import arrange.GemCard;
import arrange.GemColumn;
import arrange.GemRow;
import basic.GemText;
import input.GemTextInput;
import input.GemTextareaInput;

page OverviewPage(List<App> apps,
                  List<Project> projects,
                  List<Group> groups,
                  List<Room> rooms,
                  List<Server> servers) {
  @iterate(Group group: groups) {
    @guard(group.name == "MontiVerse") {
      @GemCard(title = "MontiVerse", component =
        @GemColumn(rowGap = "20px", components = [
          @iterate(Project p: group.subProjects) {
            @GemButton(label = p.name, leftClick = showBranches(p));
          }
        ])
      );
    }
  }
}
