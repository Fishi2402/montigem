package gui.navigation;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.navigation.NavItem;
import mc.fenix.navigation.NavList;

import gui.navigation.DtNavHeader;

import Dtcockpit.App;
import Dtcockpit.Project;
import Dtcockpit.Group;

component DtCockpitNavigation(List<Group> groups, List<Project> projects) {
  @NavList(components = [
    @DtNavHeader(),
    @NavItem(title = "Home", target = "/gui/Start"),
    @iterate(Project g : projects) {
      @guard(g.name=="MontiVerse") {
        montiVerseName@NavItem(title = "MontiVerse Lite", target = "/gui/montiverse/OverviewPage");
      }
    },
    // @NavItem(title = "Projects", target = "/gui/DtcockpitMainPage"),
    @NavItem(title = "TV", target = "/gui/tv/Dashboard"),
    @iterate(Group g : groups) {
      grouptNav@NavItem(title = g.name, target = "/gui/pipelines/PipelineGroupStats/" + g.name);
    },
    projectList@NavList(
        header = @NavItem(title = "Git PipelineStats"),
        components = [
          @iterate(Project p : projects) {
            projectNav@NavItem(title = p.name, target = "/gui/pipelines/PipelineStats/" + p.name);
          }
        ],
        footer = @NavItem(title = "This is an always visible footer for this navlist")
      )
  ]);
}
