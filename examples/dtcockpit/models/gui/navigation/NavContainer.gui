package gui.navigation;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import gui.navigation.DtCockpitNavigation;

import Dtcockpit.Project;
import Dtcockpit.Group;

component NavContainer(
  List<Group> groups,
  List<Project> projects,
  List<GUIViewElement> content
) {
  @GemRow(components = [
    @DtCockpitNavigation(projects = projects, groups = groups),
    mainCol@GemColumn(components = content)
  ]);
}
