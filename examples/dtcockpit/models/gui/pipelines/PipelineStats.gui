package gui.pipelines;

import mc.fenix.charts.GemBarChart;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;

import gui.navigation.DtCockpitNavigation;
import Dtcockpit.Project;

page PipelineStats(Project p, List<Group> groups, List<Project> projects) {
  @GemRow(wrap = "nowrap", components = [
    @DtCockpitNavigation(projects = projects, groups = groups),
    @GemColumn(components = [
      @GemCard(
        title = "Pipeline dashboard for " + p.name,
        component = barChartForPipelineRuns@GemBarChart(
          data = null,
          stacked = false,
          maxValue = 100,
          minValue = 0,
          showConfig = false
        )
      ),
      @GemButton(
        label = "Load PipelineInformation into Backend",
        leftClick = loadPipelineInfoIntoBackend(p),
        disabled = false
      )
    ])
  ]);
}
