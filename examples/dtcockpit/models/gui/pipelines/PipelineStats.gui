package gui.pipelines;

import charts.GemBarChart;
import arrange.GemCard;
import arrange.GemRow;
import arrange.GemColumn;
import basic.GemButton;

import gui.navigation.NavContainer;
import Dtcockpit.Project;

page PipelineStats(Project p, List<Group> groups, List<Project> projects) {
  @NavContainer(projects = projects, groups = groups, content = [
    @GemColumn(components = [
      @GemCard(
        title = "Pipeline dashboard for " + p.name,
        component = barChartForPipelineRuns@GemBarChart(
          data = null,
          stacked = false,
          maxValue = 100,
          minValue = 0,
          showConfig = false
        )
      ),
      @GemButton(
        label = "Load PipelineInformation into Backend",
        leftClick = loadPipelineInfoIntoBackend(p),
        disabled = false
      )
    ])
  ]);
}
