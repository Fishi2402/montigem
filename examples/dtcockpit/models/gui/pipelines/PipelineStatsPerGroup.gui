package gui.pipelines;

import mc.fenix.charts.GemBarChart;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import Dtcockpit.Project;
import Dtcockpit.Group;

component PipelineStatsPerGroup(Group g, List<Group> groups, List<Project> projects) {

  pipelineBarChart@GemCard(
    title = "Pipeline dashboard for " + g.name,
    component = @GemColumn(rowGap = "20px", components = [
      barChartForPipelineRuns@GemBarChart(
        data = null,
        stacked = false,
        maxValue = 100,
        minValue = 0,
        showConfig = false
      ),
      filterComponents@GemRow(colGap = "1%", vAlign = "bottom", components = [
        minDate@GemTextInput(
          id = "minimumDate",
          labelText = "From:",
          inputType = "date",
          width = "auto",
          entry = null
        ),
        maxDate@GemTextInput(
          id = "maximumDate",
          labelText = "To:",
          inputType = "date",
          width = "auto",
          entry = null
        ),
        stackedToggle@GemButton(
          label = "Balken nebeneinander anzeigen",
          leftClick = toggleStackedInfo(),
          width = "auto",
          height = "3.6ch"
        )
      ])
    ])
  );
}
