package gui.pipelines;

import charts.GemBarChart;
import arrange.GemCard;
import basic.GemButton;
import input.GemTextInput;
import arrange.GemRow;
import arrange.GemColumn;

import Dtcockpit.Project;
import Dtcockpit.Group;

page PipelineStatsPerGroup(Group g) {

  pipelineBarChart@GemCard(
    title = "Pipeline dashboard for " + g.name,
    component = @GemColumn(rowGap = "20px", components = [
      barChartForPipelineRuns@GemBarChart(
        data = null,
        stacked = false,
        maxValue = 100,
        minValue = 0
      ),
      filterComponents@GemRow(colGap = "1%", vAlign = "bottom", components = [
        minDate@GemTextInput(
          id = "minimumDate",
          labelText = "From:",
          inputType = "date",
          width = "auto",
          entry = null
        ),
        maxDate@GemTextInput(
          id = "maximumDate",
          labelText = "To:",
          inputType = "date",
          width = "auto",
          entry = null
        ),
        stackedToggle@GemButton(
          label = "Balken nebeneinander anzeigen",
          leftClick = toggleStackedInfo
        )
      ])
    ])
  );
}
