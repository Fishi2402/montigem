package gui.project;

import Dtcockpit.Group;

import arrange.GemCard;
import arrange.GemColumn;
import arrange.GemRow;
import basic.GemText;
import basic.GemButton;
import input.GemTextInput;

page ProjectsCreateByGroup(Group group){

  @GemColumn(width = "100%", hAlign = "center", component =
    @GemCard(title = "New Group", component =
      @GemColumn(width = "50vw", rowGap = "10px", components = [
        createTitle@GemTextInput(labelText = "Group Title", entry = group.name, disabled = false),
        createGitID@GemTextInput(labelText = "Git", entry = group.git, disabled = false),
        error@GemText(value = ""),
        @GemButton(label = "Create alle projects in group", leftClick = createGroup, disabled = false),
        @GemButton(label = "Abort", leftClick = navigateBack, disabled = false)
      ])
    ) // end card
  ); // end column
}
