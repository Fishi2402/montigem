package gui.tv;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import gui.tv.LastPipelineStat;
import gui.widgets.Calendar;

import Dtcockpit.App;
import Dtcockpit.Project;

page Dashboard(List<App> apps) {
  // TODO AGe: singleton App
  @iterate(App app : apps) {
    @GemRow(hAlign = "space-between", rowGap = "5px", components = [
      @GemColumn(components = [
        @GemCard(title = "Message of the day", component =
          @GemColumn(components = [
            message@GemText(value = "\"" + app.currentMessage.message + "\""),
            @GemRow(hAlign = "right", components = [
              @GemText(value = app.currentMessage.date)
            ])
          ])
        )
      ]),
      @GemColumn(width = "33.3%", components = [
        pipelinesCard@GemCard(title = "Pipeline status", component =
          @iterate(Project p : app.montiCoreProjects) {
            @LastPipelineStat(p = p);
          }
        )
      ]),
      @GemColumn(width = "66.5%", components = [
        @GemCard(title = "Important dates", component = calendar@Calendar(meetings = null))
      ])
    ]);
  }
}
