package gui.widgets;

/**
  * Display a circle with a "\_"-shaped line and text at the end of the line. Used to show
  * information for a part of a figure
  * @param topInfo text at the top of horizontal end of the line
  * @param botInfo text at the bottom of horizontal end of the line
  * @direction direction of the line from the circle. "up" or "down".
  */
component LineWithInfo(
  String topInfo = "",
  String botInfo = "",
  String direction = "down"
)
