package gui.widgets;

import arrange.GemCard;
import arrange.GemRow;
import arrange.GemColumn;
import basic.GemText;
import basic.GemImage;

component Welcome() {
  @GemColumn(
    rowGap = "10px",
    component = @GemColumn(components = [
      @GemText(value = "This platform was developed using the MontiCore language workbench in"
          + " a model-driven approach."),
      @GemRow(hAlign = "right", vAlign = "center", width = "300px", component = @GemImage(
        source = "assets/images/rwth_se_bild_weiss_rgb.png"
      ))
    ])
  );
}
