import java.time.LocalDate;
import LoginModule.*;

<<extends="LoginModule">>
classdiagram Finanzverwaltung {

   enum Role {
     USER,
     ADMIN;
   }

   class User extends LoginModuleUser {
     Role role;
   }

   <<singleton>>
   class App {
   }

   association [1] App -> User [*];
}
