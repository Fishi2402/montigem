import java.time.LocalDate;

classdiagram Finanzverwaltung {

   enum Role {
     USER,
     ADMIN;
   }

   class User {
     <<dbColumn = "unique=true">>
     String username;
     String password;
     LocalDate registrationDate;
     <<dbColumn = "unique=true">>
     String email;
     Role role;
     String validityUsername();
     String validityEmail();
     String validityPassword();
   }

   <<singleton>>
   class App {
   }

   association [1] App -> User [*];
}
