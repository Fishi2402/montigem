{
  "adapters": [
    "umlp.jsweet.extension.domainAdapters.UMLPCollectionsAdapter",
    "umlp.jsweet.extension.domainAdapters.UMLPJavaBasicsAdapter",
    "umlp.jsweet.extension.domainAdapters.UMLPRTEImportAdapter",
    "umlp.jsweet.extension.domainAdapters.UMLPBasicsAdapter"
  ],
  "@Async": {
    "include": [
      "hardy.flensburg.commands.**.doRun*",
      "hardy.flensburg.requests.**.doRun*",
      "hardy.flensburg.FlensburgManager*._doGet*Sure*",
      "hardy.flensburg.FlensburgManager*._do*Opt*",
      "hardy.flensburg.FlensburgManager*._doGet*",
      "**.*DeSer.serialize(*)",
      "**.*DeSer.deserialize(*)",
      "**.*DeSer.fromJson(*)",
      "**.*DeSer.fromJsonObject(*)",
      "**.*DeSer.fromJsonString(*)",
      "**.*DeSer.buildJson(*)",
      "**.FlensburgCommandObjectMapper.*serialize*(*)"
    ]
  },
  "@Replace('return Promise.resolve(\'\"\' + obj.toLocaleDateString() + \'\"\');')": {
    "include": ["hardy.flensburg.DateDeSer.serialize(*)"]
  },
  "@Replace('return Promise.resolve(new Date(str.slice(1, str.length - 1)));')": {
    "include": ["hardy.flensburg.DateDeSer.deserialize(*)"]
  }
}
