package stanley.my;

import hardy.Flensburg.Account;
import hardy.Flensburg.Budget;
import hardy.Flensburg.Transaction;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

component CustomAccountView(Account acc, List<Budget> bs) {
  // @iterate(Budget b : acc.budget) {
    // @iterate(Transaction t : b.transaction) {
    @iterate(Budget b : bs) {
    @GemText(value = b.name);
        @GemText(value = b.balance);
        // shows DOLLAR or EURO or 0 or 1 or ...
        @GemTextInput(entry = b.cur);
        @GemText(value = b.cur);
        @GemTextInput(entry = b.curOpt);
        @GemText(value = b.curOpt);

        @iterate(Transaction t : b.transaction) {
          @GemText(value = t.date);
        }
    }
}
