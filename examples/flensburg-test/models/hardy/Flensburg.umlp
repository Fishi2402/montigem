package hardy;

import java.time.LocalDate;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

/*
 * Simple class diagram with 3 classes, some assocs, and inheritance
 */

classdiagram Flensburg {

    class Car {
      boolean wheelLeft; // Test Boolean values
      List<String> namesOfAllParts;
    }

  class Human {
    int age;
  }

  class  Person extends Human {
    String nickname;

    // calculated attribute: wird nicht persistiert,
    // deshalb gibt es nur einen getter, der dies berechnet
    / String clubname;  // wird als nickname +"@"+ mainResidence.city  realisiert
  }

  class Address {
   String city;
  }

  association [1] Person -> (owns) Car [*];
  association [1] Person -> (mainResidence) Address [1];

  association visits [*] Person (visitor) <-> (visited) Address [*];
  // man beachte hier die intern gekapselte bidirektionale Verwaltung
  association parent [1] Person -> (children) Person [*];

  // ---------------------------------------------------------------------------

  // folgende Klasse ist nicht(!) zu persistieren und kann zu Berechnungen im
  // Server oder auch zur Anzeige von Daten dienen:

  // todo: Entscheidung zu: Markierung für nicht-speicherung bei Klassen
  // und Assoziaionen?
  // Optionen: Ablage in extra Modell? Oder Stereotyp? Oder Tagging --
  // Wir nehmen hier jetzt erstmal die einfachste Lösung:
  // Stereotyp <calculated> oder geht auch "/"?
  / class CityInfo {
    int numberOfCities;
    int totalNumberOfCars;
    String cityWithMostCars;
    Person personWithMostCars;
    int averageNumberOfCars;
  }

  / association CityInfo -> (cities) java.lang.String [*];

  class Account {
    String name;
    Optional<String> tag;
    Optional<String> category;
  }

  enum Currency {
    DOLLAR, EURO;
  }

  association [1] Account -> (budget) Budget [*];

  class Budget {
    String name;
    long balance;
    Optional<Currency> cur;
    Optional<String> tag;
    Optional<String> category;
  }

  association [1] Budget -> (transaction) Transaction [*];

  class Transaction {
    LocalDate date;
    long amount;
  }

  class Invoice {
    / long sum;
  }

  association [1] Invoice -> (expense) Transaction [*];

  / class MonthlyReport {
    int month;
    long balanceChange;
  }

  / association [1] MonthlyReport -> (monthlyTransaction) Transaction [*];
}
