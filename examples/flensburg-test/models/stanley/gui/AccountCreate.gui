package stanley.gui;

import hardy.Flensburg.Account;

import basic.GemText;
import basic.GemButton;
import input.GemTextInput;
import table.GemTable;

import stanley.my.CustomAccountView;

page AccountCreate(Account acc) {
  @GemText(value = "New Account");
  @GemTextInput(entry = acc.name);
  // TODO AGe: GemTable in Java requires TableColumn class
  // @GemTable(rows = acc.budget);
  @GemButton(label = "Save");
  @CustomAccountView();
}
