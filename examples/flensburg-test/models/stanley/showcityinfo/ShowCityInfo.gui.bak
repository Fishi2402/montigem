      TableRow("Person with most cars", ci.personWithMostCars.nickname),
      TableRow("Average number of cars", ci.averageNumberOfCars)
    ]
  ); */

  // list of cities
  @GemText(value = "List of cities");
/*  @iterate(cityName : ci.cities) { // TODO AG: The expression at source position ShowCityInfo.gui:<35,23> cannot be calculated.
    @GemTextInput(value = cityName);
  }*/
}
