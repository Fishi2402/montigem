package stanley.personcreate;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// hier werden die Datenklassen gefunden
import Flensburg.Person;

// hier werden importierte GUI-Modelle gefunden
import stanley.tmp.io.input.GemTextInput;
import stanley.tmp.io.input.GemNumberInput;
import stanley.tmp.io.GemButton;

import stanley.tmp.layout.GemCard;
import stanley.tmp.layout.GemColumn;

/**
 * This example defines a
 * Form to fill out person data
 * it has only simple default layout, which generates some
 * interesting pieces of code
 *
 * Situation is that the Person will be newly created
 */
// AGe: Es gibt keinen Unterschied zu dem Person.gui Modell, wenn keine Person beim Navigieren
// auf die Seite im Modell eingegeben wird, wird PersonBuilder automatisch erstellt und
// "aktualisiert".
page PersonCreate(Person p) {
  card@GemCard(
    title = "Create Person",
    content = col@GemColumn(contents = [
      name@GemTextInput(value = p.nickname),
      age@GemNumberInput(value = p.age),
      save@GemButton(text = "Save", leftClick = create)
    ])
  );
}
