package stanley.personstatistics;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// siehe: PersonEdit.gui

import Flensburg.Person;

import stanley.tmp.charts.GemPie;

// hier werden handgeschriebene Java Erweiterungen importiert

/**
 * This example defines a
 * Table to show data of several Persons
 *
 * Assumption: several Persons ps exist, statistics are calculated and shown in a pie chart
 */
page PersonStatistics(List<Person> ps) {

  // Pie chart showing statistics (implementation in Java hwc)
  @GemPie(entries = getData(ps));

}

