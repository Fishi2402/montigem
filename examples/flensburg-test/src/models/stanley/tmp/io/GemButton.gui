package stanley.tmp.io;

/** Button component interface definition. Uses built-in Event type to define an
    event, which can be bound to a function call
*/
component GemButton(   // COCO w: groß geschrieben, e: == Dateiname
  String text = "", // e: COCO initilaer Wert Typ korrekt, (compatibility of type)
  // allow underspecified generic types
  // Event has a type parameter defining what object has to be processed,
  // Void in case nothing has to be processed
  // Event<Void> leftClick is a valid definition in a case below
  // Event<MouseEvent> is more appropriate, but MouseEvent has complex signature
  Event leftClick
)
