package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;

import gui.navigation.GuidslPaperNavigation;

import Guidslpaper.Person;
import Guidslpaper.Konto;

page GuidslpaperMainPage(List<Person> personen, List<Konto> konten) {
  @GuidslPaperNavigation();

  @GemColumn(hAlign = "left", component =
    @GemCard(
      title = "Dashboard",
      component = personenList@GemRow(
        rowGap="20px",
        colGap="5px",
        components=[
          @iterate(Person p : personen) {
            pButton@GemButton(label = p.kuerzel, leftClick = navigateToPerson(p));
          },
          newButton@GemButton(label = "+", leftClick = navigateToNewPerson())
        ]
      )
    )
  );
}
