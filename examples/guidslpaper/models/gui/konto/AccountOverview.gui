package gui.konto;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;

import gui.common.BalanceBox;

import Guidslpaper.Konto;

page AccountOverview(List<Konto> accounts) {
  @GemCard(
    titleComponent = @GemRow(hAlign = "space-between", components = [
      @GemText(value = "Accounts overview"),
      @GemRow(width = "70%", hAlign = "right", vAlign = "center", colGap = "0.5rem", components = [
        @GemButton(width = "auto", label = "Add acount"),
        @GemButton(width = "auto", label = "?")
      ])
    ]),
    component = @GemTable(
      rows = accounts,
      columns = [
        TableColumn("name", "Name"),
        TableColumn("kontotyp", "Typ"),
        TableColumn("budgetRahmenCent", "Gesamtbudget")
      ]
    )
  );
}
