package gui.konto;

import Guidslpaper.Konto;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.navigation.GuidslPaperNavigation;

page KontoCreate(Konto konto) {
  @GemRow(wrap = "nowrap", components = [
    @GuidslPaperNavigation(),
    @GemColumn(hAlign = "center", component =
      @GemCard(title = "New Konto", component =
        @GemColumn(width = "50vw", rowGap = "10px", components = [
          createPTitle@GemTextInput(labelText = "Konto Name", entry = konto.name, disabled = false),
          @GemButton(label = "Create new konto", leftClick = createKonto(), disabled = false),
          @GemButton(label = "Abort", leftClick = navigateBack(), disabled = false)
        ])
      )
    )
  ]);
}
