package gui.login;

import Guidslpaper.User;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

component ResetPassword(List<User> users, User user) {
  @GemCard(title = "Reset password", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(
        labelText = "E-mail address",
        inputType = "text",
        entry = user.email,
        validity = user.validityEmail
      ),
      @GemTextInput(labelText = "New password ", inputType = "password", entry = user.password),
      @GemRow(hAlign = "center", colGap = "10px", components = [
        @GemButton(label = "Cancel", leftClick = navigateBack()),
        @GemButton(label = "Reset password", leftClick = passwordReset())
      ]),
      error@GemText(value = "")
    ])
  );
}
