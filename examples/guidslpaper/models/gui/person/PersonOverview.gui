package gui.person;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;

import Guidslpaper.Person;

page PersonOverview(List<Person> persons) {
  @GemCard(
    titleComponent = @GemRow(hAlign = "space-between", components = [
      @GemText(value = "Staff overview"),
      @GemRow(width = "70%", hAlign = "right", vAlign = "center", colGap = "0.5rem", components = [
        @GemButton(width = "auto", label = "Add person"),
        @GemButton(width = "auto", label = "?")
      ])
    ]),
    component = @GemTable(
      rows = persons,
      columns = [
        TableColumn("name", "Name"),
        TableColumn("vorname", "Surname"),
        TableColumn("beschBeginn", "Contract start"),
        TableColumn("beschEnde", "Contract end")
      ]
    )
  );
}
