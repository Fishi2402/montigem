package gui.refactor;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;

import gui.common.BalanceBox;
import gui.common.Header;
import gui.refactor.Overview;

import Guidslpaper.Konto;

page AccountOverviewRef(List<Konto> accounts) {
  @Overview(
    title = "Accounts overview",
    buttons = [
      @GemButton(label = "Add account"),
      @GemButton(label = "?")
    ],
    main = @GemTable(
      rows = accounts,
      columns = [
        TableColumn("name", "Name"),
        TableColumn("kontotyp", "Typ"),
        TableColumn("budgetRahmenCent", "Gesamtbudget")
      ]
    )
  );
}
