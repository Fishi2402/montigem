package gui.refactor;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableRow;

import gui.common.Header;
import gui.refactor.Overview;

import Guidslpaper.Person;

page PersonOverviewRef(List<Person> persons) {
  @Overview(
    title = "Staff overview",
    buttons = [
      @GemButton(label = "Add person"),
      @GemButton(label = "?")
    ],
    main = @GemTable(
      header = @GemTableHeader(cols = ["Name", "Surname", "Contract start", "Contract end"]),
      body = @iterate(Person p : persons) {
        @GemTableRow(cells = [
          @GemText(value = p.vorname),
          @GemText(value = p.nachname),
          @GemText(value = p.beschBeginn),
          @GemText(value = p.beschEnde)
        ]);
      }
    )
  );
}
