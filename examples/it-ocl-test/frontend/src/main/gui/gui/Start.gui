package gui;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextareaInput;
import mc.fenix.input.GemCheckBoxInput;
import mc.fenix.input.GemRadioInput;
import mc.fenix.basic.GemImage;
import gui.navigation.NavContainer;

import Mydomain.ErrorMessageSubject;
import Mydomain.LinkedAccessRoot;
import gui.OclE2EEditComp;
import gui.OclE2ELinkedAccessEditComp;

page Start(List<ErrorMessageSubject> errorMessageSubjects, List<LinkedAccessRoot> linkedAccessRoots) {
  @GemButton(label="Add Error Message Subject", leftClick=createErrorMessageSubject());
  @iterate(ErrorMessageSubject subject : errorMessageSubjects){
    @GemCard(
      component=@OclE2EEditComp(subject=subject)
    );
  }
  @GemButton(label="Add Linked Access Root", leftClick=createLinkedAccessRoot());
  @GemButton(label="Add Linked Access Root With Too Many Targets", leftClick=createLinkedAccessRootWithTooManyTargets());
  @iterate(LinkedAccessRoot linkedAccessRoot : linkedAccessRoots){
    @GemCard(
      component=linkEditComp@OclE2ELinkedAccessEditComp(linkedAccessRoot=linkedAccessRoot)
    );
  }
}
