package errorMessages;

import Mydomain.*;


ocl ErrorMsgs1 {
  context ErrorMessageSubject subject inv:
    subject.age >= 0;
    shortError: "Age not correct: " + subject.age;
    error: "The age must be positive but is " + subject.age;

  context LinkedAccessTarget target inv:
    target.checkedValue >= 0;
    shortError: "Linked checked value not correct: " + target.checkedValue;
    error: "The linked checked value must be positive but is " + target.checkedValue;

  context LinkedAccessRoot root inv:
    forall i in root.target: i.checkedValue > 100;
    shortError: "Linked target association invalid: " + root.name;
    error: "The linked target association must point to a target with a checked value greater than 100.";

  context LinkedAccessRoot root inv:
    root.target.size() <= 2;
    shortError: "Must have at most 2 targets";
    error: "Must have at most 2 targets";

  context ProjectBudget budget inv:
    budget.spent < budget.limit;
    shortError: "Project budget exceeded: spent " + budget.spent + ", limit " + budget.limit;
    error: "The project spending must be below its budget limit.";
}
