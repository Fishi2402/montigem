umlp Associations {


  class Photo {
    double height;
    double width;
  }

  class Tag {
    boolean confirmed;
  }

  association one [0..1] Tag (t1) <-> (p1) Photo [0..1];
  association two [1] Tag (t2) <-> (p2)Photo [1];
  association three [1] Tag (t3)<-> (p3)Photo [0..1];
  association four [*] Tag (t4)<-> (p4)Photo [0..1];
  association five [*] Tag (t5)<-> (p5)Photo [1];
  association six [1..*] Tag (t6)<-> (p6)Photo [1];
  association seven [*] Tag (t7)<-> (p7)Photo [*];
  association eight [1..*] Tag (t8)<-> (p8)Photo [*];
