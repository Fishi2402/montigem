umlp Commands {

  class User {
    String name;
    String email;
  }

  enum ActivationStatus {
    AKTIVIERT,
    MAIL_NICHT_GESENDET,
    MAIL_FEHLERHAFT,
    MAIL_GESENDET;
  }

  <<singleton>>
  class App {
    void sendEmail(User user, String text, Optional<String> subject, List<String> forwards);
    List<User> getCDTypeList();
    User getCDType(long userId);
    Optional<User> getOptionalType(long userId);
    int getBoxingType();
    String getJavaType();
    ActivationStatus getEnumType();
    Set<String> getNotListGenericType();
    List<Integer> getJavaTypeList();
  }

}

