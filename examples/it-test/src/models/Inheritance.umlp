umlp Inheritance{

  class A{
    int aField;
  }

  class B extends A{ // direct subclass => instances exist
    int bField;
  }
  abstract class C extends A{ // abstract subclass => no direct instances
    int cField;
  }
  class D extends C{ // => indirect instances of C
    int dField;
  }

  // Same but with I
  interface I{
    int iField;
  }

  class E implements I{ // instances exist
    int eField;
  }
  abstract class F implements I{ // no direct instances
    int fField;
  }
  class G extends F{ // indirect instances
    int gField;
  }

  // subinterface
  interface J extends I{
    int jField;
  }
  class H implements J{
    int hField;
  }
  abstract class K implements J{
    int kField;
  }
  class L extends K{
    int lField;
  }

  // Association between Super Classes
  class M{ }
  class N extends M{ } // direct subclass => instances exist
  abstract class O1 extends M { } // abstract subclass => no direct instances
  class P extends O1{ } // => indirect instances of C

  class Q { }
  class R extends Q { }

  association mToQOptional [*] M -> (setQ) Q [*]; // M,N,O1,P -> Q,R
  association mToQMandatory [*] M -> (mandatoryQ) Q [1];

  association qToOBidirectional [*] Q <-> O1 [*]; // Q,R <-> O1, P

  class AListAttr {
    List<String> aList;
  }

  class BListAttr extends AListAttr {}

  // Multiple Inheritance
  interface MI1 {
    int simpleAttr1;
    List<int> listAttr1;
  }

  interface MI2 {
    int simpleAttr2;
    List<int> listAttr2;
  }

  class MultipleInhClass implements MI1, MI2 {
    int simpleAttr3;
    List<int> listAttr3;
  }

  class AssocHelper;
  association MI1 -> (gemAssoc1) AssocHelper [0..1];
  association MI2 -> (gemAssoc2) AssocHelper [0..1];
  association MultipleInhClass -> (gemAssoc3) AssocHelper [0..1];

  association MI1 -> (listAssoc1) AssocHelper [*];
  association MI2 -> (listAssoc2) AssocHelper [*];
  association MultipleInhClass -> (listAssoc3) AssocHelper [*];
}
