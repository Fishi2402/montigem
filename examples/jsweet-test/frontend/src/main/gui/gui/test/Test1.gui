package gui.test;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.navigation.GemNavItem;

import gui.test.TestNav;

import Jsweettest.C2;

page Test1(List<C2> c2s) {
  @TestNav();
  @GemText(value = "Page: Test1");

  @GemText(value = "Show the same static text for every item in a list");

  @iterate(C2 c : c2s) {
    @GemText(value = "Got a C2");
  }

  @GemButton(label = "AddC2", leftClick = addC2() );
}
