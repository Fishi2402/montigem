package gui.test;

import gui.test.TestUpdatableBound;
import mc.fenix.basic.GemText;
import jsweettest.A;

page TestUpdatableBoundPage(List<A> aList) {
  @iterate(A a : aList) {
    @TestUpdatableBound(myString = a.value);
    @GemText(value = a.value);
  }
}

