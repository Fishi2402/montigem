package gui.test;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.navigation.GemNavItem;
import mc.fenix.navigation.GemNavList;

import gui.test.TestNav;
import gui.test.TestC1Comp;

import Jsweettest.C1;
import Jsweettest.C2;

page TestC1List(List<C1> c1s) {
  @TestNav();
  @GemText(value = "Page: TestC1List");

  @GemText(value = "First, a list of all IDs:");
  @iterate (C1 c : c1s) {
    @GemText(value="C1 " + c.hwGemId);
  }
  @GemText(value = "Next, a NavList to each TestC1 page:");

  @GemNavList ( components = [
    @iterate (C1 c1 : c1s) {
      @GemNavItem(title="C1 " + c1.hwGemId, target = "/gui/test/TestC1/" + c1.hwGemId);
    }
  ]);


}
