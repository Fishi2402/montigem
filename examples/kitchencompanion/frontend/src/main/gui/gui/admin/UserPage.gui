package gui.admin;
import mc.fenix.arrange.GemColumn;
import gui.kitchen.LeadUserPanel;
import gui.kitchen.OrdinaryUserPanel;
import gui.kitchen.ExtraUserPanel;
import KitchenCompanion.User;
import KitchenCompanion.Search;
import gui.components.Divider;
import gui.management.AlphabetSearch;

page UserPage(List<User> userList, Search searchState) {
    @GemColumn(hAlign = "center", vAlign = "center", rowGap="1rem",
      components = [
        @AlphabetSearch(searchState = searchState, userOrOffer = true),
        @LeadUserPanel(allUsers = userList, searchState = searchState, adminPage = true),
        @Divider(color = "red", width = "20rem", height = "0.5rem"),
        @OrdinaryUserPanel(allUsers = userList, searchState = searchState, adminPage = true),
        @ExtraUserPanel(allUsers = userList, searchState = searchState, adminPage = true)
    ]);
}
