import mc.fenix.input.GemTextInputTypes.GemTextInputValidity;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.Optional;
import java.time.LocalDate;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.Optional;

umlp KitchenCompanion {

  class User {
    String name;
    String lastName;
    <<dbColumn = "unique = true">> String nickname;
    double balance;
    <<dbColumn ="unique = true">> String email;
    KitchenCompanionRole role;
    double sum;
    List<Tally> tallies;
    List<Tally> prevTallies;
    List<Receipt> receipts;
  }

  enum KitchenCompanionRole {
    USER,
    HIWI,
    VIP,
    ADMIN;
  }

  enum ProductType{
    DRINK,
    SNACK;
  }

  class Search {
    String searchStr;
    boolean searched;
  }

  class Offer {
    String imgSource;
    String name;
    double price;
    boolean inStock;
    ProductType productType;
  }

  class Tally {
    Offer offer;
    int count;
  }

  class Receipt {
    LocalDate date;
    List<Tally>pastTallies;
    boolean confirmed;
    double sum;
    double pastBalance;
    double debt;
    double amountPaid;
    boolean paid;
  }

  <<singleton>>
  class EmailSendingService {
    void sendEmail();
  }
}
