import input.GemTextInputTypes.GemTextInputValidity;

classdiagram KitchenCompanion {

  <<singleton>>
  class App{
    //<<command>> void sendMail(User email, String subject, String message, List<String> forwards);
  }

  association [1] App -> User [*];
  association [1] App -> Offer [*];

  class User {
    <<dbColumn = "unique=true">>
    String username;
    String password;
    String nickname;
    <<dbColumn = "unique=true">>
    String email;
    KitchenCompanionRole role;
  }

  enum KitchenCompanionRole {
    USER,
    ACCOUNTANT,
    ADMIN;
  }

  class Offer {
    String name;
    double price;
  }

  association [1] User -> BillingInfo [0..1];

}
