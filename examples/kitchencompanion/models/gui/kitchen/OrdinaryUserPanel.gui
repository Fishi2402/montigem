package gui.kitchen;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;

import KitchenCompanion.User;

component OrdinaryUserPanel(List<User> allUsers){
  @GemRow(hAlign = "center", colGap="1rem", rowGap="1rem", wrap="wrap", components = [

  @iterate(User user : allUsers){
      @guard(user.nickname != "BR" && user.nickname != "MN" && user.nickname != "Chair") {
        @GemButton(label = user.username);
      }
   }


  ]);
}
