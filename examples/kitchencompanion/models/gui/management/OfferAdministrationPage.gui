package gui.management;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import gui.management.OfferPanel;

import gui.navigation.NavContainer;

import KitchenCompanion.Offer;

page OfferAdministrationPage(List<Offer> offers) {
  @NavContainer(content = [
    @GemColumn(width = "70rem", hAlign = "center", rowGap="1rem", wrap="wrap",
      components=[
        @iterate(Offer o : offers){
          @OfferPanel(offer = o);
      }]
    )
  ]);
}
