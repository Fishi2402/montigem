package test_commands;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;


import LoadingTests.LeftSide;
import LoadingTests.RightSide;

page TestCommandUpdates(String responseText = "loaded") {
  response@GemText(value= responseText );

  // The button will trigger the DoTestCommand (via hwc), and its reply/updates will be shown in the GemText (via hwc)

  @GemButton(label = "CommandWithBuild", leftClick = doTestCommand(true));
  @GemButton(label = "CommandWithoutBuild", leftClick = doTestCommand(false));

}
