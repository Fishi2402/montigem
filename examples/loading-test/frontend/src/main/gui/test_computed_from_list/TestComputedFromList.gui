package test_computed_from_list;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableRow;

import LoadingTests.Person;

page TestComputedFromList(List<Person> list) {
  @GemButton(label = "Add Person", leftClick = addPerson());
  @GemButton(label = "Add Student", leftClick = addStudent());
  @GemTable(
    body = [@iterate(Person p : list) {
      @GemTableRow(cols = [
        @GemText(value = p.name),
        @GemText(value = formatPetCount(p)),
        @GemButton(label = "Add pet", leftClick = addPet(p)),
        @GemButton(label = "Kill pets", leftClick = killPets(p)),
        @GemButton(label = "Delete", leftClick = delete(p))
      ]);
    }]
  );
  computedInPageFromParameter@GemText(value = formatCount1(list));
  computedInPageFromGetter@GemText(value = formatCount2());
  @ListCountText(list = list);
  @GemText(value = "Total pet count: ");
  totalPetCount@GemText(value = formatTotalPetCount(list));
}
