package test_gui;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import LoadingTests.Person;

page ChainedAssoc(Person person) {
  @GemText(value = person.name);
  @GemText(value = person.favouritePet.name);
  @GemText(value = person.favouritePet.favouriteFood.name);
}
