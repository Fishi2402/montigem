package test_gui;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.arrange.GemColumn;
import LoadingTests.LeftSide;
import test_gui.Inner;

page Outer(List<LeftSide> list) {
  @Inner(title="not passed");
  @Inner(title="with passed", list=list);
  @GemColumn(components = [
    @GemText(value="In root container"),
    @iterate(LeftSide ls : list) {
      @GemText(value = ls.label);
    }
  ]);
}
