package test_load_inner;

import mc.fenix.basic.GemText;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemGridCell;
import mc.fenix.basic.GemButton;
import java.util.List;
import LoadingTests.Player;
import LoadingTests.Game;
import LoadingTests.PlayerStat;
import test_load_inner.PlayerStatListComp;
import test_load_inner.PlayerStatListControls;

page PlayerStatsWithComp(Game game) {
  @iterate(Player p : game.player) { // FieldAccessExpression -> leads to Assoc-Observer usage
    @PlayerStatListComp(p=p);
  }

  @PlayerStatListControls(gemIdForNav=game.gemIdForNav);
}
