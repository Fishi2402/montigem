classdiagram LoadingTests {

  class Person {
    String name;
    int age;
  }

  class Animal {
    String name;
    int legs;
  }

  class Food {
    String name;
  }

  association [*] Person (owner) <-> (pet) Animal [*];
  association [*] Animal -> Food [*];

  <<singleton>>
  class UpdateListHelper {
    <<command>>
    void replaceFoodItem(Animal a);
  }
  association UpdateListHelper -> (testAnimal) Animal [0..1];

  class CommandTest {
    Animal getAnimal();
    Long getLong();
    long getLongPrimitive();
    String getString();
    Optional<Animal> getOptAnimal();
    Optional<Long> getOptLong();
    List<Animal> getListAnimals();
    List<Long> getListLong();
    void doAction();
  }

  // From the loading-inner example
  public class Player {
      + String name;
      + boolean isActive;
      + int points;
    }

    public class Game {
      + int currentTurn;
      + long currentPlayerIndex;
      + boolean votingPhase;

      int gemIdForNav = -1;
    }

    composition [1] Game -> Player [*];

   // A class causing Game -> Player * -> PlayerStat *;
   public class PlayerStat {
    + String statID;
   }
   composition [1] Player -> PlayerStat [*];
   <<singleton>>
   class PlayerStatsManager {
     void addPlayerRemote(Game g);
     void addStatRemote(Game g);
     void reset(Game g);
   }
   association PlayerStatsManager -> Game [0..1];

  // And some tests for interfaces

  public class IUseAnInterface {
    MyInterface i;
  }
  public interface MyInterface { }
  public class MyInterfaceImpl implements MyInterface {
    String name;
  }

  public class LeftSide {
    String label;
  }
  public class RightSide {
    String label;
  }
  association [0..1] LeftSide (connectedLeft) <-> (connectedRight) RightSide [0..1];
  association [0..1] LeftSide (connectedLeftList) <-> (connectedRightList) RightSide [*];
  public class Sides {
    LeftSide left;
  }

  //public interface MyBetterInterface extends MyInterface {}
  //public class MyBetterInterfaceImpl implements MyBetterInterface {
  //    String name;
  //}


}
