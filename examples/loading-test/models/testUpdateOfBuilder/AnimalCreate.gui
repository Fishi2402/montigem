package testUpdateOfBuilder;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.basic.GemText;

import LoadingTests.Food;
import LoadingTests.Animal;

page AnimalCreate(Animal animal, List<Food> allFood) {

  chooseFoodToAdd@GemDropdownInput(
    labelText = "Eats",
    options = null,
    entry = null
  );
  @iterate(Food f : animal.food) {
    @GemText(value=f.name);
  }
}
