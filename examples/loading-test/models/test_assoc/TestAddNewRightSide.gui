package test_assoc;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;


import LoadingTests.LeftSide;
import LoadingTests.RightSide;

page TestAddNewRightSide(LeftSide l) {
  @GemText(value="left: " + l.label);
  @guard(l.connectedRight != null) {
    @GemText(value="  -> : " + l.connectedRight.label);
  }


  @GemButton(label = "New using builder", leftClick = add(true));
  @GemButton(label = "New without builder", leftClick = add(false));


}
