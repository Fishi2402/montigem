package test_update_after_delete;

import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import LoadingTests.Person;
import LoadingTests.Animal;


page PersonsDeleteButton(List<Person> allPersons) {

  @iterate(Person p : allPersons){
    @GemText(value=p.name); @GemButton(label="Delete", leftClick=deletePerson(p));
  }
}
