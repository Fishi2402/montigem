package test_update_of_builder;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.basic.GemText;

import LoadingTests.Food;
import LoadingTests.Animal;

page AnimalAddFood(Animal animal, List<Food> allFood, String foodEntry) {

  chooseFoodToAdd@GemDropdownInput(
    labelText = "Eats",
    options = getOptions(),
    entry = foodEntry
  );
  @iterate(Food f : animal.food) {
    @GemText(value=f.name);
  }
}
