umlp MediaHub {

  // package people { TODO: Bug in cd4c: classes in this package are added twice to the AST
    class Author {
      String name;
      java.util.Date birth;
      int authorID;
      List<Book> portfolio;
    }

    class User {
      String name;
      int userID;
    }
  // }

  class Account {
    int accountID;
    User use;
  }

  class Library {
    String name;
    String address;
    List<Book> books;
    List<Video> vids;
  }

  // package multimedia { TODO: Bug in cd4c: classes in this package are added twice to the AST
    class Book {
      int bookID;
      java.util.Date issueDate;
      Author author;
    }

    class Video {
      String name;
      double size;
      String password;
    }

/*    enum VideoQuality {  //TODO: Fix Enum Bug in cd4c
      UltraHD,
      HD,
      LowQuality;
    }*/
  // }

  // association borrow [0..1] people.User -> multimedia.Book [*] ; TODO: Bug in cd4c: classes in this package are added twice to the AST
  // association writtenBy [1] people.Author (book) <-  (author) Book [*] ; TODO: Bug in cd4c: classes in this package are added twice to the AST
  association borrow [0..1] User -> (borrows) Book [*] ;
  association writtenBy [1] Author (book) <-  (author) Book [*] ;
  composition Library -> Book [*] ;
  composition Library -> Video [*] ;
//  association resolution Video (quality) -> VideoQuality ; //TODO: Fix Enum Bug in cd4c
  association accountbook User [Account] -> (a2) Account ;
}
