/* (c) https://github.com/MontiCore/monticore */
umlp NativeImageDemo {

  class Person {
    int age;
    -> Contact [0..1];
  }

  class Contact {
    String city;
    int zip;
    String street;
    List<String> email;
  }

  class Car {
    String plate;
  }

  association Person -> Car [*];

}

