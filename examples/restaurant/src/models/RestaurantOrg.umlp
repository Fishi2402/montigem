/* (c) https://github.com/MontiCore/monticore */

umlp RestaurantOrg {

  // package actors { TODO: Bug in cd4c: classes in this package are added twice to the AST
    class Person {
      String name;
      String lastName;
      java.util.Date birthday;
      String address;
    }

    class Customer extends Person {
      java.util.Date reservationDate;
    }

    class Employee extends Person {
      int id;
      String contract;
    }
  // }

  class Restaurant {
    String name;
    String address;
  }

  class Job {
    String jobName;
    int roleID;
  }

  class ServingPersonel extends Job;
  class Waiter extends ServingPersonel;
  class KitchenPersonel extends Job;
  class Chef extends KitchenPersonel;

  // association service [*] actors.Customer <-> ServingPersonel [*] ; TODO: Bug in cd4c: classes in this package are added twice to the AST
  // association [*] actors.Person (visitedBy) <-> (visits) Restaurant [*] ; TODO: Bug in cd4c: classes in this package are added twice to the AST
  association service [*] Customer <-> ServingPersonel [*] ;
  association [*] Person (visitedBy) <-> (visits) Restaurant [*] ;

//  aggregation [1] Restaurant  -> (staff) Employee [*] ; // TODO: aggregations do not exist in CD4A
  association Person -> Job [0..1];

}
