/* (c) https://github.com/MontiCore/monticore */

umlp RestaurantOrg {

  package actors {
    class Person {
      String name;
      String lastName;
      java.util.Date birthday;
      String address;
    }

    class Customer extends Person {
      java.util.Date reservationDate;
    }

    class Employee extends Person {
      int id;
      String contract;
    }
  }

  class Restaurant {
    String name;
    String address;
  }

  class Job {
    String jobName;
    int roleID;
  }

  class ServingPersonel extends Job;
  class Waiter extends ServingPersonel;
  class KitchenPersonel extends Job;
  class Chef extends KitchenPersonel;

  association service [*] actors.Customer <-> ServingPersonel [*] ;
  association [*] actors.Person (visitedBy) <-> (visits) Restaurant [*] ;
//  aggregation [1] Restaurant  -> (staff) Employee [*] ; // TODO: aggregations do not exist in CD4A
  association Person -> Job [0..1];

}
