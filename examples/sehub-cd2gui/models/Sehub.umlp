classdiagram Sehub {

  /* Role datastructure - will later be separated in a general
     and application specific part that are merged.
  */

  class User {
                                       <<dbColumn = "unique=true">>
    String username;
    String password;
    java.time.LocalDateTime registrationDate;
   // ActivationStatus activated;
                                        <<dbColumn = "unique=true">>
    String email;
    SehubRole role;
    String validityUsername();
    String validityPassword();
    String validityRole();
    String validityEmail();
  }

  enum ActivationStatus {
    AKTIVIERT,
    MAIL_NICHT_GESENDET,
    MAIL_FEHLERHAFT,
    MAIL_GESENDET;
  }

  enum SehubRole {
    GUEST,
    REPORTER,
    DEVELOPER,
    MAINTAINER,
    OWNER;
  }

  /* Application datastructure */

  class Project {
    String git;
    String name;
    String fullName;
  }

  association app [1] Project -> (users) User [*];
  association tickets [1] Project -> (issues) Issue [*];

  class Issue {
    String title;
    String description;
    IssueState state;
  }

  association discussion [0..1] Issue <-> (posts) Post [*];

  enum IssueState {
    UNASSIGNED,
    IN_PROGRESS,
    DONE;
  }

  class Post {
    String text;
    String title;
  }

  association auth [1] Post -> (author) User [1];
  association resp [0..1] Post (parent) <-> (responses) Post [*];


  // ABSTRACT!
  class Artifact { // TODO shellAPI does not work with abstract classes
    String simpleName;
    String nameExtension;
    String modified;
    String name;
    String fullName;
    /String type;
  }

  class FileArtifact extends Artifact {}

  association refersTo [*] Artifact -> (referred) Artifact [*];

  association produces [*] Artifact -> (produced) Artifact [*];

  association root [*] Artifact -> (root) Project [1];

  association artifactRepresentation [1] Project -> (rootArtifact) Directory [*]; // TODO Optional because of technical issue 1 <-> 1 cycles not allowed

  class Directory extends Artifact {}

  association [0..1] Directory (containedBy) <-> (contains) Artifact [*];


  // --------------------- Bingo ---------------------

  class BingoBoard {}

  class Message {
    String text;
  }

  class BoardMapper {
    boolean isChecked;
  }

  class BingoEntry {
    String word;
  }

  association mappedBingoEntry [1] User -> (gridEntry) BoardMapper [*];
  association bingoBoardEnties [1] BingoBoard -> (bingoBoardEntries) BingoEntry [*];
  association boardMapping [1] BoardMapper -> (bingoBoardEntry) BingoEntry [1];

}
