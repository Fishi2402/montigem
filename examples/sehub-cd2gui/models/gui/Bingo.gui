package gui;

import Sehub.User;
import Sehub.BoardMapper;
import Sehub.BingoBoard;
import Sehub.Message;

import arrange.GemRow;
import arrange.GemCard;
import arrange.GemColumn;
import basic.GemButton;
import basic.GemText;
import input.GemTextareaInput;
import input.GemTextInput;

page Bingo(List<Message> messages, User user) {

  // Board
  @GemRow(width="100%", hAlign="center", components = [

    @GemRow(width = "1025px", hAlign="center", colGap = "5px", rowGap = "5px", components = [
      @GemRow(width = "1025px", hAlign="center", component = @GemText(value = "Bingo-Board")),
      @iterate(BoardMapper b : user.gridEntry){
        @GemCard(title = "", component =
           @GemColumn(width = "170px", components = [
              @GemTextareaInput(
                  id = "bingoEntry",
                  labelText = "",
                  entry = b.bingoBoardEntry.word
              ),
              checkButton@GemButton(label = "Check!", leftClick = checkEntry(b))
           ])
        );
      }
    ]),

    // MessageBoard
    @GemRow(width = "600px", hAlign="center", colGap = "5px", rowGap = "5px", component =
      @GemColumn(width = "570px", rowGap="5px", components = [
        @GemText(value = "Chat / Log"),
        @GemColumn(rowGap="5px", components = [
          @iterate(Message m : messages){ messageEntry@GemText(value = m.text); }
        ]),
        newMessage@GemTextInput(labelText = "Add Text", inputType = "text"),
        chat@GemButton(label = "Send", leftClick = addChat)
      ])
    )
  ]);

}
