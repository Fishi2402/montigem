package gui;

import Sehub.Artifact;
import Sehub.Directory;
import Sehub.Project;

import gui.artifacts.ArtifactTypeIcon;
import gui.artifacts.DateTimeToPassedByTime;
import gui.artifacts.ProjectFileViewLink;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemLink;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;


page ProjectFileView(Directory parent) {

  fileViewColumn@GemColumn(
    rowGap="1px",
    components=[
      @GemButton(label = "Go to Artifacts Page", leftClick = goToArtifactsPage),
      @GemRow(
        height="20px", vAlign="center", width="100%",
        colGap="5px",
        components = [
          @GemColumn(height="20px", vAlign="center", hAlign="left", width="20px", component = @GemText(value = "")),
          @GemColumn(height="20px", vAlign="center", hAlign="center", width="48%", component = @GemText(value = "Name")),
          @GemColumn(height="20px", vAlign="center", hAlign="left", width="37%", component = @GemText(value = "Last Update"))
        ]
      ),
      parentDirGuard@guard(parent.containedBy != null){
        artifactsTableOne@GemRow(
          height="20px", vAlign="center", width="100%",
          colGap="5px",
          components = [
            @GemColumn(height="20px", vAlign="center", hAlign="left", width="20px", components = [@ArtifactTypeIcon(type = "Directory")]),
            @GemColumn(height="20px", vAlign="center", hAlign="left", width="48%", component = @GemLink(url = "OVERRIDE THIS", text = ".."))
          ]
        );
      },
      @iterate(Artifact artifact: parent.contains){
        artifactsTableTwo@GemRow(
          height="20px", vAlign="center", width="100%",
          colGap="5px",
          components = [
            @GemColumn(height="20px", vAlign="center", hAlign="left",width="20px", components = [@ArtifactTypeIcon(type = artifact.type)]),
            @GemColumn(height="20px", vAlign="center", hAlign="left", width="48%", component = navigationButton@ProjectFileViewLink(artifact = artifact)),
            @GemColumn(height="20px", vAlign="center", hAlign="right", width="37%", component = @DateTimeToPassedByTime(artifact = artifact))
          ]
        );
      }
    ]
  );

}
