package gui.artifacts;

import Sehub.Artifact;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemText;

component ProjectFileViewLink(Artifact artifact){
  @guard(artifact.type == "Directory"){
    @GemLink(url = "OVERRIDE", text = artifact.name);
  }
  @guard(!(artifact.type == "Directory")){
    @GemText(value = artifact.name);
  }
}
