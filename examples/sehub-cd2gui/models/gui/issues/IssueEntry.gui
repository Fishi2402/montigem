package gui.issues;

import Sehub.Issue;
import Sehub.IssueState;

import arrange.GemCard;
import arrange.GemColumn;
import arrange.GemRow;
import basic.GemText;
import basic.GemButton;
import input.GemTextInput;
import input.GemTextareaInput;

component IssueEntry(Issue issue) {
  issueColumn@GemColumn(width = "400px", rowGap = "5px", component =
    issueCard@GemCard(title = issue.title, component =
      @GemColumn(hAlign = "right", rowGap = "10px", components = [
        @GemRow(colGap = "7px", width = "100%", hAlign = "center", components = [
          @guard(issue.state != IssueState.UNASSIGNED) {
            @GemButton(label = "<<<", leftClick = demote);
          },
          @GemButton(label = "Edit", leftClick = editIssue),
          @GemButton(label = "Delete", leftClick = deleteIssue),
          @guard(issue.state != IssueState.DONE) {
            @GemButton(label = ">>>", leftClick = promote);
          }
        ]),
        @GemText(value = issue.description)
      ])
    )
  );
}
