package gui.login;

import Sehub.User;

import gui.login.ResetPassword;

import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;

import basic.src.lib.gemimage.GemImage;
import basic.src.lib.gemtext.GemText;
import basic.src.lib.gemlink.GemLink;

page ForgotPasswordPage(List<User> users){
  @GemCard(title = "SE Hub", component =
    @GemColumn(hAlign = "center", height = "auto", width = "800px", rowGap = "105px", components = [
      @GemColumn(hAlign = "center", width = "150px", component =
        @GemImage(source = "assets/images/Eule.png")
      ),
      @GemColumn(hAlign = "center", width = "600px", rowGap = "20px", components = [
        @ResetPassword()
      ])
    ])
  );
}
