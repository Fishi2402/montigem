package gui.login;

import Sehub.User;

import gui.login.UserLogin;
import gui.login.LoginContainer;

import arrange.src.lib.gemcolumn.GemColumn;
import basic.src.lib.gemlink.GemLink;

page LoginPage(List<User> users) {
  @LoginContainer(component =
    @GemColumn(width = "400px", rowGap = "20px", hAlign = "center", components = [
      @UserLogin(),
      @GemLink(url = "/login/forgotpassword/ForgotPasswordPage", text = "Forgot your password?"),
      @GemLink(url = "/login/registration/RegistrationPage", text = "Create new account")
    ])
  );
}
