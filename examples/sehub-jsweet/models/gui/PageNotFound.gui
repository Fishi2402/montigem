package gui;

import arrange.GemColumn;
import arrange.GemCard;
import basic.GemText;
import arrange.GemRow;
import basic.GemImage;

page PageNotFound(){
   @GemColumn(width = "100%", height="40%", rowGap="20px", vAlign = "center", hAlign = "center", components = [
     @GemRow(hAlign = "center", vAlign = "center", height = "auto", component =
             @GemRow(width = "200px", component = @GemImage(source = "assets/images/Eule.png"))
          ),
      @GemColumn(width= "600px", hAlign = "center", vAlign = "center", component =
        @GemCard(title = "SE Hub | 404", component =
          @GemColumn(hAlign = "center", height = "auto", width = "800px", rowGap = "105px", components = [
            @GemText(value = "Oh no something went wrong - please fix it!")
          ])
        )
      )
    ]);
}
