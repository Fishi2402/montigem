package gui;

import Sehub.Artifact;
import Sehub.Directory;
import Sehub.Project;

import basic.GemButton;

import table.GemTable;
import table.TableTypes.TableColumn;

import arrange.GemColumn;

page ProjectFileView(Directory parent) {

  @GemButton(label = "Go to Artifacts Page", leftClick = goToArtifactsPage);
  @GemTable(
    rows = parent.contains,
    columns = [
      TableColumn("_name", "Artifact Name"),
      TableColumn("_modified", "Last update")
    ],
    delete = navigateToSubPage
  );
}
