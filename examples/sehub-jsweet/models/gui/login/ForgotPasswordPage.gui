package gui.login;

import Sehub.User;

import gui.login.ResetPassword;

import arrange.GemRow;
import arrange.GemColumn;
import arrange.GemCard;

import basic.GemImage;
import basic.GemText;
import basic.GemLink;

page ForgotPasswordPage(List<User> users){
  @GemRow(hAlign = "center", vAlign = "space-around", width = "100%", component =
    forgotPassword@GemCard(title = "SE Hub", component =
      @GemColumn(hAlign = "center", height = "auto", width = "800px", components = [
        @GemRow(hAlign = "center", vAlign = "center", width = "100%", component =
          @GemColumn(hAlign = "center", width = "600px", rowGap = "20px", components = [
            @GemRow(width = "150px", hAlign = "center", component = @GemImage(source = "assets/images/Eule.png")),
            @ResetPassword(),
            @GemRow(width = "150px", hAlign = "center", component =
              @GemImage(source = "assets/images/rwth_se_bild_weiss_rgb.png")
            )
          ])
        )
      ])
    )
  );
}
