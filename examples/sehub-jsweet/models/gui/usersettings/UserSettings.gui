package gui.usersettings;

import Sehub.User;

import gui.usersettings.UserDisplay;

import arrange.GemCard;
import arrange.GemRow;
import arrange.GemColumn;

import basic.GemButton;
import basic.GemText;
import input.GemTextInput;
import table.GemTable;

component UserSettings(User currentUser, List<User> users) {
  @GemColumn(
    width="90vw",
    hAlign = "center",
    rowGap = "5px",
    components = [
      myAccount@GemCard(title = "My Account",
        component = @GemRow(hAlign = "left", vAlign = "space-around",
          components = [
            userName@GemTextInput(labelText = "Username", inputType = "text", entry = currentUser.username),
            password@GemTextInput(labelText = "Password", inputType = "password", entry = currentUser.password),
            userEMail@GemTextInput(labelText = "Email", inputType = "text", entry = currentUser.email)
          ]
        )
      ),
      projectSettings@GemCard(title = "Project Settings",
        component = @GemColumn(
          components = [
            @GemRow(
              components = [
                projectmembers@GemText(value = "Project Members")//,
//                @GemRow(
//                  hAlign = "right",
//                  components = [
//                    inviteUser@GemButton(label = "Invite new member", leftClick = "navigateToCreateNewUser")
//                  ]
//                )
              ]
            ),
            @GemColumn(
              components = [
                @iterate(User user: users) {
                  @UserDisplay(user = user);
                }
              ]
            )
          ]
        )
      )
    ]
  );
}
