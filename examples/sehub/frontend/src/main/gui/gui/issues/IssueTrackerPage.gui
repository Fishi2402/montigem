package gui.issues;

import Sehub.Issue;

import gui.issues.IssueCreate;
import gui.issues.IssueDragDrop;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;

page IssueTrackerPage(List<Issue> issues) {

  @GemRow(hAlign = "center", colGap = "5px", rowGap = "20px", components = [

    @GemCard(title = "New Issue", component = @GemColumn(hAlign = "center", component = @IssueCreate())),

    @GemCard(title = "Issue List", component =
      issueCategories@GemRow(hAlign = "center", rowGap = "10px", colGap = "10px", components = [
        // TBD Column
        @GemCard(title = "TODO", component =
          @IssueDragDrop(
            issues = getTodoIssues(issues),
            dropId = "todoList",
            canDropTo = ["doingList", "doneList"],
            drop = updateIssue()
          )
        ),

        // WIP Column
        @GemCard(title = "DOING", component =
          @IssueDragDrop(
            issues = getDoingIssues(issues),
            dropId = "doingList",
            canDropTo = ["todoList", "doneList"],
            drop = updateIssue()
          )
        ),

        // Done Column
        @GemCard(title = "DONE", component =
          @IssueDragDrop(
            issues = getDoneIssues(issues),
            dropId = "doneList",
            canDropTo = ["todoList", "doingList"],
            drop = updateIssue()
          )
        )
      ])
    )
  ]);
}
