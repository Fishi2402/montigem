classdiagram Sehub {

  /* Role datastructure - will later be separated in a general
     and application specific part that are merged.
  */

  class User {
                                       <<dbColumn = "unique=true">>
    String username;
    String password;
    java.time.LocalDateTime registrationDate;
   // ActivationStatus activated;
                                        <<dbColumn = "unique=true">>
    String email;
    SehubRole role;
  }

  enum ActivationStatus {
    AKTIVIERT,
    MAIL_NICHT_GESENDET,
    MAIL_FEHLERHAFT,
    MAIL_GESENDET;
  }

  enum SehubRole {
    GUEST,
    REPORTER,
    DEVELOPER,
    MAINTAINER,
    OWNER;
  }

  /* Application datastructure */

  class ProjectApp {
    String git;
  }

  association app [1] ProjectApp -> (users) User [*];
  association tickets [1] ProjectApp -> (issues) Issue [*];

  class Issue {
    String title;
    String description;
    IssueState state;
  }

  association discussion [1] Issue -> (posts) Post [*];

  enum IssueState {
    UNASSIGNED,
    IN_PROGRESS,
    DONE;
  }

  class Post {
    String text;
  }

  association auth [1] Post -> (author) User [1];
  association resp [1] Post -> (responses) Post [*];

}
