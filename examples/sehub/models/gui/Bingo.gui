package gui;

import Sehub.User;
import Sehub.BoardMapper;

import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemcolumn.GemColumn;
import basic.src.lib.gembutton.GemButton;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextareainput.GemTextareaInput;

page Bingo(User user){
    @GemText(value = "Bingo !!");
    @GemRow(width="100%", hAlign="center", component =
      @GemRow(width = "1025px", hAlign="center", colGap = "5px", rowGap = "5px", component =
        @iterate(BoardMapper b : user.gridEntry){
          @GemCard(title = "", component =
             @GemColumn(width = "170px", components = [
                @GemTextareaInput(
                    id = "bingoEntry",
                    labelText = "",
                    entry = b.bingoBoardEntry.word
                ),
                checkButton@GemButton(label = "Check!", leftClick = checkEntry(b))
             ])
           );
        })
    );
}
