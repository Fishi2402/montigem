package gui;

import Sehub.Post;
import gui.note.Note;
import gui.note.Response;
import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemcolumn.GemColumn;
import basic.src.lib.gemtext.GemText;
import basic.src.lib.gembutton.GemButton;

page NotesPage(List<Post> posts){
  gc1@GemCard(title = "Notes:", component = @GemColumn(height = "auto", hAlign = "right", rowGap = "5px", components = [
  @GemButton(label = "Neuer Post", leftClick = newPost),
  @iterate(Post p : posts){
            @Note(post = p);
          }
  ]));
}
