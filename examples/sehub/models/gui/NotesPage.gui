package gui;

import Sehub.Post;
import Sehub.Issue;

import gui.note.Note;
import gui.note.Response;
import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemcolumn.GemColumn;
import basic.src.lib.gemtext.GemText;
import basic.src.lib.gembutton.GemButton;

page NotesPage(Issue issue){
    @GemColumn(hAlign = "center", component =
      @GemCard(title = issue.title, component = @GemColumn(height = "auto", hAlign = "right", rowGap = "5px", components = [
      @GemText(value = issue.description),
      @GemButton(label = "Neue Notiz", leftClick = newPost),
      @iterate(Post p : issue.posts){
                @Note(post = p);
              }
      ]))
    );
}
