package gui;

import Sehub.Artifact;
import Sehub.Directory;

import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;
import mc.fenix.networkgraph.GemGraph;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemTreeview;

page ProjectPage(Directory project) {

  @GemCard(
    title = "Files",
    component = files@GemTreeview(items = null, allExpanded = false)
  );
  @GemGraph(
    nodes = null,
    edges = null
  );

}
