package gui;

import Sehub.Project;

import table.src.lib.gemtable.GemTable;
import table.src.lib.gemtable.TableTypes.TableColumn;
import charts.src.lib.gemnetworkgraph.GemNetworkGraph;
import arrange.src.lib.gemcard.GemCard;

page SehubMainPage(List<Project> projects) {

  @GemCard(
    title = "Projects",
    component = projectList@GemTable(
      rows = projects,
      columns = [
        TableColumn("_name", "Project Name")
      ],
      edit = navigateToProjectPage,
      update = log
    )
  );
}
