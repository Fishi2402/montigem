package gui.artifacts;

import basic.GemImage;

component ArtifactTypeIcon(String type){
  @guard(type == "Directory"){
    @GemImage(source = "assets/icons/directory.png", style = "height: 23px; width: 23px");
  }
  @guard(!(type == "Directory")){
    @GemImage(source = "assets/icons/file.png", style = "height: 23px; width: 23px");
  }
}
