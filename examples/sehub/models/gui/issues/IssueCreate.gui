package gui.issues;

import Sehub.Post;
import Sehub.Issue;

import gui.note.Note;
import gui.note.Response;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;

component IssueCreate(Issue issue){
  @GemColumn(hAlign = "center", width = "400px", rowGap = "5px", components = [
    @GemTextInput(labelText = "Issue Title", entry = issue.title, disabled = false),
    @GemTextareaInput(
      labelText = "Description",
      entry = issue.description,
      disabled = false
    ),
    @GemButton(label = "Create new Issue", leftClick = createIssue(), disabled = false)
  ]);
}
