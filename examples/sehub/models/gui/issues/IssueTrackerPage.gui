package gui.issues;

import Sehub.Issue;

import gui.issues.IssueCreate;
import gui.issues.IssueDragDrop;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemrow.GemRow;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextinput.GemTextInput;
import input.src.lib.gemtextareainput.GemTextareaInput;

page IssueTrackerPage(List<Issue> issues) {

  @GemRow(hAlign = "center", colGap = "5px", rowGap = "20px", components = [

    @GemCard(title = "New Issue", component = @GemColumn(hAlign = "center", component = @IssueCreate())),

    @GemCard(title = "Issue List", component =
      issueCategories@GemRow(hAlign = "center", rowGap = "10px", colGap = "10px", components = [
        // TBD Column
        todo@GemCard(title = "TODO", component =
          todoList@IssueDragDrop(
            issues = issues,
            dropId = "todoList",
            canDropTo = ["doingList", "doneList"],
            drop = updateIssue
          )
        ),

        // WIP Column
        doing@GemCard(title = "DOING", component =
          doingList@IssueDragDrop(
            issues = issues,
            dropId = "doingList",
            canDropTo = ["todoList", "doneList"],
            drop = updateIssue
          )
        ),

        // Done Column
        done@GemCard(title = "DONE", component =
          doneList@IssueDragDrop(
            issues = issues,
            dropId = "doneList",
            canDropTo = ["todoList", "doingList"],
            drop = updateIssue
          )
        )
      ])
    )
  ]);
}
