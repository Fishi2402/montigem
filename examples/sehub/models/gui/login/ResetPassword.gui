package gui.login;

import Sehub.User;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

import basic.src.lib.gembutton.GemButton;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextinput.GemTextInput;

page ResetPassword(List<User> users, User user) {
  @GemCard(title = "Passwort zurücksetzen", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(labelText = "E-mail address", inputType = "string", entry = user.email),
      @GemTextInput(labelText = "New password ", inputType = "password", entry = user.password),
      @GemRow(hAlign = "center", component =
        @GemButton(label = "Reset password", leftClick = resetPassword)
      ),
      error@GemText(value = "")
    /*  @GemTextInput(labelText = "E-Mail-Adresse", inputType = "string", entry = user.email),
      @GemRow(hAlign = "center", component =
        @GemButton(label = "Neues Passwort anfordern", leftClick = resetPassword)
      )*/
    ])
  );
}
