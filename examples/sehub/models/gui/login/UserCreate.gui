package gui.login;

import Sehub.User;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

import basic.src.lib.gembutton.GemButton;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextinput.GemTextInput;

page UserCreate(User newUser) {
  @GemCard(title = "Create account and use it to sign in", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(labelText = "Username", inputType = "text", entry = newUser.username),
      @GemTextInput(labelText = "Passwort", inputType = "password", entry = newUser.password),
      @GemTextInput(labelText = "E-Mail-Adresse", inputType = "text", entry = newUser.email),
      @GemRow(hAlign = "center", component =
        @GemButton(label = "Account erstellen", leftClick = createUser)
      ),
      error@GemText(value = "")
    ])
  );
}
