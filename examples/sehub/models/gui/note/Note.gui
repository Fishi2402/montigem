package gui.note;

import Sehub.Post;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextareaInput;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import gui.note.Response;

component Note(Post post, Boolean showResponses){

  @GemCard(title = "", component =
      @GemColumn(height = "auto", width = "800px", vAlign = "top", rowGap = "5px", components = [
        @GemRow(hAlign = "right", colGap="5px", vAlign = "space-around", components = [
          @GemRow(width = "450px", component = postTitle@GemTextInput(labelText = "", inputType = "string", entry = post.title)),
          @GemRow(width = "140px", height = "30px" , vAlign = "bottom", component = @GemText(size = "0.5rem", value = post.author.username)),
          @GemRow(width = "200px", height = "30px" , colGap = "5px",vAlign = "bottom", hAlign = "right", components = [
            // @GemButton(label = "Bearbeiten", leftClick = editPost()),
            //toggleButton@GemButton(label = "📜", leftClick = toggleResponses()),
            replybutton@GemButton(label = "↪️ Reply ", leftClick = answerPost()),
            @GemButton(label = "❌", leftClick = deletePost())
          ])
        ]),
        message@GemTextareaInput(
                  id = "text1",
                  labelText = "",
                  entry = post.text
                ),
        responseList@iterate(Post r : post.responses){
           loadRespComponent@Response(post = r);
        }
      ])
  );

}
