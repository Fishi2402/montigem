package gui.note;

import Sehub.Post;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextareainput.GemTextareaInput;
import input.src.lib.gemtextinput.GemTextInput;
import basic.src.lib.gembutton.GemButton;
import arrange.src.lib.gemrow.GemRow;
import gui.note.Response;

component Note(Post post){

  @GemCard(title = "", component =
      @GemColumn(height = "auto", width = "800px", vAlign = "top", rowGap = "5px", components = [
        @GemRow(hAlign = "right", colGap="5px", vAlign = "space-around", components = [
          @GemRow(width = "450px", component = @GemTextInput(labelText = "", inputType = "string", entry = post.title)),
          @GemRow(width = "140px", height = "30px" , vAlign = "bottom", component = @GemText(style= "font-size: 0.5rem;", value = post.author.username)),
          @GemRow(width = "200px", colGap = "5px", hAlign = "right", components = [
            // @GemButton(label = "Bearbeiten", leftClick = editPost),
            @GemButton(label = "↪️ Reply", leftClick = answerPost),
            @GemButton(label = "❌", leftClick = deletePost)
          ])
        ]),
        @GemTextareaInput(
                  id = "text1",
                  labelText = "",
                  entry = post.text
                ),

        @iterate(Post r : post.responses){
          @Response(post = r);
        }
      ])
  );

}
