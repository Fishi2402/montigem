package gui.note;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextareainput.GemTextareaInput;
import input.src.lib.gemtextinput.GemTextInput;
import basic.src.lib.gembutton.GemButton;
import arrange.src.lib.gemrow.GemRow;

component Note(){
  @GemCard(title = "TODO: CommentTitle", component =
      @GemColumn(height = "auto", width = "800px", vAlign = "top", rowGap = "5px", components = [
        @GemRow(hAlign = "left", vAlign = "space-around", components = [
          @GemRow(width = "200px", component = @GemTextInput(labelText = "", inputType = "string")),
          @GemRow(width = "150px", vAlign = "space-around", component = @GemText(style = "font-size:1em; font-family:monospace; color:red" , value = "17-08 15:23")),
          @GemRow(width = "450px", colGap = "5px", hAlign = "right", components = [
            @GemButton(label = "Bearbeiten", leftClick = editPost),
            @GemButton(label = "Antworten", leftClick = answerPost),
            @GemButton(label = "Löschen", leftClick = deletePost)
          ])
        ]),
        @GemTextareaInput(
                  id = "text1",
                  labelText = ""
                )
      ])
  );
}
