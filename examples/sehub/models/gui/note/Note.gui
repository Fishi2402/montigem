package gui.note;

import Sehub.Post;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextareainput.GemTextareaInput;
import input.src.lib.gemtextinput.GemTextInput;
import basic.src.lib.gembutton.GemButton;
import arrange.src.lib.gemrow.GemRow;
import gui.note.Response;

component Note(Post post, Boolean showResponses){

  @GemCard(title = "", component =
      @GemColumn(height = "auto", width = "800px", vAlign = "top", rowGap = "5px", components = [
        @GemRow(hAlign = "right", colGap="5px", vAlign = "space-around", components = [
          @GemRow(width = "450px", component = postTitle@GemTextInput(labelText = "", inputType = "string", entry = post.title, disabled = false, placeholder="Your title")),
          @GemRow(width = "140px", height = "30px" , vAlign = "bottom", component = @GemText(style= "font-size: 0.5rem;", value = post.author.username)),
          @GemRow(width = "200px", height = "30px" , colGap = "5px",vAlign = "bottom", hAlign = "right", components = [
            // @GemButton(label = "Bearbeiten", leftClick = editPost),
            //toggleButton@GemButton(label = "📜", leftClick = toggleResponses ),
            replybutton@GemButton(label = "↪️ Reply ", leftClick = answerPost, disabled = false),
            @GemButton(label = "❌", leftClick = deletePost, disabled = false)
          ])
        ]),
        message@GemTextareaInput(
                  id = "text1",
                  labelText = "",
                  entry = post.text,
                  disabled = false,
                  placeholder = "Your comment"
                ),
        responseList@iterate(Post r : post.responses){
           loadRespComponent@Response(post = r);
        }
      ])
  );

}
