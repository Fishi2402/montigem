package gui.note;

import Sehub.Post;

import arrange.GemColumn;
import arrange.GemCard;
import basic.GemText;
import input.GemTextareaInput;
import input.GemTextInput;
import basic.GemButton;
import arrange.GemRow;

component Response(Post post){

        @GemRow(width = "800px", colGap = "5px", hAlign = "right", components = [

        // Small ICON indicating Resonse-Type
        @GemRow(width = "20px", hAlign = "right", height = "100%", vAlign = "top", component = @GemText( value = "↪") ),

        @GemColumn(height = "auto", width = "770px", vAlign = "top", components = [

          // Respnse Header
          @GemRow(hAlign = "left", vAlign = "bottom", height = "100%" , components = [
            @GemRow(width = "640px", vAlign = "bottom", height = "100%" , hAlign = "left",  component = @GemText(value = "[ " + post.author.username + post.title )),
            @GemRow(width = "130px", vAlign = "bottom", height = "100%" ,colGap = "5px", hAlign = "right", components = [
              @GemButton(label = "❌", leftClick = deletePost, disabled = false)
            ])
          ]),

          // Textarea (where you enter the response)
          @GemTextareaInput(
                    id = "response",
                    labelText = "",
                    entry = post.text,
                    disabled = false,
                    placeholder = "Your reply"
                  )
          ])

    ]);



}
