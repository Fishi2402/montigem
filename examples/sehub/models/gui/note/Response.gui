package gui.note;

import Sehub.Post;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemcard.GemCard;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextareainput.GemTextareaInput;
import input.src.lib.gemtextinput.GemTextInput;
import basic.src.lib.gembutton.GemButton;
import arrange.src.lib.gemrow.GemRow;

component Response(Post post){

    @GemRow(width = "800px", colGap = "5px", hAlign = "right", components = [

        // Small ICON indicating Resonse-Type
        @GemRow(width = "20px", hAlign = "right", height = "100px", vAlign = "top", component = @GemText( value = "↪") ),

        @GemColumn(height = "auto", width = "770px", vAlign = "top", rowGap = "5px", components = [

          // Respnse Header
          @GemRow(hAlign = "left",  components = [
            @GemRow(width = "440px", vAlign = "space-around", hAlign = "left",  component = @GemText(value = post.title)),
            @GemRow(width = "330px", colGap = "5px", hAlign = "right", components = [
              @GemButton(label = "❌", leftClick = deletePost)
            ])
          ]),

          // Textarea (where you enter the response)
          @GemTextareaInput(
                    id = "response",
                    labelText = "",
                    entry = post.text
                  )
          ])

    ]);


}
