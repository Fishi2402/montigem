package gui.usersettings;

import Sehub.User;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

import basic.src.lib.gembutton.GemButton;
import basic.src.lib.gemtext.GemText;
import input.src.lib.gemtextinput.GemTextInput;
import table.src.lib.gemtable.GemTable;

component UserDisplay(User user) {
  @GemRow(colGap = "5px", hAlign = "space-between", vAlign = "center", components = [
    @GemColumn(width = "50px", component = @GemText(value = "Bild")),
    @GemColumn(width = "20%", components = [
      account@GemText(value = user.username),
      email@GemText(value = user.email)
    ]),
    @GemColumn(width = "20%", components = [
      role@GemTextInput(
        labelText = "Role",
        inputType = "dropdown",
        options = null,
        entry = user.role,
        validity = user.validityRole
      )
     // role@GemTextInput(labelText = "Role", inputType = "dropdown", entry = user.role, options = null)
    ]),
    @GemColumn(width = "20%", components = [
      regLabel@GemText(value = "Registration Date"),
      registration@GemText(value = user.registrationDate)
    ]),
    @GemColumn(width = "50px", component =
      removeUser@GemButton(label = "x", leftClick = removeUser)
    )
  ]);
}
