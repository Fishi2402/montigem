package gui.usersettings;

import Sehub.User;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.table.GemTable;

component UserDisplay(User user) {
  @GemRow(colGap = "5px", hAlign = "space-between", vAlign = "center", components = [
    @GemColumn(width = "50px", component = @GemImage(source = "assets/images/avatars/avatar_" + user.avatar + ".png")),
    @GemColumn(width = "20%", components = [
      account@GemText(value = user.username),
      email@GemText(value = user.email)
    ]),
    @GemColumn(width = "30%", components = [
      @GemColumn(width = "20%", component =
        errorrole@GemText(value = "")
      ),
      @GemColumn(width = "80%", component =
        role@GemDropdownInput(
          labelText = "Role",
          options = null,
          entry = user.role,
          validity = user.validityRole,
          disabled = false
        )
      )
    ]),
    @GemColumn(width = "20%", components = [
      regLabel@GemText(value = "Registration Date"),
      registration@GemText(value = user.registrationDate)
    ]),
    @GemColumn(width = "50px", component =
      removeUserButton@GemButton(label = "x", leftClick = removeUser(), disabled = false)
    )
  ]);
}
