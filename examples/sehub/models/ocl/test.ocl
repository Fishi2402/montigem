package ocl;
import Sehub.SehubRole;
import Sehub.User;
import Sehub.Post;
import Sehub.Artifact;

ocl SehubOCL {

  context User u inv UsernameNotEmpty:
    !(u.username == "");

  context User u inv UsernameNotAdmin:
    !(u.username == "admin");

  context User u inv PasswordDoesNotContainUsername:
    !(u.password.contains(u.username));

  context Post p inv PostDoesNotContainSwearwords:
    let bannedWords = {"swearword1", "swearword2", "swearword3"}
    in
      forall String w in bannedWords:
        !(p.text.contains(w));

  context Artifact a inv ArtifactCanNotBeProducedByArtifactItRefersTo:
    forall Artifact a1 in a.produced:
      forall Artifact a2 in a.referred:
        a1 != a2;

  context User u inv RegistrationDateIsNotInFuture:
    !(u.registrationDate.isAfter(ChronoLocalDateTime.from(ZonedDateTime.now())));

  context Project p inv GuestCannotHaveProjectRights:
    forall User u in p.users:
      u.role != SehubRole.GUEST;

  /* context User u inv UsernameHasToBeUnique:
    forall User u1 in loadAll(User.username): // loadAll in Backend, two methods, one for loading, one for the constraints.
      !(u1.username.equals(u.username))*/     // Developer should be able to pass objects when previously loaded?

  /* context Project p, User u inv UserNameCanNotBeTheSameAsProjectName:
    !(p.name.equals(u.username))

    message: "Username can not be the same as project name"
    */

  /*context Project p inv UserIsActivated:
    forall User u in p.users:
      u.activated == true;
    message: "User is not activated"
  */
}