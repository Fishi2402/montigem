/* (c) https://github.com/MontiCore/monticore */
umlp SELib {
  class Person {
    String name;
	  String email;
	  String password;
	  boolean isManager;
  }

  interface TimeMarker {
    Long created;
  }

  abstract class Medium implements TimeMarker {
    String isbn;
    String title;
  }

  class CDDescription extends Medium;

  class BookDescription extends Medium {
    String description;
    String imageUrl;
    Genre genre;
  }

  enum Genre {
    FICTION,
    NON_FICTION,
    MYSTERY,
    SCIENCE_FICTION,
    ROMANCE,
    FANTASY,
    HORROR,
    SELF_HELP,
    BIOGRAPHY,
    HISTORY,
    OTHER;
  }

  class ScientificBookDescription extends BookDescription {
    String doi;
  }

  class Book{
    // unique number -> should probably be incremented per new book
    int bookNumber;
    / String inventoryNumber;
  }

  association [1] Person -> (rentedBooks) Book [*];

  association [*] Book -> (description) BookDescription [1];

  association [*] Person -> (favorite) Book [0..1];

  /association [1] Person -> (rentedBookDescriptions) BookDescription [*];
}
