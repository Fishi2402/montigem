/* (c) https://github.com/MontiCore/monticore */

umlp Log_MC_JAR {

  class MCJarLogEntry {
    String toolVersion;           // e.g. "7.5.0-SNAPSHOT"
    java.time.Duration duration;  // Duration of the run
    java.time.Instant receivedTime; // When was the request received on the server? - Added in backend
    java.net.InetAddress origin; // Who sent the request? (Anonymized) - Added in backend
  }

  association paramater [1] MCJarLogEntry -> MCJarCLIParameter [1]; // How was the .jar started?
  association summary [1] MCJarLogEntry -> MCSummary [0..1] ; // Information about input & execution. e.g. size of AST
  association error [1] MCJarLogEntry -> ErrorEntry [0..1] ; // If execution was aborted: which error was thrown?

  // Not specific for MCJar, can be used by other Logs too
  class ErrorEntry {
    Optional<String> code;
    String message;
  }

  // Information how the JAR was started
  // Specific to MCJar
  class MCJarCLIParameter {
    List<String> grammar; // Filenames of input grammars
    boolean dstlGen;      // is Transformation-Grammar generated?
    boolean script;       // is a custom script used?
  }

  // Data from the SummaryReporter
  // Same for every Log, which is using the SummaryReporter to collect data
  class MCSummary {
    int errors;
    int warnings;
    int generated_files;
    int instantiations;
    int template_includes;
    int template_writes;
    int used_standard_templates;
    int unused_standard_templates;
    int used_handwritten_templates;
    int unused_handwritten_templates;
    int max_template_depth;
    int max_ast_depth;
    int ast_node_instances;
    int ast_node_types;
    int ast_node_visits;
    int variables;
    int variable_assignments;
    int ast_hook_point_sets;
    int ast_hook_point_calls;
    int code_hook_point_sets;
    int code_hook_point_calls;
    int template_hook_point_sets;
    int template_hook_point_calls;
    int string_hook_point_sets;
    int string_hook_point_calls;
    int empty_hook_point_called;
    int empty_hook_point_calls;
  }

  class HI{}
}

