import Webshop.*;
import umlp.backendrte.common.NotificationScope;

sequencediagram TotalTest {
  ... o:Order;
  item:Item;

  let int total1 = o.getTotal();
  assert total1 == 0;
  assert !"foo".isEmpty();

  //trigger section
  //interaction section
  o -> o : trigger addItem(item) {
    assert o.getTotal() == 0;

    //this is the next internal call
    o -> o : addItem(o, NotificationScope.ALL);
    o <- o : return;
    //condition checks after a return should be okay
    let int total2 = o.getTotal();
    assert total2 == 6;
    o -> o : return;
  } //no implicit return here
  //end interaction section
  //end trigger section

  o <- o : trigger getTotal();
  o <- o : return 6;

  o -> o : addItem(item) {

  }
  //this condition must be checked after the end of the activity bar, not after the call
  assert o.getTotal() == total2 + 6;

  class Order -> class Order : trigger static foo();
  assert !"foo".isEmpty();
  let Order anOrderInstance = Order.getAnInstance();
  class Order -> anOrderInstance : _doFoo();
  class Order <- anOrderInstance : throw RuntimeException("foo");
}

