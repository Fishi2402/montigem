import Webshop.*;

sequencediagram TotalTest {
  ... o:Order;

  assert o.getTotal() == 0; //have to use valid java here since parser isn't that good

  //make sure event queue is empty

  o -> o : trigger addItem(item) {
    //a little pre condition check
    assert o.getTotal() == 0;

    //this is the next internal call
    o -> o : addItem(o, NotificationScope.ALL);

    o -> o : return;
    //condition checks after a return should be okay
    assert o.getTotal() == 6;
  }

  //make sure event queue contains Call("addItem"), End("addItem", null)

  assert o.getTotal() == 6;

  class Order -> class Order : static foo();
}

