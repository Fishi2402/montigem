//import section
import Webshop.*;
//end import section
sequencediagram TotalTest {
  //sd-object section
  ... o:Order;
  item:Item;
  //end sd-object section

  //early body section
  let int total1 = o.getTotal();
  assert total1 == 0;
  //end early body section

  //body section
  //trigger section
  //interaction section
  o -> o : trigger addItem(item) {
    assert o.getTotal() == 0;

    //this is the next internal call
    o -> o : addItem(o, NotificationScope.ALL);
    o <- o : return;
    //condition checks after a return should be okay
    let int total2 = o.getTotal();
    assert total2 == 6;
    o -> o : return;
  } //no implicit return here
  //end interaction section
  //end trigger section

  o <- o : trigger getTotal;
  o <- o : return 6;

  class Order -> class Order : trigger static foo();
  class Order -> Order o2 = new Order();
  class Order <- o2 : return;
  class Order -> o2 : _doFoo();
  class Order <- o2 : throw RuntimeException("foo");
}

