package monticore;

umlp University {

  abstract class Person {
    String name;
    String nationality;
  }

  class Contact {
    String city;
    int zip;
    String street;
    String email;
  }

//  package uni { // TODO: Bug in cd4c: classes in this package are added twice to the AST
    class Student extends Person {
      int semester;
      List<Course> courses;
//      StudentStatus status;  //TODO: Fix Enum Bug in cd4c
    }

    class Course {
      String name;
      Person professor;
      // Course requirement;
      double grade;
    }

    class SportHall ;

//   enum StudentStatus { ENROLLED, EXMATRICULATED, GRADUATED; }  //TODO: Fix Enum Bug in cd4c
// }

  composition Student -> Course [*];
  association contactBook Person [java.lang.String] -> Contact;
  association [*] Person (parent) <-> (children) Student [*]; // [0..2] not allowed, has to be checkd by a CoCo
//  aggregation Course -> SportHall [0..*] ; // TODO: aggregations do not exist in CD4A

}
