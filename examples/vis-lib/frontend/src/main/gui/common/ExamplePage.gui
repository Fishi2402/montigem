package common;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

component ExamplePage(
  GUIViewElement component,
  String basePath,
  String componentName,
  String position = "right"
) {
  @guard(position == "right") {
    @GemRow(wrap = "wrap", components = [
      @GemColumn(width = "50%", components = [
        component
      ]),
      @GemColumn(width = "48%", components = [
        @CodeViewer(basePath = basePath, componentName = componentName)
      ])
    ]);
  };

  @guard(position == "bottom") {
    @GemColumn(components = [
      component,
      @CodeViewer(basePath = basePath, componentName = componentName)
    ]);
  };
}
