package example_basic;

import mc.fenix.basic.GemLoadingSpinner;

page GemLoadingSpinnerExample() {
  @GemLoadingSpinner(
    size = "100px",
    color = "blue",
    intermediate = false,
    progress = 0.5f,
    label = "50% loaded"
  );
  @GemLoadingSpinner(
    size = "200px",
    intermediate = true,
    label = "Loading ..."
  );
}
