package example_basic;

import mc.fenix.basic.GemLoadingSpinner;
import common.ExamplePage;
import mc.fenix.arrange.GemColumn;

page GemLoadingSpinnerExample() {
  @ExamplePage(
    component = @GemColumn(components = [
      @GemLoadingSpinner(
        size = "100px",
        color = "blue",
        intermediate = false,
        progress = 0.5f,
        label = "50% loaded"
      ),
      @GemLoadingSpinner(
        size = "200px",
        intermediate = true,
        label = "Loading ..."
      )
    ]),
    basePath = "example_basic",
    componentName = "GemLoadingSpinnerExample"
  );
}
