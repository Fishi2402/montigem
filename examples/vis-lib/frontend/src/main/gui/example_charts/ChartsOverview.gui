package example_charts;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import common.ComponentCard;

page ChartsOverview() {
  @GemColumn(
    hAlign = "center",
    components = [
      @GemText(value = "Charts Overview", size = "2rem", weight = "bold", height = "auto", width = "auto"),
      @GemText(value = "Explore the available chart components", size = "1.2rem", color = "gray", height = "auto", width = "auto"),

      @GemRow(
        wrap = "wrap",
        hAlign = "center",
        rowGap = "20px",
        colGap = "20px",
        width = "100%",
        components = [
            @ComponentCard(title = "Bar Chart", icon = "bar_chart", click = goToBarChart()),
            @ComponentCard(title = "Pie Chart", icon = "pie_chart", click = goToPieChart()),
            @ComponentCard(title = "Line Chart", icon = "show_chart", click = goToLineChart()),
            @ComponentCard(title = "Gauge Chart", icon = "speed", click = goToGaugeChart()),
            @ComponentCard(title = "Radar Chart", icon = "radar", click = goToRadarChart()),
            @ComponentCard(title = "Scatter Plot", icon = "scatter_plot", click = goToScatterPlot()),
            @ComponentCard(title = "Venn Diagram", icon = "bubble_chart", click = goToVennDiagram()),
            wipNetwork@ComponentCard(title = "Network Graph (WIP)", icon = "hub", click = goToNetworkGraph()),
            @ComponentCard(title = "Heatmap", icon = "grid_on", click = goToHeatmap()),
            @ComponentCard(title = "Sunburst", icon = "donut_large", click = goToSunburst()),
            @ComponentCard(title = "Timeline", icon = "view_timeline", click = goToTimeline()),
            @ComponentCard(title = "Time Series", icon = "timeline", click = goToTimeSeries()),
            wipBoxplot@ComponentCard(title = "Box Plot (WIP)", icon = "candlestick_chart", click = goToBoxPlot()),
            wipBullet@ComponentCard(title = "Bullet Chart (WIP)", icon = "linear_scale", click = goToBulletChart()),
            wipCandlestick@ComponentCard(title = "Candlestick (WIP)", icon = "waterfall_chart", click = goToCandlestick())
        ]
      )
    ]
  );
}
