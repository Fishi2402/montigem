package example_charts;

import Domain.Person;
import mc.fenix.charts.GemHeatmapChart;
import mc.fenix.charts.GemHeatmapChartTypes.GemHeatmapChartData;
import common.ExamplePage;

page GemHeatmapChartExample(List<Person> persons) {
  @ExamplePage(
    component = @GemHeatmapChart(
      data = getData(),
      timestampdata = false,
      xLabel = "amount of money spent for stocks",
      yLabel = "age groups"
    ),
    basePath = "example_charts",
    componentName = "GemHeatmapChartExample"
  );
}
