package example_monaco;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;
import mc.fenix.editor.MonacoEditor;
import Domain.Person;
import common.ExamplePage;

page ExampleFromLib(Person p) {
  @ExamplePage(
    component = @GemColumn(width = "100%", components = [
      @MonacoEditor(
        width = "100%",
        height = "200px",
        entry=p.aboutMe,
        disabled=false,
        theme="vs-light",
        highlighting = getHighlights(),
        hoverContents=getHoverContents(),
        initialScrollToLine = 20,
        language="mySpecialLanguage"
      ),
      @GemText(value="You will also have to add @umlp/editor to your package.json and add the src/assets aka node_modules/monaco-editor to your angular.json!")
    ]),
    basePath = "example_monaco",
    componentName = "ExampleFromLib"
  );
}
