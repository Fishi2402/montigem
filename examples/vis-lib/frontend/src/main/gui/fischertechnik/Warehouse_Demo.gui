package fischertechnik;

import Domain.FischertechnikWarehouseState;

import mc.fenix.fischertechnik.Warehouse;
import mc.fenix.arrange.GemColumn;
import mc.fenix.input.GemRangeInput;
import mc.fenix.input.GemCheckBoxInput;

page Warehouse_Demo(FischertechnikWarehouseState state){
  @GemColumn(
    rowGap = "15px",
    components = [
      @GemRangeInput(
        id="depth-percentage",
        labelText="Tiefe:",
        vertical=false,
        step=1,
        minValue=0,
        maxValue=100,
        size="300px",
        value=state.depthPercentage
      ),
      @GemRangeInput(
        id="vertical-percentage",
        labelText="Höhe:",
        vertical=false,
        step=1,
        minValue=0,
        maxValue=100,
        size="300px",
        value=state.verticalPercentage
      ),
      @GemRangeInput(
        id="hotizontal-percentage",
        labelText="Tiefe:",
        vertical=false,
        step=1,
        minValue=0,
        maxValue=100,
        size="300px",
        value=state.horizontalPercentage
      )
    ]
  );
  @Warehouse(
    depthPercentage=state.depthPercentage,
    verticalPercentage=state.verticalPercentage,
    horizontalPercentage=state.horizontalPercentage
  );
}
