package manual;

import Domain.Person;
import mc.fenix.charts.GemBulletChart;
import manual.*;

page BulletTest(
    List<Person> persons,
    List<Integer> range,
    List<Integer> steps
) {
  @LayoutTester(input =
    bulletchart@GemBulletChart(
      value = null,
      reference = 4000,
      thresholdvalue = 4000,
      title = "Profit of MontiCore Inc. from stocks",
      subtitle = "in US $",
      range = range,
      steps = steps
    )
  );

  @LayoutTester(input =
    bulletchart2@GemBulletChart(
      value = 3500,
      reference = 4000,
      thresholdvalue = 4000,
      title = "Profit of MontiCore Inc. from stocks",
      subtitle = "in US $",
      range = [0, 5000],
      steps = [1500, 3000]
    )
  );
}
