package manual;

import Domain.Person;
import mc.fenix.charts.GemPieChart;
import manual.*;

page PieTest(List<Person> persons) {
  @LayoutTester(input =
    @GemPieChart(
      data = getData(),
      innerRadius = 10
    )
  );

  @LayoutTester(input =
    @GemPieChart(
      data = getData(),
      innerRadius = 100
    )
  );

}
