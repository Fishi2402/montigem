package manual;

import Domain.Person;
import mc.fenix.charts.GemRadarChart;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemCheckBoxInput;
import mc.fenix.input.GemRangeInput;
import common.ExamplePage;
import manual.*;

page RadarChartTest(
  List<Person> persons,
  String width = "500px",
  String height = "500px",
  boolean showLegend = true,
  boolean showLabels = true,
  int opacityPercent = 40
)
{
  @LayoutTester(input =
    @GemColumn(components = [
     @GemRow(wrap = "wrap", components = [
       @GemButton(label = "Height +", leftClick = changeHeight(50)),
        @GemButton(label = "Height -", leftClick = changeHeight(-50)),
       @GemText(value = "Height: " + height),
       @GemButton(label = "Width +", leftClick = changeWidth(50)),
       @GemButton(label = "Width -", leftClick = changeWidth(-50)),
        @GemText(value = "Width: " + width)
     ]),
      @GemRow(wrap = "wrap", vAlign = "center", hAlign = "left", components = [
        @GemCheckBoxInput(labelText = "Show Legend", checked = showLegend),
        @GemCheckBoxInput(labelText = "Show Labels", checked = showLabels),
        @GemText(value = "Opacity:"),
        @GemRangeInput(minValue = 0, maxValue = 100, step = 10, value = opacityPercent, size = "300px")
      ]),
      @GemColumn(
        width = width,
        components = [
          @GemRow(
            height = height,
            components = [
             radarchart@GemRadarChart(
              data = getData(),
              fill = true,
              stepSize = 1.0,
              min = 0.0,
              max = 5.0,
              width = "100%",
              height = "100%",
              showLegend = showLegend,
              showLabels = showLabels,
              opacity = opacityPercent / 100.0
            )
          ]
        )
      ]
    )
  ])
  );
}
