import java.time.LocalDateTime;

classdiagram Domain {

  class Conversation {
    String conversationid;
  }

  class Message {
    String content;
    Role sender;
    Role receiver;
    LocalDateTime timestamp;

  }

  enum Role {
    SYSTEM, USER, ASSISTANT, TOOL;
  }


  class Person {
    java.time.LocalDate birthday;
    String name;
    String aboutMe;
    ?boolean employed;
  }

  class Address {
    String street;
    int house;
  }

  class Stock {
    java.time.LocalDateTime date;
    String name;
    int price;
  }

  class Club {
    String name;
  }

  <<singleton>>
  class App {
    Boolean isOld(Person p);
  }

  association home [1] Person -> (address) Address [0..1];

  association friends [*] Person -> (friends) Person [*];

  association stocks [*] Person -> (stocks) Stock [*];

  association [*] Club -> (members) Person [*];

  association [1] Conversation -> (messages) Message[*];

}
