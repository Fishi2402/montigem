classdiagram Domain {
  class Person {
    java.time.LocalDate birthday;
    String name;
    //?boolean employed;
  }

  class Address {
    String street;
    int house;
  }

  class Stock {
    java.time.LocalDate date;
    int open;
    int close;
    int high;
    int low;
  }


  association home [1] Person -> (address) Address [0..1];

  association friends [*] Person -> (friends) Person [*];

  association stocks [*] Person -> (stocks) Stock [*];
}
