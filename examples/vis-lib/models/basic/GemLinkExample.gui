package basic;
import basic.src.lib.gemlink.GemLink;
//The link element is used to create a hyperlink to another web page or to a specific section within a page.
//The source attribute specifies the destination of the link. The text attribute specifies the text to be displayed for the link
page GemLinkExample(){
  @GemLink(url = "https://www.google.com/");
}
