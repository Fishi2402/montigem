package example_arrange;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemLink;

page GemDialogExample(?boolean dialogOpen = false) {
  @GemButton(label = "Click Me!", leftClick = openDialog());
  dialog@GemDialog(isOpen = dialogOpen, component =
    @GemCard(
      title = "Info Text",
      component = @GemText(value = "Some Text")
    )
  );

}
