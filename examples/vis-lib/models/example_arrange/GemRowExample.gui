package example_arrange;

import arrange.GemRow;
import input.GemTextInput;
import Domain.Person;

page GemRowExample(Person p) {
  @GemRow(
    components = [
      @GemTextInput(labelText = "Birthday", entry = p.birthday, inputType = "date"),
      @GemTextInput(labelText = "Name", entry = p.name)
     ]
  );
}
