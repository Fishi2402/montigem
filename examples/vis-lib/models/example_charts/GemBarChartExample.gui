package example_charts;

import mc.fenix.charts.GemBarChart;
import mc.fenix.charts.GemBarChartTypes.GemBarChartData;

page GemBarChartExample(
  GemBarChartData data,
  Integer maxValue,
  Integer minValue
) {
  @GemBarChart(
    data = data,
    stacked = true,
    maxValue = maxValue,
    minValue = minValue
  );
}
