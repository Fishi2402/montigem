package example_charts;

import mc.fenix.charts.GemBarChart;
import mc.fenix.input.GemTextInput;

import Domain.App;

page GemBarChartFromCommand(App app, String myStringValue = "default")
{
  barchart@GemBarChart(
    data = app.getBarChart(myStringValue),
    stacked = false,
    maxValue = 10,
    minValue = null
  );
}
