package example_charts;

import charts.GemBulletChart;
import Domain.Person;

page GemBulletChartExample(
  List<Person> persons,
  List<Integer> range,
  List<Integer> steps) {
  bulletchart@GemBulletChart(
    value = null,
    reference = 4000,
    thresholdvalue = 4000,
    title = "Profit of MontiCore Inc. from stocks",
    subtitle = "in US $",
    range = range,
    steps = steps
  );
}
