package example_charts;

import charts.GemBulletChart;
import Domain.Person;

page GemBulletChartExample(
  List<Person> persons,
  List<Integer> range,
  List<Integer> steps) {
  bulletchart@GemBulletChart(
    value = null,
    reference = 22,
    thresholdvalue = 22,
    title = "Age Distribution",
    subtitle = "Age",
    range = range,
    steps = steps
  );
}
