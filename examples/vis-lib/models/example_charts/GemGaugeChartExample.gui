package example_charts;

import charts.GemGaugeChart;
import charts.GemGaugeChartTypes.GemGaugeChartData;

page GemGaugeChartExample(
  GemGaugeChartData data
) {
  @GemGaugeChart(
    data = data,
    min = 1,
    max = 100,
    unit = "meters",
    textValue = "50"

  );
}

