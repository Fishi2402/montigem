package example_charts;

import Domain.Person;
import mc.fenix.charts.GemRadarChart;

page GemRadarChartExample(List<Person> persons)
{
  radarchart@GemRadarChart(
    data = getData(),
    fill = true,
    stepSize = 1.0,
    min = 0.0,
    max = 5.0
  );
}
