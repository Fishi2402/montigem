package example_input;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextareaInput;
import Domain.Message;


component GemChat(List<Message> messages, Message userMsg) {

  @GemCard(title="Chat with me :)",component=
    @GemColumn(components=[
      @iterate(Message msg : messages) {
        @GemRow(components = [
          @GemText(value=msg.content)]);
    },@GemRow(components=[
        @GemColumn(width="80%",components=[userInput@GemTextareaInput(placeholder="Start Chatting :)",entry=userMsg.content,resize="none")]),
        @GemColumn(width="20%",components=[@GemButton(leftClick=sendMessage(userMsg),label="send")])])
    ])
  );
}
