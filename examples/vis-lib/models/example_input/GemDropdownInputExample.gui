package example_input;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.Option;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;


page GemDropdownInputExample() {
  @GemRow(
    components = [
      @GemDropdownInput(
        id = "myDropdown1",
        width = "50%",
        labelText = "Hobby:",
        options = [
          Option(""),
          Option("Tennis"),
          Option("Sleeping"),
          Option("Model-driven development")
        ]
      )
    ]
  );
  @GemColumn(
    rowGap = "15px",
    components = [
      @GemRow(
        components = [
          @GemDropdownInput(
            id = "myDropdown2",
            width = "50%",
            labelText = "Hobby:",
            options = [
              Option(""),
              Option("Tennis"),
              Option("Sleeping"),
              Option("Model-driven development"),
              Option("Tennis"),
              Option("Sleeping"),
              Option("Model-driven development"),
              Option("Tennis"),
              Option("Sleeping"),
              Option("Model-driven development")
            ],
            searchEnabled = true
          )
        ]
      ),
      @GemRow(
        components = [
          @GemDropdownInput(
            id = "myDropdown3",
            width = "50%",
            labelText = "Hobby:",
            options = [
              Option(""),
              Option("Tennis"),
              Option("Sleeping"),
              Option("Model-driven development")
            ]
          )
        ]
      )
    ]
  );
}
