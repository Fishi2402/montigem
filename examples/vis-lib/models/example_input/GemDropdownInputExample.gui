package example_input;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.Option;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;


page GemDropdownInputExample() {
  @GemRow(
    components = [
      @GemDropdownInput(
        width = "50%",
        labelText = "Academic degree:",
        options = [
          Option("Bachelor"),
          Option("Master"),
          Option("PhD")
        ]
      )
    ]
  );
  @GemColumn(
    rowGap = "15px",
    components = [
      @GemRow(
        components = [
          @GemDropdownInput(
            width = "50%",
            labelText = "Hobby:",
            options = [
              Option("Tennis"),
              Option("Sleeping"),
              Option("Model-driven development"),
              Option("Video gaming"),
              Option("Photographing"),
              Option("Bouldering"),
              Option("Football"),
              Option("Drawing"),
              Option("Social Media"),
              Option("Knitting"),
              Option("Volleyball"),
              Option("Running"),
              Option("Swimming"),
              Option("Reading"),
              Option("Music"),
              Option("Movies"),
              Option("Hiking"),
              Option("Climbing"),
              Option("Travelling"),
              Option("Scuba diving"),
              Option("Hacking"),
              Option("Cooking"),
              Option("Gardening"),
              Option("Other")
            ],
            searchEnabled = true
          )
        ]
      ),
      @GemRow(
        components = [
          @GemDropdownInput(
            width = "50%",
            labelText = "How often do you attend your Hobby?",
            options = [
              Option("Once a year"),
              Option("Once a month"),
              Option("Once a week"),
              Option("Three times a week"),
              Option("Everyday"),
              Option("More than once a day")
            ]
          )
        ]
      )
    ]
  );
}
