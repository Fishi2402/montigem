package example_input;

import mc.fenix.input.GemRadioInput;

page GemRadioInputExample() {
  @GemRadioInput(
    id = "genderMale",
    labelText = "Male",
    value = "male"
  );
  @GemRadioInput(
    id = "genderFemale",
    labelText = "Female",
    value = "female"
  );
  @GemRadioInput(
    id = "genderOther",
    labelText = "Other",
    value = "other"
  );
}
