package example_input;

import mc.fenix.input.GemRangeInputTypes.Marker;
import mc.fenix.input.GemRangeInput;

page GemRangeInputExample() {

  @GemRangeInput(
    id = "satisfaction",
    labelText = "Satisfaction:",
    vertical = false,
    step = 1,
    minValue = 1,
    maxValue = 5,
    size = "300px",
    ticks = [
      Marker(1, "very bad"),
      Marker(2, "bad"),
      Marker(3, "neutral"),
      Marker(4, "good"),
      Marker(5, "very good")
    ]
  );

  @GemRangeInput(
    id = "priceFilter",
    labelText = "price (€):",
    vertical = false,
    step = 50,
    minValue = 0,
    maxValue = 500,
    size = "350px",
    snapping = true
  );

  @GemRangeInput(
      id = "projectPhase",
      labelText = "Projectphase:",
      vertical = true,
      step = 1,
      minValue = 1,
      maxValue = 4,
      size = "250px",
      ticks = [
        Marker(1, "planning"),
        Marker(2, "development"),
        Marker(3, "testing"),
        Marker(4, "release")
      ]
    );

  @GemRangeInput(
    id = "volumeControlVertical",
    labelText = "Volume:",
    vertical = true,
    step = 10,
    minValue = 0,
    maxValue = 100,
    size = "200px",
    ticks = [
      Marker(0, "0%"),
      Marker(25, "25%"),
      Marker(50, "50%"),
      Marker(75, "75%"),
      Marker(100, "100%")
    ]
  );

}
