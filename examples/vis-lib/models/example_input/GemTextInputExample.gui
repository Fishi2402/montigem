package example_input;

import Domain.Person;

import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.GemDropdownOption;

page GemTextInputExample(List<Person> persons) {
  @iterate(Person p : persons) {
    @GemTextInput(
      id = "name",
      labelText = "Name:",
      entry = p.name,
      disabled = true
    );
    @GemTextInput(
      inputType = "date",
      labelText = "Date of birth:",
      entry = p.birthday
    );
    @GemDropdownInput(
      labelText = "Hobby:",
      entry = p.aboutMe,
      options = [
        GemDropdownOption(""),
        GemDropdownOption("Tennis"),
        GemDropdownOption("Sleeping"),
        GemDropdownOption("Model-driven development")
      ]
    );

  }
}
