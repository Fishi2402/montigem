package example_input;

import Domain.Person;

import input.GemTextInput;

page GemTextInputExample(List<Person> persons) {
  @iterate(Person p : persons) {
    @GemTextInput(
      id = "name",
      labelText = "Name:",
      entry = p.name,
      disabled = true
    );
    @GemTextInput(
      inputType = "date",
      labelText = "Date of birth:",
      entry = p.birthday
    );
  }
}
