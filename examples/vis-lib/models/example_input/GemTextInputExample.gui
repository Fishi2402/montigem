package example_input;

import Domain.Person;

import input.GemTextInput;

page GemTextInputExample(Person persons) {
  @iterate(Person p : persons) {
    dropdown@GemTextInput(
      id = "firstName",
      labelText = "First name: ",
      inputType = "dropdown",
      options = null,
      entry = p.name
    );
  }
  @GemTextInput(
    id = "lastName",
    labelText = "Last name: ",
    inputType = "text"
  );
  @GemTextInput(
    id = "dateOfBirth",
    labelText = "Date of birth: ",
    inputType = "date"
  );
}
