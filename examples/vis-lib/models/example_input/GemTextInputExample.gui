package example_input;

import Domain.Person;

import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextInputTypes.Option;

page GemTextInputExample(List<Person> persons) {
  @iterate(Person p : persons) {
    @GemTextInput(
      id = "name",
      labelText = "Name:",
      entry = p.name,
      disabled = true
    );
    @GemTextInput(
      inputType = "date",
      labelText = "Date of birth:",
      entry = p.birthday
    );
    @GemTextInput(
      inputType = "dropdown",
      labelText = "Hobby:",
      entry = p.aboutMe,
      options = [/*Option(""), Option("Tennis"), Option("Sleeping"), Option("Model-driven development")*/]
    );
  }
}
