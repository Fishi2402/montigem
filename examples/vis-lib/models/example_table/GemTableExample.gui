package example_table;

import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableHeaderCell;
import mc.fenix.table.GemTableRow;
import mc.fenix.table.GemTableRowCell;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import Domain.*;
import mc.fenix.arrange.GemColumn;

page GemTableExample(List<Person> persons) {
  @GemColumn(rowGap = "20px", width = "50%", components = [
    @GemTable(
      headers = [
        @GemTableHeader(cols = [
          @GemText(value = "Name"),
          @GemText(value = "Birthday")
        ])
      ],
      body = [@iterate(Person p : persons) {
        @GemTableRow(cols = [
          @GemText(value = p.name),
          @GemTextInput(
            inputType = "date",
            entry = p.birthday
          )
        ]);
      }]
    ),
    @GemTable(
      headers = [
        @GemTableHeader(cells = [
          @GemTableHeaderCell(rowSpan = 2, content = @GemText(value = "Name")),
          @GemTableHeaderCell(colSpan = 2, content = @GemText(value = "Adress"))
        ]),
        @GemTableHeader(cols = [
          @GemText(value = "Street"),
          @GemText(value = "House")
        ])
      ],
      body = [
        @GemTableRow(cells = [
          @GemTableRowCell(content = @GemText(value = "Emma")),
          @GemTableRowCell(content = @GemText(value = "Oak Str.")),
          @GemTableRowCell(content = @GemText(value = "29"))
        ]),
        @GemTableRow(cells = [
          @GemTableRowCell(content = @GemText(value = "Alice")),
          @GemTableRowCell(rowSpan = 2, content = @GemText(value = "Gitschiner Str.")),
          @GemTableRowCell(rowSpan = 2, content = @GemText(value = "9"))
        ]),
        @GemTableRow(cells = [
          @GemTableRowCell(content = @GemText(value = "Olivia"))
        ]),
        @GemTableRow(cells = [
          @GemTableRowCell(content = @GemText(value = "Isabella")),
          @GemTableRowCell(content = @GemText(value = "Pine")),
          @GemTableRowCell(content = @GemText(value = "Rd."))
        ])
      ]
    )
  ]);
}
