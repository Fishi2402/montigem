package mbdo;

import Domain.MbdoVacuumGripperState;
import mbdo.components.VacuumGripper;

import mc.fenix.arrange.GemColumn;
import mc.fenix.input.GemRangeInput;
import mc.fenix.input.GemCheckBoxInput;

page VacuumGripper_Demo(MbdoVacuumGripperState state){
  @GemColumn(
    rowGap = "15px",
    components = [
      @GemRangeInput(
        id="rotation-degree",
        labelText="Rotation: ",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=360,
        value=state.rotationDeg
      ),
      @GemRangeInput(
        id="vertical-percentage",
        labelText="Höhe:",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=100,
        value=state.verticalPercentage
      ),
      @GemRangeInput(
        id="hotizontal-percentage",
        labelText="Tiefe:",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=100,
        value=state.horizontalPercentage
      ),
      @GemCheckBoxInput(
        id="pump-running",
        labelText="Pumpe läuft",
        checked=state.pumpRunning
      )
    ]
  );

  @VacuumGripper(
    rotationDeg=state.rotationDeg,
    verticalPercentage=state.verticalPercentage,
    horizontalPercentage=state.horizontalPercentage,
    pumpRunning=state.pumpRunning
  );
}

