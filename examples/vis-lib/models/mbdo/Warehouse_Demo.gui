package mbdo;

import Domain.MbdoWarehouseState;
import mbdo.components.Warehouse;

import mc.fenix.arrange.GemColumn;
import mc.fenix.input.GemRangeInput;
import mc.fenix.input.GemCheckBoxInput;

page Warehouse_Demo(MbdoWarehouseState state){
  @GemColumn(
    rowGap = "15px",
    components = [
      @GemRangeInput(
        id="depth-percentage",
        labelText="Tiefe:",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=100,
        value=state.depthPercentage
      ),
      @GemRangeInput(
        id="vertical-percentage",
        labelText="Höhe:",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=100,
        value=state.verticalPercentage
      ),
      @GemRangeInput(
        id="hotizontal-percentage",
        labelText="Tiefe:",
        vertical=false,
        step=1,
        minValue=1,
        maxValue=100,
        value=state.horizontalPercentage
      ),
    ]
  );
  @Warehouse(
    depthPercentage=state.depthPercentage,
    verticalPercentage=state.verticalPercentage,
    horizontalPercentage=state.horizontalPercentage
  );
}

