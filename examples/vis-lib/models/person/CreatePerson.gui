package person;

import Domain.Person;
import Domain.Address;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemCheckBoxInput;

import person.Row;

page CreatePerson(Person person, Address address, boolean showEmployed = true, Event<Person> newPerson, Event<Person> cancel) {
  @Row(
    col1 = bday@GemTextInput(labelText = "Birthday", entry = person.birthday, inputType = "date"),
    col2 = name@GemTextInput(labelText = "Name", entry = person.name),
    col3 = @GemRow(hAlign = "space-between", vAlign = "bottom", components = [
      @guard(showEmployed) {
        @GemColumn(width = "33%", components = [
          employed@GemCheckBoxInput(
            labelText = "Employed",
            checked = person.employed
          )
        ]);
      },
      @GemColumn(width = "33%", components = [
        street@GemTextInput(labelText = "Street", entry = address.street)
      ]),
      @GemColumn(width = "33%", components = [
        house@GemTextInput(labelText = "House", entry = address.house, inputType = "number")
      ])
    ])
  );
  createButton@GemButton(label = "Create person", leftClick = create(person));
  @GemButton(label = "Cancel", leftClick = cancel);
}
