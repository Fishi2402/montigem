package person;

import Domain.Person;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;

import person.Row;
import person.HierarchicalList;
import person.CreatePerson;
import person.PieChart;

page Overview(List<Person> persons) {
  @GemColumn(rowGap = "10px", width = "50%", components = [
    @CreatePerson(cancel = alertUser()),
    @iterate(Person p : persons) {
      @Row(
        col1 = @GemText(value = p.birthday),
        col2 = @GemText(value = p.name),
        col3 = @GemText(value = p.address.street + " " + p.address.house)
      );
      @CreatePerson(person = Person(), cancel = alertUser());
      @HierarchicalList(list = [[Person()], persons, p.friends]);
    },
    @PieChart(persons = persons)
  ]);
}
