package gui;

import mc.fenix.charts.gemlinecharttypes.GemLineChartDataBuilder;
import mc.fenix.charts.gemlinecharttypes.GemLineChartEntry;
import umlp.jsweet.extension.annotation.Component;
import weather.Forecast;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import mc.fenix.charts.gemlinecharttypes.GemLineChartData;
import mc.fenix.charts.gemlinecharttypes.GemLineChartEntryBuilder;

@Component(
    styles = "["
        + "\":host { display: flex; flex-direction: column }\", "
        + "\":host .gemColumn8 { display: initial }\", "
        + "\":host .gemColumn9 { display: initial }\""
        + "]"
)
public class WeatherView extends WeatherViewTOP {
  @Override
  public GemLineChartData getChartData() {
    List<Forecast> forecasts = getForecasts();
    List<LocalDateTime> list = new ArrayList<>();
    for (Forecast f : forecasts) {
      LocalDateTime date = f.getDate();
      list.add(date);
    }
    list.sort((localDateTime, other) -> localDateTime.compareTo(other));

    List<String> xAxis = new ArrayList<>();
    for (LocalDateTime d : list) {
      String string = d.toString();
      xAxis.add(string);
    }

    Map<String, List<Double>> m = new HashMap<>();
    for (Forecast forecast : forecasts) {
      String label = "Coordinate: " + asHumanReadable(forecast.getLongitude()) + ", " + asHumanReadable(forecast.getLatitude());
      if (!m.containsKey(label)) {
        m.put(label, Collections.nCopies(xAxis.size(), null));
      }

      int index = xAxis.indexOf(forecast.getDate().toString());
      if (index >= 0) {
        if (m.get(label).get(index) == null) {
          m.get(label).set(index, forecast.getTemperature());
        } else {
          m.get(label).set(index, (m.get(label).get(index) + forecast.getTemperature()) / 2);
        }
      }
    }

    List<GemLineChartEntry> chartEntries = new ArrayList<>();
    for (String label : m.keySet()) {
      List<Double> data = m.get(label);
      chartEntries.add(new GemLineChartEntryBuilder()
          .label(label)
          .data(data).build().get());
    }

    GemLineChartData result = new GemLineChartDataBuilder()
        .entries(chartEntries)
        .labels(xAxis)
        .build().get();

    return result;
  }

  private long asHumanReadable(Double number) {
    return Math.round(number * 100) / 100;
  }
}
