/* (c) https://github.com/MontiCore/monticore */
classdiagram Weather {
  <<singleton>> class App {
    String appName = "MyFancyWeatherApp";
  }

  association currentCity [1] App -> (currentCity) City [0..1];
  association favoriteCities [1] App -> (favorite) City [*];

  class City {
    String name;
    double longitude;
    double latitude;
  }

  class DailyForecast {
    java.time.LocalDate date;
    /double minimumTemperature;
    /double maximumTemperature;
    /WeatherState weatherState;
    double getMinimumTemperature();
    double getMaximumTemperature();
  }

  class Timeseries {
    java.time.LocalDate start;
    java.time.LocalDate end;
    /double minimumTemperature;
    /double maximumTemperature;
    double getMinimumTemperature();
    double getMaximumTemperature();
  }

  // TODO re-add when single deried assocs are supported
  / association City -> (nextDays) Timeseries;
  / association [1] City -> (current) Forecast [0..1];
  / association City -> (nextHours) Forecast;
  association [1] City <-> DailyForecast [*];
  association [0..1] Timeseries -> (containedDays) DailyForecast [*];

  association [0..1] DailyForecast -> (dailyForecasts) Forecast [*];

  class Forecast {
    java.time.LocalDateTime date;

    Double longitude;
    Double latitude;

    Double temperature;
    Double windspeed;
    int realtiveHumidity;
    WeatherState weatherState;
  }

  enum WeatherState {
    CLOUDY,
    SUNNY,
    RAINY,
    STORM;
  }
}

