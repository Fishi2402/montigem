package gui;

import Weather.City;
import Weather.App;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

component AddToFavorite(App app, List<City> cities) {
  @GemRow(colGap = "5px", components = [
    add@GemButton(label = "+", leftClick = add2Favorite),
    search@GemTextInput(
      inputType = "dropdown",
      options = null,
      entry = null
    )
  ]);
}
