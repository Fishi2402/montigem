package gui;

import Weather.Forecast;

import gui.ForecastCreate;
import gui.GradientDemo;
import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

import charts.src.lib.gemlinechart.GemLineChart;
import charts.src.lib.gemgaugechart.GemGaugeChart;
import table.src.lib.gemtable.GemTable;
import table.src.lib.gemtable.TableTypes.TableColumn;

page WeatherView(List<Forecast> forecasts) {
  @GemRow(colGap = "5px", height = "initial", components = [
    @GemCard(
      title = "Forecast data list",
      component = @GemTable(
        rows = forecasts,
        columns = [
          TableColumn("_temperature", "Temperature"),
          TableColumn("_windspeed", "Wind speed"),
          TableColumn("_realtiveHumidity", "Humidity")
        ],
        edit = navigateToUpdatePage,
        update = log
      )
    ),
    @GemCard(
      title = "Forecast Temperature (Avg./day)",
      component = @GemColumn(width = "800px", rowGap = "20px", components = [
        chart@GemLineChart(data = null),
        @ForecastCreate()
      ])
    ),
    @GemCard(
      title = "Humidity and Wind speed (Avg.)",
      component = @GemColumn(
        rowGap = "100px",
        components = [
          @GemColumn(width = "400px", height = "300px", hAlign = "center", vAlign = "center", components = [
            humidity@GemGaugeChart(data = null, min = 0, max = 100, unit = "%", textValue = "Humidity")
          ]),
          @GemColumn(width = "400px", height = "300px", hAlign = "center", vAlign = "center", components = [
            windspeed@GemGaugeChart(data = null, min = 0, max = 40, unit = "m/s", textValue = "Wind speed")
          ])
        ]
      )
    ),
    @GradientDemo()
  ]);
}
