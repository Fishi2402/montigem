package gui;

import Weather.Forecast;

import gui.ForecastCreate;
import gui.multi_day_forecast.MultiDayForecast;
import gui.common.WeatherStateIcon;
import mc.fenix.basic.GemImage;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.charts.GemLineChart;
import mc.fenix.charts.GemGaugeChart;
import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

page WeatherView(List<Forecast> forecasts) {
  @GemRow(colGap = "5px", height = "initial", components = [
    @GemCard(
      title = "Forecast data list",
      component =
        forecastsTable@GemTable(
          headers = [@GemTableHeader(cols = [
            @GemText(value = ""),
            @GemText(value = "Date"),
            @GemText(value = "Temp.")
          ])],
          body = [@iterate(Forecast fc : forecasts) {
            @GemTableRow(cols = [
              @GemButton(label = "Edit", leftClick = navigateToUpdatePage(fc)),
              @GemText(value = fc.date),
              @GemText(value = fc.temperature)
            ]);
          }]
        )
    ),
    @GemCard(
      title = "Forecast Temperature (Avg./day)",
      component = @GemColumn(width = "800px", rowGap = "20px", components = [
        chart@GemLineChart(data = null),
        @ForecastCreate()
      ])
    ),
    @GemCard(
      title = "Humidity and Wind speed (Avg.)",
      component = @GemColumn(
        rowGap = "100px",
        components = [
          @GemColumn(width = "400px", height = "300px", hAlign = "center", vAlign = "center", components = [
            humidity@GemGaugeChart(data = null, min = 0, max = 100, unit = "%", textValue = "Humidity")
          ]),
          @GemColumn(width = "400px", height = "300px", hAlign = "center", vAlign = "center", components = [
            windspeed@GemGaugeChart(data = null, min = 0, max = 40, unit = "m/s", textValue = "Wind speed")
          ])
        ]
      )
    )
  ]);
}
