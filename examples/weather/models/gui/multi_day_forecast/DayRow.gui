package gui.multi_day_forecast;

import Weather.DailyForecast;

import arrange.GemCard;
import arrange.GemRow;
import arrange.GemColumn;
import basic.GemText;

import gui.common.WeatherStateIcon;
import gui.common.ShortFormDateRenderer;
import gui.atomic.range_with_gradient.RangeWithGradient;

component DayRow(
  DailyForecast day,
  double groupMinTemp,
  double groupMaxTemp
){
  @GemRow(
    components = [
      @GemRow(
        width="5rem",
        height="3rem",
        component = @ShortFormDateRenderer(day = day, replaceToday = true)
      ),
      @GemRow(
        width="3rem",
        height="3rem",
        component = @WeatherStateIcon(state = day.weatherState)
      ),
      @GemRow(
        width="4rem",
        height="3rem",
        component = @GemText(value = day.minimumTemperature)
      ),
      @GemRow(
        width="105px",
        height="10px",
        component = @RangeWithGradient(
          width="100px",
          height="5px",
          startPercentage=((day.minimumTemperature - groupMinTemp)/(groupMaxTemp - groupMinTemp)) * 100, // TODO: hardcoded
          endPercentage=((day.maximumTemperature - groupMinTemp)/(groupMaxTemp - groupMinTemp)) * 100,
          minColor="green",
          middleColor="yellow",
          maxColor="red",
          backgroundColor="darkgrey"
        )
      ),
      @GemRow(
        width="4rem",
        height="3rem",
        component = @GemText(value = day.maximumTemperature)
      )
    ]
  );
}
