package gui.multi_day_forecast;

import Weather.DailyForecast;
import Weather.Timeseries;

import arrange.src.lib.gemcard.GemCard;
import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;
import basic.src.lib.gemtext.GemText;

import gui.multi_day_forecast.DayRow;

// TODO: use this to replace MultiDayForecast
// TODO: override routing, since routing id is added for derived attributes!
// TODO: fix routing in generator, problematic since OOTypes don't have isDerived
page MultiDayForecastAlternative(Timeseries timeseries){
  @GemCard(
    title = "7-Day Forecast",
    component =
    @GemColumn(
      components = [
        @iterate(DailyForecast day : timeseries.containedDays){
          @DayRow(
            day = day,
            today = false, // TODO
            groupMinTemp = timeseries.getMinimumTemperature(),
            groupMaxTemp = timeseries.getMaximumTemperature()
          );
        }
      ]
    )
  );
}
