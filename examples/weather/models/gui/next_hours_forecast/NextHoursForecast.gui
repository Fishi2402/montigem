package gui.next_hours_forecast;

import Weather.Timeseries;
import Weather.Forecast;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import gui.common.WeatherStateIcon;
import gui.common.ShortFormDateTimeRenderer;

component NextHoursForecast(List<Forecast> forecasts){
  @GemCard(
    title = "Next 12 Hours Forecast",
    component =
      @GemRow(
        colGap = "5px",
        components = [
          @iterate(Forecast hourlyForecast : forecasts){
            @GemColumn(
             width="7rem",
             components = [
               @ShortFormDateTimeRenderer(forecast = hourlyForecast, replaceToday = false),
               @WeatherStateIcon(state = hourlyForecast.weatherState),
               @GemText(value = hourlyForecast.temperature)
             ]
            );
          }
        ]
      )
  );
}
