package gui.widgets;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemrow.GemRow;
import basic.src.lib.gemtext.GemText;
import basic.src.lib.gemimage.GemImage;

component WeatherWidget(String title, String icon, GUIViewElement component) {
  @GemColumn(height = "100%", rowGap = "15px", vAlign = "space-evenly", components = [
    @GemRow(height = "1.5em", hAlign = "left", vAlign = "space-evenly", colGap = "15px", components = [
      @GemImage(source = icon),
      @GemText(value = title)
    ]),
    component
    //@GemColumn(component = component)
  ]);

}
