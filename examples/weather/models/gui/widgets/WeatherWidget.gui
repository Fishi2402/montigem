package gui.widgets;

import arrange.GemColumn;
import arrange.GemRow;
import basic.GemText;
import basic.GemImage;
import arrange.GemCard;


component WeatherWidget(String widgetsTitle, String title, String icon, GUIViewElement component) {
  @GemCard(title = widgetsTitle, component =
    @GemColumn(height = "auto", rowGap = "15px", components = [
      @GemRow(height = "1.5em", hAlign = "left", colGap = "15px", components = [
        @GemImage(source = icon),
        @GemText(value = title)
      ]),
      component
    ])
  );

}
