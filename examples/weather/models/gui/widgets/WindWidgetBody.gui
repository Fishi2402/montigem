package gui.widgets;

import Weather.DailyForecast;
import Weather.Timeseries;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import gui.widgets.WeatherWidget;

component WindWidgetBody(Timeseries timeseries) {
  @GemColumn(components = [
    @GemImage(source = "assets/images/compass.gif", style = "width: 200px; height: 200px"),
    @GemText(value = "NA"),
    @GemText(value = "km/h")
  ]);
}
