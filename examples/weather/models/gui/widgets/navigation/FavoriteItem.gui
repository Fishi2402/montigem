package gui.widgets.navigation;

import Weather.City;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

component FavoriteItem(City fav) {
  @GemRow(hAlign = "space-between", components = [
    @GemColumn(vAlign = "space-between", components = [
      @GemText(value = fav.name),
      @GemText(value = fav.current.date),
      @GemText(value = fav.current.weatherState)
    ]),
    @GemColumn(vAlign = "space-between", components = [
      @GemRow(hAlign = "space-between", vAlign = "center", components = [
        @GemText(value = fav.current.temperature + "°C"),
        @GemButton(label = "x", leftClick = removeFavorite())
      ]),
      @GemRow(components = [
        @GemText(value = "H:" + fav.latitude + "°"),
        @GemText(value = "L:" + fav.longitude + "°")
      ])
    ])
  ]);
}
