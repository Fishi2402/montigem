package gui.widgets.navigation;

import Weather.App;

import arrange.src.lib.gemcolumn.GemColumn;
import arrange.src.lib.gemrow.GemRow;
import basic.src.lib.gemtext.GemText;
import gui.widgets.navigation.FavoriteItem;

component FavoriteList(App app) {
  @GemColumn(components = [
    @iterate(City favorite : app.favorite) {
      @FavoriteItem(fav = favorite);
    }
  ]);
}
