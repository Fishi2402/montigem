package monticore;

umlp University {

    abstract class Person {
        String name;
        String nationality;
    }

    class Student extends Person {
      int semester;
      List<Course> courses;
    }

    class Course {
      String name;
      Person professor;
      Course requirement;
      double grade;
    }

    composition Student -> Course [*];
}
