package stanley;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// hier werden die Datenklassen gefunden
import hardy.Flensburg;

// hier werden importierte GUI-Modelle gefunden
import umlp.gui.TextInput;
import umlp.gui.NumberInput;
import umlp.gui.Button;

/**
 * This example defines a
 * Form to fill out Person data
 * it has only simple default layout, which generates some
 * interesting pieces of code
 *
 * Situation is that the Person p exists already and
 * that its values can be changed
 */
page EditierePerson(Person p) {

  // show and edit the nickname
  :TextInput(value = p.nickname)

  // show and edit the age as number
  :NumberInput(value = p.age)

  // Button mit Text "Ok" und Aufruf der Speicherung der Änderungen
  // (und die Logik dafür ist generiert und verfügbar)
  :Button(text = "Ok", leftClick = submitAndNavigate(:EditierePersonCars(p))
  // todo: Wo steht, wie es danach weitergeht (welche Seite wird gezeigt?)
  // AGe: wir definieren Methoden die häufigst benutzte Aktionen darstellen

  // Button mit Text "Decrease", und einer handgeschriebenen Aktion,
  // auch wenn hier nur eine Signatur steht, wuerde ich gerne eine Expression schreiben 
  // in welchem Kontext wird die ausgewertet?
  // todo AGe: wenn ich da nur eine Signatur angeben kann, dann könnte ich gleich eine synthetische nehmen
  // zB. onLeftClickButtonDecrease() ... und braucht nicht noch einen extraNamen
  // AGe: manche Methoden brauchen Parameter, eine synthetische würde nicht immer gehen
  :Button(text = "Decrease", leftClick = decreaseAge(p))
}

