package hardy;

umlp Flensburg {

    class Car;

    class Human {
        int age;
    }

    class Person extends Human {
        String nickname;
    }

    class DriverLicense;

    association owns [1] Person -> Car [*];
    association driverLicense [1] Person -> DriverLicense [1];
    // association parent [*] Person <-> (child) Person [*];
}
