package hardy;

umlp Flensburg {

    class Car;

    class Human {
        int age;
    }

    class Person extends Human {
        String nickname;
    }

    class Address;

    association owns [1] Person -> Car [*];
    association mainResidence [1] Person -> Address [1];

    // todo (etwas spaeter: Assoziation *<-->* mit einbauen 
    // man beachte hier die intern gekapselte bidirektionale Verwaltung
    // association parent [*] Person <-> (child) Person [*];

}
