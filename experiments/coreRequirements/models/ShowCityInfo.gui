package stanley;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// hier werden die Datenklassen gefunden
import hardy.Flensburg;

// hier werden importierte GUI-Modelle gefunden
import umlp.gui.Table;
// hier werden importierte Typen der GUI-Komponenten gefunden
import umlp.gui.TableTypes.Row;

/**
 * This example defines a page with a table. Data in the table is read-only
 * and is not persisted in the database as is, it is calculated (derived) from
 * the persisted data (domain data structure).
 */
page ShowCityInfo(CityInfo ci) {
  // statistic about cities
  :Table(
    rows = List(
      Row("Number of cities", ci.numberOfCities),
      Row("Total number of cars", ci.totalNumberOfCars),
      Row("City with most cars", ci.cityWithMostCars),
      Row("Person with most cars", ci.personWithMostCars.nickname),
      Row("Average number of cars", ci.averageNumberOfCars)
    )
  )

  // list of cities
  :Text(value = "List of cities")
  iterate(cityName : ci.cities) {
    :Text(value = cityName)
  }
}
