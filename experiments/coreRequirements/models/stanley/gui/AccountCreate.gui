package stanley.gui;

import hardy.Flensburg.Account;

import basic.src.lib.gemtext.GemText;
import basic.src.lib.gembutton.GemButton;
import input.src.lib.gemtextinput.GemTextInput;
import table.src.lib.gemtable.GemTable;

page AccountCreate(/*Account acc*/) {
  @GemText(value = "New Account");
  @GemTextInput(entry = acc.name);
  @GemTable(rows = acc.budget);
  @GemButton(label = "Save");
}
