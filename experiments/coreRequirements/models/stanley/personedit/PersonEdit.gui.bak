package stanley.personedit;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// hier werden die Datenklassen gefunden //
import hardy.Flensburg.Person;

// every library GUI component has Gem prefix to avoid name clashing with HTML elements from native
// library and from other libraries
// hier werden importierte GUI-Modelle gefunden
import stanley.tmp.io.input.GemTextInput;
import stanley.tmp.io.input.GemNumberInput;
import stanley.tmp.io.GemButton;
import stanley.tmp.io.GemText;

import stanley.tmp.layout.GemCard;
import stanley.tmp.layout.GemColumn;

/**
 * This example defines a
 * Form to fill out Person data
 * it has only simple default layout, which generates some
 * interesting pieces of code
 *
 * Situation is that the Person p exists already and
 * that its values can be changed
 */
page PersonEdit(Person p) {

  @GemColumn(contents = [
    @guard(p.nickname != "") {
      @GemCard(
        title = "Edit Person",
        content = @GemColumn(contents = [
          // show and edit the nickname
          @GemTextInput(value = p.nickname),

          // show and edit the age as number
          @GemNumberInput(value = p.age),

          // Button mit Text "Decrease", und einer handgeschriebenen Aktion.
          // Eine Methode, die auf der Rechten Seite der Zuweisung steht, wird
          // in einem handgeschriebenen Teil implementiert und importiert
          // In diesem Fall ist die Implementierung der Methode "decreaseAge" in "PersonEditGUI.java".
          // Manche Methoden brauchen Parameter, eine synthetische Methode wuerde nicht immer reichen,
          // deswegen wird eine Methode explizit importiert und aufgerufen
          @GemButton(text = "Decrease", leftClick = decreaseAge),

          // Button mit Text "Ok" und Navigation auf eine andere Seite
          // (und die Logik dafür ist generiert und verfügbar)
          // Wir generieren Methoden, die häufigst benutzte Aktionen darstellen, sie können aber
          // ueberschrieben werden z.B. navigate, copy, ...
          @GemButton(text = "Ok", leftClick = navigate)
        ])
      );
    }
    else {
      @GemText(value = "Invalid name");
    }
  ]);

}

