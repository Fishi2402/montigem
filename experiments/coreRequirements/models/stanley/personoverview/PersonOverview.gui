import hardy.Flensburg.Human;

// import stanley.tmp.table.GemTable;
import basic.src.lib.gemtext.GemText;
import arrange.src.lib.gemcard.GemCard;
import table.src.lib.gemtable.GemTable;
// import stanley.my.InfoBox;
// import type from a CD to describe a table column

// import stanley.tmp.table.TableTypes.TableColumn;

/**
 * This example defines a
 * Table to show data of several Persons
 *
 * Assumption: several Persons ps exist, values are shown in a table
 */
page PersonOverview(List<Human> ps) {
  @iterate(Human p : ps) {
    @GemText(value = p.age);
  }
  @GemCard(
    component = t@GemTable(rows = ps)
  );
}
