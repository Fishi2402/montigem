package stanley.personoverview;

// HWC-P: eigentlich ein Modell, aber fuers Produkt

// siehe: EditierePerson.gui

import hardy.Flensburg;

import umlp.gui.Table;
// import type from a CD to describe a table column
import umlp.gui.TableTypes.TableColumn;

/**
 * This example defines a
 * Table to show data of several Persons
 *
 * Assumption: several Persons ps exist, values are shown in a table
 */
page PersonOverview(List<Person> ps) {

  // Table of objects
  @Table(
    // rows show a list of objects (persons)
    rows = ps,
    // 2 columns: 1st shows age of a person, 2nd - nickname attribute value
    cols = List(
      TableColumn("age"),
      TableColumn("nickname")
    )
  )

}

