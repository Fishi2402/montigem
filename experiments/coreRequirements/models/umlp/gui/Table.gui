package umlp.gui;

import umlp.gui.TableTypes.TableColumn;

/** Table component interface definition. Uses built-in Object type, as the type
    of rows is not preset
*/
component Table(
  List<Object> rows,
  boolean canDelete = false,
  boolean canEdit = false,
  boolean canAdd = false,
  GUIViewElement contextMenu,
  List<TableColumn> columns
)
