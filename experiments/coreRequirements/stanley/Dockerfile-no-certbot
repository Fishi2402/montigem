FROM httpd:2.4-alpine
MAINTAINER "Software Engineering, RWTH Aachen University"

HEALTHCHECK --interval=10s --timeout=5s --retries=20 CMD wget localhost:8080 -q -O - > /dev/null 2>&1

## Apache Configuration (e.g. Proxy to backend & SSL-Certificates)
COPY httpd.conf /usr/local/apache2/conf/httpd.conf
COPY httpd-umlp.conf /usr/local/apache2/conf/httpd-umlp.conf
COPY httpd-virthost-80.conf /usr/local/apache2/conf/httpd-virthost-80.conf

# Virtual host for port 80
RUN echo "Include conf/httpd-virthost-80.conf" >> /usr/local/apache2/conf/httpd.conf

# Can be used for VirtualHost on Port 443
# "conf/ssl" is mounted as docker volume
RUN echo "IncludeOptional conf/ssl/httpd-ssl.conf" >> /usr/local/apache2/conf/httpd.conf


# Test that the configuration is valid
RUN apachectl configtest -d /usr/local/apache2


## created from `npm run build`
COPY dist/stanley /var/www/html

EXPOSE 80 443
