
  
<gem-column
    [design] = "getGemColumnComp1Design()"
    [height] = "getGemColumnComp1Height()"
    [contents] = "[
    Comp1Tpl4,
    Comp1Tpl0,
    ]"
>
</gem-column>

<ng-template #Comp1Tpl4>
  
<gem-row
    [design] = "getGemRowComp2Design()"
    [contents] = "[
    Comp2Tpl3,
    ]"
>
</gem-row>

<ng-template #Comp2Tpl3>
  
<gem-text
    [value] = "getGemTextComp3Value()"
>
</gem-text>


</ng-template>

</ng-template>
<ng-template #Comp1Tpl0>
  
<gem-column
    [design] = "getGemColumnComp4Design()"
    [contents] = "getGemColumnComp4Contents()"
>
</gem-column>


</ng-template>

