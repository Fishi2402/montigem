        enclosingScope = @TagSchema!Scope;
        type = Reference;
        additionalAttributes = [// *size: 2
          @referenceType!AdditionalAttribute(64,4):ASTAdditionalAttribute {
            symbol = @referenceType!Symbol(64,4);
            enclosingScope = @TagSchema!Scope;
            name = "referenceType";
            mCType = @int!MCPrimitiveType(64,19):ASTMCPrimitiveType {
              enclosingScope = @TagSchema!Scope;
              primitive = 6;
            };
          },
          @referencedTag!AdditionalAttribute(65,4):ASTAdditionalAttribute {
            symbol = @referencedTag!Symbol(65,4);
            enclosingScope = @TagSchema!Scope;
            name = "referencedTag";
            mCType = @Optional<String>!MCOptionalType(65,19):ASTMCOptionalType {
              enclosingScope = @TagSchema!Scope;
              mCTypeArgument = @!MCBasicTypeArgument(65,28):ASTMCBasicTypeArgument {
                enclosingScope = @TagSchema!Scope;
                mCQualifiedType = @String!MCQualifiedType(65,28):ASTMCQualifiedType {
                  enclosingScope = @TagSchema!Scope;
                  mCQualifiedName = @String!MCQualifiedName(65,28):ASTMCQualifiedName {
                    enclosingScope = @TagSchema!Scope;
                    parts = [String];
                  };
                };
              };
            };
          }];
      }];
    component = true;
};}

