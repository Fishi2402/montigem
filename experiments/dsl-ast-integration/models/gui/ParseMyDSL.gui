
package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;


page ParseMyDSL(boolean disableLink = true, boolean disableInput = false, boolean disableParse = false, String msg = "...", List<String> errors,
String parseInput = "package de.mc.test;\npublic unit MyName {\n initial state A; \n state B;\n transition A -> B; \n\n expression 42; // Finally, an expression \n}") {
  @GemTextareaInput(
      labelText = "Textual representation of MyCompilationUnit",
      keyPress = changeInput(),
      disabled = disableInput,
      entry = parseInput,
      height = "50vh"
  );

  @GemButton(label = "Parse Input", leftClick = parse(), disabled = disableParse);

  message@GemText(value = msg);
  @iterate(String emsg : errors) {
    @GemText(value = emsg, color="red");
  }

  @GemButton(label = "View AST", leftClick = viewAST(), disabled = disableLink);

}
