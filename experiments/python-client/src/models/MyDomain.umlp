// CD2Pojo only supports "classdiagram", not "umlp"
<<pygem>>
classdiagram MyDomain { //b

  class A {
    String myStr = "hello";
    java.util.Optional<String> strOpt;
    B directB;
    int i = 42;
    double d = 42.42;
    // boolean bool = false; // TODO -> report error
    boolean myBool = true;
  }

  class B {}
  association A -> B;

  class TestAssoc_1_A {}
  class TestAssoc_1_B {}
  association TestAssoc_1_A -> TestAssoc_1_B;
  association TestAssoc_1_A -> (singleB) TestAssoc_1_B;
  association TestAssoc_1_A -> (optB) TestAssoc_1_B [0..1];
  association TestAssoc_1_A -> (listB) TestAssoc_1_B [*];

  class TestAssoc_2_A {}
  class TestAssoc_2_B {}
  association TestAssoc_2_A               <-> TestAssoc_2_B;
  association TestAssoc_2_A (singleA)     <-> (singleB) TestAssoc_2_B;
  association [0..1] TestAssoc_2_A (optA) <-> (optB) TestAssoc_2_B [0..1];
  association [*] TestAssoc_2_A (listA)   <-> (listB) TestAssoc_2_B [*];



  <<singleton>>
  class SingletonManager {
    void voidCommand();
    void voidCommand2(A a);
    void voidCommand3(A a, int i);

    B createB();
  }
}
