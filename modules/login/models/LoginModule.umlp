//<<module>>
umlp LoginModule {



    <<requiresImplementation>> // Require an implementing class in the final model using this

    // TODO: Move requiresImplementation to extends

    class LoginModuleUser {
      <<dbColumn = "unique=true">>
      String username;
      String password;
      java.time.LocalDateTime registrationDate;
      <<dbColumn = "unique=true">>
      String email;

      String validityUsername();
      String validityEmail();
      String validityPassword();
    }

     // Singleton-Type used instead of stereotypes/annotations
    <<singleton>>
    class DoesNotRequireLogin {}

    <<singleton>>
    class LoginSecManager {
        <<command>>
        long getCurrentUserRequest();

        // Config Options:

        // allow password reset
        boolean allowPasswordReset = false;
        // allow public user sign-up/creation
        boolean allowPublicSignUp = false;
    }

    association LoginSecManager -> (signedInUser) LoginModuleUser [0..1];

}
