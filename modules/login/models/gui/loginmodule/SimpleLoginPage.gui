package loginmodule;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

// TODO: Deprecated?
page SimpleLoginPage(String username, String password) {
  @GemRow(
    components = [
      @GemText(value = "Name"),
      @GemTextInput(entry = username),
      @GemText(value = "Password"),
      @GemTextInput(entry = password) // TODO: hide password
    ]
  );
}
