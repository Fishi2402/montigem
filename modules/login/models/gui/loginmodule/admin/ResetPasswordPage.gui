package gui.loginmodule.admin;

import LoginModule.LoginModuleUser;

import gui.loginmodule.comp.ResetPassword;
import gui.loginmodule.comp.LoginContainer;

// Reset the password of a given user
page ResetPasswordPage(List<LoginModuleUser> users){
  @LoginContainer(component = @ResetPassword(users=users));
}
