package gui.loginmodule.comp;

import LoginModule.LoginModuleUser;


import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

import mc.fenix.input.GemTextInputTypes.GemTextInputValidity;

// Note: User.builder will fail due to GemId missing -_-
component ForgotPassword(String email, GemTextInputValidity validity, String errorMessage) {
  @GemCard(title = "Request a password reset", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(
        labelText = "E-mail address",
        inputType = "text",
        entry = email,
        validity = validity
      ),
      @GemRow(hAlign = "center", colGap = "10px", components = [
        @GemButton(label = "Cancel", leftClick = navigateBack()),
        @GemButton(label = "Request password reset", leftClick = requestPasswordReset())
      ]),
      error@GemText(value = errorMessage)
    ])
  );
}
