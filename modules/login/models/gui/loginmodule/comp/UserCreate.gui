package gui.loginmodule.comp;

import LoginModule.LoginModuleUser;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

component UserCreate(List<LoginModuleUser> users, LoginModuleUser newUser) {
  @GemCard(title = "Create account and use it to sign in", component =
    @GemColumn(rowGap = "20px", components = [
      @GemTextInput(
        labelText = "Account",
        inputType = "text",
        entry = newUser.username,
        validity = newUser.validityUsername
      ),
      @GemTextInput(labelText = "Password", inputType = "password", entry = newUser.password),
      @GemTextInput(
        labelText = "E-mail address",
        inputType = "text",
        entry = newUser.email,
        validity = newUser.validityEmail
      ),
      @GemRow(hAlign = "center", colGap = "10px", components = [
        @GemButton(label = "Cancel", leftClick = navigateBack()),
        @GemButton(label = "Create account", leftClick = createUser())
      ]),
      error@GemText(value = "")
    ])
  );
}
