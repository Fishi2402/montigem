import java.time.LocalDateTime;

classdiagram AutoTechAgil {

  public class Status {
    int statusId;
    String imageSource;
    String label;
    double threshold;
    Status(int statusId, double threshold, String imageSource);
    Status(int statusId, double threshold, String imageSource, String label);
  }

  /*----------------------------------------------------------------------------------------------*
    Function Structure Model
   *----------------------------------------------------------------------------------------------*/

  class Service {
    String name;
    //boolean isActive;
    //QualityStatus systemSelfAssessment;
    ///QualityStatus serviceSelfAssessment;
  }

  class Port {
    String name;
  }

  // TODO: Outgoing relations von Port nach Channel durch Port nach FunctionStream ersetzen

  association [0..1] Service (ownerIn) -> (in) Port [*];
  association [0..1] Service (ownerOut) -> (out) Port [*];

  //association [*] Port <-> Channel [1];

  association [*] Port -> Category [1];
  composition [0..1] Service (owner) <-> (subFunction) Service [*];

  class FunctionStream;

  //association [*] FunctionStream -> Category [1];
  association [0..1] Port <-> FunctionStream [0..1];
  composition [0..1] Service -> (state) FunctionStream [0..1];

  class Category {
    Optional<Boolean> continuous; // a false value stands for a discrete category
    -> Kind [0..1];
    -> Type [1];
  }

  class Kind {
    Optional<String> specifier;
  }

  class Energy extends Kind;
  class Material extends Kind;
  class Data extends Kind;

  class Type {
    String mctype;
  }

  class Observation {
    LocalDateTime start;
    LocalDateTime end;
  }

  association [*] Observation <-> FunctionStream [1];
  association [*] Observation -> Category [1];

  class Value;

  association [0..1] FunctionStream -> Value [*] {ordered};
  association [*] Observation -> Value [*] {ordered};

  // TODO: Eigene Value-Klassen definieren
  class SteeringValue extends Value {
    LocalDateTime timestamp;  // TODO: gemId soll timestamp werden, danach hier entfernen
    SteeringData data;
    SteeringQuality quality;
  }

  class SteeringData {
    float angle;
  }

  class SteeringQuality {
    QualityStatus status;
    float latency;
    float refreshRate;
  }

  enum QualityStatus {
    RED, YELLOW, GREEN;
  }

}
