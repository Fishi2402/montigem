import java.time.LocalDateTime;

classdiagram AutoTechAgil {
  enum ServiceStatus {
    GREEN, YELLOW, RED;
  }

  public class Status {
    int statusId;
    String imageSource;
    String label;
    double threshold;
    Status(int statusId, double threshold, String imageSource);
    Status(int statusId, double threshold, String imageSource, String label);
  }

  /*----------------------------------------------------------------------------------------------*
    Function Structure Model
   *----------------------------------------------------------------------------------------------*/

  class Service {
    String name;
  }

  class Channel;

  /**
   Since Fenix currently does not support qualified associations, we emulate them using the `Port`
   class:
   For each qualifier from `Function` to a Channel in the original model, here the `Function`
   contains an instance of port, which contains the relevant name qualifing the channel from the
   function.

   We adapted `Function` with the handwritten methods `String getInChannel(String name)` and
   `String getOutChannel(String name)`, such that it can be used as if the associations are
   qualified.
  */
  class Port {
    String name;
  }

  // TODO: Outgoing relations von Port nach Channel durch Port nach FunctionStream ersetzen

  class Value;

  // TODO: Eigene Value-Klassen definieren
  class ServiceValue extends Value {
    LocalDateTime timestamp;  // TODO: gemId soll timestamp werden, danach hier entfernen
    ServiceData data;
    ServiceQuality quality;
  }

  class ServiceData {
    double speed;
  }

  class ServiceQuality {
    QualityStatus status;
    double latency;
    double refreshRate;
  }

  class CameraQuality extends ServiceQuality {
    double contrast;
  }

  enum QualityStatus {
    RED, YELLOW, GREEN;
  }

  association [0..1] Service (ownerIn) -> (in) Port [*];
  association [0..1] Service (ownerOut) -> (out) Port [*];
}
