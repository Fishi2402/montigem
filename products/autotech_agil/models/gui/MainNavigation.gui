package gui;

import mc.fenix.arrange.GemRow;

import mc.fenix.navigation.GemNavItem;
import mc.fenix.navigation.GemNavList;

component MainNavigation () {
  @GemNavList(components = [
    @GemRow(components = [
      @GemNavItem(title = "Start", target = "/gui/Start"),
      @GemNavItem(title = "Overview", target = "/gui/ServiceOverview/0"),
      @GemNavItem(title = "Orchestrator", target = "/gui/Orchestrator")
    ])
  ]);
}
