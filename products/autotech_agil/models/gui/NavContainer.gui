package gui;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemGrid;

import gui.MainNavigation;

component NavContainer(List<GUIViewElement> content) {
  @GemColumn(
    components = [
      @MainNavigation(),
      @GemRow(components = content)
    ]
  );
}
