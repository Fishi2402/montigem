package gui;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.navigation.GemNavItem;

component Navigation () {
  @GemColumn(height = "auto", components = [
    @GemRow(height = "auto", components = [
      @GemNavItem(title = "Start", target = "/gui/Start")
    ]),
    @GemRow(height = "auto", components = [
      @GemNavItem(title = "Overview", target = "/gui/ServiceOverview")
    ])
  ]);
}
