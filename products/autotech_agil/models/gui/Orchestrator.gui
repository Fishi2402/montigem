package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemIcon;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemTreeNode;

import AutoTechAgil.Service;
import AutoTechAgil.Port;
import mc.fenix.arrange.GemCard;

page Orchestrator (List<Service> services) {
  @NavContainer(content = [
    @GemRow(
      wrap = "wrap",
      colGap = "10px",
      rowGap = "10px",
      components = [
      @iterate(Service s : services) {
        @GemCard(
          width = "200px",
          title = s.name,
          component = @GemColumn(
            rowGap = "5px",
            components = [
              @GemText(value = "Requirements:"),
              @iterate(Port pIn : s.in) {
                @GemButton(
                  content = [
                    @GemRow(
                      colGap = "2px",
                      vAlign = "center",
                      hAlign = "space-between",
                      components = [
                        @GemText(value = pIn.name),
                        @GemIcon(name = "arrow_forward")
                      ]
                    )
                  ]
                );
              },
              @GemText(value = "Guarantee:"),
              @iterate(Port pOut : s.out) {
                @GemButton(
                  content = [
                    @GemRow(
                      colGap = "2px",
                      vAlign = "center",
                      hAlign = "space-between",
                      components = [
                        @GemText(value = pOut.name),
                        @GemIcon(name = "arrow_forward")
                      ]
                    )
                  ]
                );
              }
            ]
          )
        );
      }
    ])
  ]);
}
