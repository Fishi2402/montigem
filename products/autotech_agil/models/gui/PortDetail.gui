package gui;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.components.StatusIndicator;

import AutoTechAgil.Port;
import AutoTechAgil.Status;
import mc.fenix.arrange.GemCard;

component PortDetail(Port port) {
  @guard(port != null) {
    @GemCard(
      title = port.name,
      component = @GemColumn(rowGap = "20px", components = [
        @GemRow(colGap = "10px", height = "auto", vAlign = "center", components = [
          @GemText(value = "from"),
          @GemTextInput(inputType = "date"),
          @GemTextInput(inputType = "time"),
          @GemText(value = "to"),
          @GemTextInput(inputType = "date"),
          @GemTextInput(inputType = "time")
        ])
      ])
    );
  }
  /*@GemRow(colGap = "50px", components = [
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        possibleStatuses = getPossibleStatuses(),
        statusId = port.status
      ),
      @GemDropdownInput(
        entry = port.status,
        options = getStatusOptions()
      )
    ]),
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        width = "100px",
        possibleStatuses = getPossibleStatuses(),
        statusTriggerValue = service.temperature
      ),
      @GemTextInput(
        inputType = "number",
        entry = service.temperature
      )
    ]),
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        width = "100px",
        currentStatus = changeStatus(service.temperature)
      ),
      @GemTextInput(
        inputType = "number",
        entry = service.temperature
      )
    ])
  ]);*/

}
