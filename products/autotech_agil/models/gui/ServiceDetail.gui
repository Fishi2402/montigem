package gui;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.components.StatusIndicator;

import AutoTechAgil.Service;
import AutoTechAgil.Status;

page ServiceDetail(Service service) {
  @GemText(value = service.name);
  @GemRow(colGap = "50px", components = [
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        width = "100px",
        possibleStates = getPossibleStates(),
        statusId = service.status
      ),
      @GemDropdownInput(
        entry = service.status,
        options = getStatusOptions()
      )
    ]),
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        width = "100px",
        possibleStates = getPossibleStates(),
        statusValue = service.temperature
      ),
      @GemTextInput(
        inputType = "number",
        entry = service.temperature
      )
    ]),
    @GemColumn(rowGap = "20px", hAlign = "center", components = [
      @StatusIndicator(
        width = "100px",
        currentStatus = changeStatus(service.temperature)
      ),
      @GemTextInput(
        inputType = "number",
        entry = service.temperature
      )
    ])
  ]);
}
