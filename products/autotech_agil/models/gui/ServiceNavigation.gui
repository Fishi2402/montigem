package gui;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemTreeNode;

import AutoTechAgil.Service;
import AutoTechAgil.Port;

component ServiceNavigation (List<Service> services) {
  @GemTreeNode(children = [
    @iterate(Service s : services) {
      @GemTreeNode(
        content = @GemText(value = s.name),
        children = [
          @GemTreeNode(
            content = @GemText(value = "In"),
            children = [
              @iterate(Port pIn : s.in) {
                @GemTreeNode(
                  content = @GemText(value = pIn.name),
                  onClick = goToPortDetails(pIn)
                );
              }
            ]
          ),
          @GemTreeNode(
            content = @GemText(value = "Out"),
            children = [
              @iterate(Port pOut : s.out) {
                @GemTreeNode(
                  content = @GemText(value = pOut.name),
                  onClick = goToPortDetails(pOut)
                );
              }
            ]
          )
        ]
      );
    }
  ]);
}
