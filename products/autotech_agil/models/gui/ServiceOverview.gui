package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemTreeNode;

import AutoTechAgil.Service;
import AutoTechAgil.Port;

page ServiceOverview (List<Service> services, Port selectedPort) {
  @NavContainer(content = [
    @GemRow(components = [
      @GemTreeNode(children = [
        @iterate(Service s : services) {
          @GemTreeNode(
            content = @GemText(value = s.name),
            children = [
              @GemTreeNode(
                content = @GemText(value = "Requirements"),
                children = [
                  @iterate(Port pIn : s.in) {
                    @GemTreeNode(
                      content = @GemText(value = pIn.name),
                      onClick = selectPort(pIn)
                    );
                  }
                ]
              ),
              @GemTreeNode(
                content = @GemText(value = "Guarantee"),
                children = [
                  @iterate(Port pOut : s.out) {
                    @GemTreeNode(
                      content = @GemText(value = pOut.name),
                      onClick = selectPort(pOut)
                    );
                  }
                ]
              )
            ]
          );
        }
      ]),
      @PortDetail(port = selectedPort)
    ])
  ]);
}
