package gui.components;

import AutoTechAgil.Status;

/**
  A status indicator that provides visual representation of different states
*/
component StatusIndicator(
  String width = "100%",
  String height = "100%",
  /**
    Possible states the indicator can take
  */
  List<Status> possibleStates,
  /**
    Current status that is displayed
  */
  Status currentStatus,
  /**
    Callback that is executed when the status changes.
    Emits the ne status.
  */
  Event<Status> onStatusChange,
  /**
    Value that is used to determine if a certain threshold is reached that leads to a status change
  */
  double statusValue,
  /**
    Id that is used to determine if a certain status with the same id is selected
  */
  int statusId
)
