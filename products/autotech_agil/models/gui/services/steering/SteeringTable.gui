package gui.services.steering;

import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableHeaderCell;
import mc.fenix.table.GemTableRow;
import mc.fenix.arrange.GemRow;

import gui.components.StatusIndicator;

import AutoTechAgil.SteeringValue;

component SteeringTable(List<SteeringValue> values) {
  @GemTable(
    layout = "fixed",
    headers = [
      @GemTableHeader(cells = [
        @GemTableHeaderCell(content = @GemText(value = "Timestamp")),
        @GemTableHeaderCell(content = @GemText(value = "Angle (°)")),
        @GemTableHeaderCell(content = @GemText(value = "Latency (ms)")),
        @GemTableHeaderCell(content = @GemText(value = "Refresh Rate (Hz)")),
        @GemTableHeaderCell(content = @GemText(value = "Status"))
      ])
    ],
    body = [
      @iterate(SteeringValue v : values) {
        @GemTableRow(cols = [
          @GemText(value = setDateTimeFormat(v.timestamp)),
          @GemText(value = v.data.angle),
          @GemText(value = v.quality.latency),
          @GemText(value = v.quality.refreshRate),
          @GemRow(hAlign = "center", components = [
            @StatusIndicator(
              width = "20px",
              statusId = v.quality.status
            )
          ])
        ]);
      }
    ]
  );
}

