package gui;

import DemoRec.Process;

import arrange.GemRow;
import arrange.GemColumn;
import arrange.GemCard;
import basic.GemText;
import basic.GemLink;

import gui.pack.BatteryPackOverview;
import gui.navigation.Navigation;

page Start(List<Process> allProcesses) {
  @Navigation();
  @GemCard(
    title="All Process",
    component=
      @GemColumn(
       components = [
         @iterate(Process p : allProcesses) {
           @GemRow(
             colGap="5px",

             components= [
               @GemLink(url="gui/process/ProcessOverview/", text="More detailed information."),
               @GemText(value="Process started on: "+p.startedAt),
               @BatteryPackOverview(pack=p.deconstructionOf)
             ]
           );
         }
       ]
     )
  );
}
