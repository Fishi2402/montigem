package gui.pack;

import DemoRec.BatteryPack;

import arrange.GemRow;
import basic.GemText;

import gui.pack.PackTypeOverview;
import gui.pack.PhotoDisplay;

component BatteryPackOverview(BatteryPack pack) {
  @GemRow(
    colGap="5px",
    components = [
       @GemText(value="State of Charge: "+pack.stateOfCharge),
       @GemText(value="State of Health: "+pack.health),
       @PhotoDisplay(pack=pack),
       @PackTypeOverview(type=pack.type)
  ]);
}
