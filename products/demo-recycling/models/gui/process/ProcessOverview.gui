package gui.process;

import DemoRec.Process;
import DemoRec.ProcessStep;

import arrange.GemRow;
import arrange.GemCard;
import arrange.GemColumn;
import basic.GemText;
import basic.GemLink;

import gui.navigation.Navigation;
import gui.step.ProcessStepCreate;


page ProcessOverview(Process p) {
  @Navigation();
  @GemCard(
    title="Process Steps",
    component=@GemColumn(
      components = [
        @ProcessStepCreate(),
        @iterate(ProcessStep step : p.consistsOf) {
          @GemRow(colGap="5px",
            components=[
              @GemText(value=step.type),
              @GemText(value=" took "),
              @GemText(value=step.timeconsumption+ "seconds"),
              /*@guard(true) { // ensure that step.description is not null
                @GemText(value=step.description);
              },*/
              editStep@GemLink(url="gui/process/ProcessStepCreate/", text="Edit Step")
            ]
          );
        }
      ]
    )
  );

}
