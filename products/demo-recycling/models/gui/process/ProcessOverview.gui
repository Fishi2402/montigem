package gui.process;

import DemoRec.Process;
import DemoRec.ProcessStep;

import arrange.GemRow;
import arrange.GemColumn;
import basic.GemText;


page ProcessOverview(Process p) {
  @GemColumn(
    components = [
      @iterate(ProcessStep step : p.consistsOf) {
        @GemRow(colGap="5px",
          components=[
            @GemText(value=step.type),
            @GemText(value=" took "),
            @GemText(value=step.timeconsumption),
            @GemText(value=step.description)
          ]
        );
      }
    ]
  );
}
