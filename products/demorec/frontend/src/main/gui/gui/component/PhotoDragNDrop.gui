package gui.component;

import DemoRec.Photo;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;

component PhotoDragNDrop(Event<Photo> createPhoto, String attachedComponent) {
  @GemRow(components= [
    upload@GemButton(label = "Upload Files", leftClick = uploadAllFiles()),
    cancel@GemButton(label = "Cancel Upload", leftClick = cancelUpload())
  ]);
}
