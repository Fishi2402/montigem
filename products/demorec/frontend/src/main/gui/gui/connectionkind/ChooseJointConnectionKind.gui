package gui.connectionkind;

import DemoRec.JointConnectionKind;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.arrange.GemColumn;

import gui.connectionkind.JointConnectionKindCreate;

page ChooseJointConnectionKind(JointConnectionKind currentKind, Event<JointConnectionKind> chosenKind) {

  @GemColumn(
    rowGap="5px",
    components=[
      selectJointConnectionKind@GemDropdownInput(
          labelText = "JointConnection Kind",
          options = null,
          entry = null,
          width="var(--largeDropDownWidth)"
        ),
        createJointConnectionKind@guard(true) {
          @JointConnectionKindCreate(createJointConnectionKind=addNewJointConnectionKind());
        }
    ]
  );

}
