package gui.connectionkind;

import DemoRec.JointConnectionKind;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentCreate;
import gui.connectionkind.JointConnectionKindEdit;

component JointConnectionKindCreate(JointConnectionKind connectionKind, Event<JointConnectionKind> createJointConnectionKind) {
  @GemCard(
    title = "Specify Connection",
    component = @GemColumn(
      rowGap="5px",
      components = [
        @JointConnectionKindEdit(connectionKind=connectionKind, showOptionalAttributes=false),
        buildConnection@GemButton(label = "Save ConnectionKind", leftClick = createNewConnectionKind(), disabled=isDisabled(connectionKind), width="var(--smallDropDownWidth)")
      ]
    )
  );
}
