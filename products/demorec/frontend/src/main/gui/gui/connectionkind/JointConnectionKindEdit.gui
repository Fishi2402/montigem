package gui.connectionkind;

import DemoRec.JointConnectionKind;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemAutocompleteInput;

import gui.component.ComponentCreate;
import gui.pack.ComponentsOfPack;
import gui.staticcontainer.NavContainer;

component JointConnectionKindEdit(List<DemoRecComponent> components, JointConnectionKind connectionKind,
    boolean showOptionalAttributes=true,
    boolean newCompGuard = false, String componentEntry) {

  @GemColumn(
    wrap="nowrap",
    rowGap="5px",
    components=[
      selectTypeOfConnection@GemDropdownInput(
        labelText = "Type of Connection",
        options = null,
        entry = connectionKind.jointConnectionType,
        validity = checkConnectionType(),
        width="var(--smallDropDownWidth)"),

      selectConnectsComponent@GemAutocompleteInput(
        labelText = "Components connected by this connection",
        options = getComponentOptions(components),
        entry = componentEntry,
        keyPress = tryToAddComponent(),
        validity = checkChosenComponents(),
        width="var(--largeDropDownWidth)"),

      @GemRow(
        wrap="nowrap",
        colGap="5px",
        components = [
          @iterate(DemoRecComponent component : connectionKind.connects){
            removeComponent@GemButton(label=component.name, leftClick=removeSelectedComponent(component), disabled=false);
          }
        ]
      ),

      @GemColumn(
        components = [
          @iterate(DemoRecComponent comp : connectionKind.connects) {
            @iterate(Photo photo : comp.photo) {
              @GemText(value=photo.url);
            }
          }
        ]
      ),

      @guard(newCompGuard) {
        createComponentDialog@GemColumn(
          components=[
            @ComponentCreate(createComponent=addNewComponent())
          ]
        );
      }
    ]
  );
}
