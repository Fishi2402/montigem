package gui.connectionkind;

import DemoRec.JointConnectionKind;
import DemoRec.JointConnection;
import DemoRec.DemoRecComponent;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import gui.pack.ComponentsOfPack;
import gui.staticcontainer.NavContainer;
import gui.connectionkind.JointConnectionKindEdit;
import gui.jointconnection.JointConnectionEdit;
import gui.imagescroller.ImageScroller;
import gui.pospicker.PositionPicker;

page JointConnectionKindEditPage(JointConnectionKind connectionKind,
    String selectedImageUrl = "",
    String selectedConnectionId = "",
    boolean showPositionPicker = false,
    boolean showConnectionConditions = true,
    boolean showConnectionPositions = true,
    boolean showConnectionPhotos = true) {
  @NavContainer(
    content=[
      @GemColumn(
        rowGap="5px",
        components=[

          @JointConnectionKindEdit(connectionKind=connectionKind, showOptionalAttributes=true),

          // ── Position Picker toggle + sticky panel ─────────────────
          @GemColumn(
            components=[
              posPickerToggle@GemButton(label=posPickerToggleLabel(), leftClick=togglePositionPicker()),
              @guard(showPositionPicker) {
                @GemButton(label="Iterate All Connections", leftClick=startBatch());
              }
            ]
          ),
          @guard(showPositionPicker) {
            @GemColumn(
              rowGap="8px",
              components=[
                @ImageScroller(imagesApiUrl="/scans", imageSelected=onImageSelected())
              ]
            );
            @iterate(JointConnection connection : connectionKind.jointConnection) {
              stickyPosPicker@GemRow(
                components=[
                  @guard(isSelected(connection)) {
                    @PositionPicker(
                      imageUrl=selectedImageUrl,
                      x=connection.xPos,
                      y=connection.yPos,
                      z=connection.zPos,
                      pickedPosition=onPositionPicked(connection)
                    );
                  }
                ]
              );
            }
          },

          // ── Connections list ──────────────────────────────────────
          @GemCard(
            title="Connections",
            component=@GemColumn(
              rowGap="5px",
              components=[
                @GemRow(
                  components=[
                    @GemText(value=getConnectionsSize(connectionKind)),
                    addConnectionBtn@GemButton(label="+ Add Connection", leftClick=createConnection())
                  ]
                ),
                @GemRow(
                  components=[
                    @GemButton(label="Show Conditions", leftClick=toggleShowConditions()),
                    @GemButton(label="Show Positions", leftClick=toggleShowPositions()),
                    @GemButton(label="Show Photos", leftClick=toggleShowPhotos())
                  ]
                ),
                @iterate(JointConnection connection : connectionKind.jointConnection) {
                  @guard(isSelected(connection)) {
                    selectedConnectionRow@GemRow(
                      colGap="5px",
                      components=[
                        @JointConnectionEdit(connection = connection,
                          showCondition=showConnectionConditions,
                          showPosition=showConnectionPositions,
                          showPhotos=showConnectionPhotos),
                        selectThisConnection@GemButton(label="✓ Selected", leftClick=selectConnection(connection)),
                        @GemButton(label="Delete", leftClick=deleteConnection(connection), disabled=true)
                      ]
                    );
                  }
                  @guard(isNotSelected(connection)) {
                    @GemRow(
                      colGap="5px",
                      components=[
                        @JointConnectionEdit(connection = connection,
                          showCondition=showConnectionConditions,
                          showPosition=showConnectionPositions,
                          showPhotos=showConnectionPhotos),
                        @GemButton(label="Select", leftClick=selectConnection(connection)),
                        @GemButton(label="Delete", leftClick=deleteConnection(connection), disabled=true)
                      ]
                    );
                  }
                }
              ]
            )
          )

        ]
      )
    ],
    leftSideBar=[
      @ComponentsOfPack(pack=connectionKind.batteryPack)
    ]
  );
}
