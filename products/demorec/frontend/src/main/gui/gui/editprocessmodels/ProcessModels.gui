package gui.editprocessmodels;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import gui.staticcontainer.NavContainer;
import gui.editprocessmodels.sidebar.ProcessModelSelector;

page ProcessModels() {
  @NavContainer(
    content=[
      @GemCard(
        title="Process Models",
        component=
        @GemColumn(
          components=[
            selectPMText@GemText(value = "Please select a Process Model or create a new one.")
          ]
        )
      )
    ],
    leftSideBar=[
      @ProcessModelSelector()
    ]
  );
}
