package gui.editprocessmodels.graphicalview;

import DemoRec.ProcessModel;
import DemoRec.Task;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemGrid;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;

import gui.editprocessmodels.sidebar.ProcessModelSelector;
import gui.editprocessmodels.header.TitleBar;
import gui.staticcontainer.NavContainer;

page GraphicalView(ProcessModel pm) {
  @NavContainer(
    content=[
      vpmMainContent@GemCard(
        titleComponent= @TitleBar(title="Process Model - Graphical View", pm=pm),
        component=
        @GemColumn(
          components=[
            editDeleteButtonsRow@GemRow(
              colGap="5px",
              components=[
                editProcessModelButton@GemButton(width = "auto", disabled = false, label = "Edit", leftClick = editProcessModel()),
                deleteProcessModelButton@GemButton(width = "auto", disabled = false, label = "Delete", leftClick = deleteProcessModel())
              ]
            ),

            processModelName@GemRow(
              colGap="5px",
              components=[
                processModelNameLabel@GemText(value = "Name:"),
                processModelNameValue@GemText(value = pm.name)
              ]
            ),

            processModelDescription@GemRow(
              colGap="5px",
              components=[
                processModelDescriptionLabel@GemText(value = "Description:"),
                processModelDescriptionValue@GemText(value = pm.description)
              ]
            ),

            @guard(pm.underlyingProcess != null) {
              goToUnderlyingProcessButton@GemButton(width = "auto", disabled = false, label = "Go To Underlying Process", leftClick = goToUnderlyingProcess());
            },

            modelHasTasks@guard(true) {

              viewActionsLabel@GemText(value = getViewActionsLabel());

              viewActions@GemGrid(
                //rowGap="5px",
                x=["20%", "30%", "40%", "10%"],
                rows=[
                  [
                    actionNameHeader@GemText(value = "Action"),
                    actionDescriptionHeader@GemText(value = "Description"),
                    actionDependenciesHeader@GemText(value = "Dependencies"),
                    actionUnderlyingProcessStepHeader@GemText(value = "Underlying Process Step")
                  ],
                  [
                    @iterate(Task task : pm.subTasks) {
                      actionName@GemText(value = task.name);
                      actionDescription@GemText(value = task.description);
                      actionDependencies@GemText(value = getDependsOnList(task));

                      @guard(task.underlyingProcessStep != null) {
                      	processStepDetailsButton@GemButton(width = "auto", disabled = false, label = "Details", leftClick = goToUnderlyingProcessStep(task));
                      }
                      else {
                      	noUnderlyingProcessStepText@GemText(value = "None");
                      }
                    }
                  ]
                ]
              );
            }
          ]
        )
      )
    ],
    leftSideBar=[
      @ProcessModelSelector()
    ]
  );
}
