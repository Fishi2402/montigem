package gui.editprocessmodels.graphicalview;

import DemoRec.Task;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;

import gui.step.ProcessStepView;
import gui.staticcontainer.NavContainer;

page ViewUnderlyingProcessStepDetails(Task task) {
  @NavContainer(
    content=[
      @GemCard(
        title="Task '" + task.name + "' - Details of Underlying Process Step",
        component=
          @GemColumn(
            components=[
              processStepInfo@ProcessStepView(processStep = task.underlyingProcessStep),
              backToProcessModelViewButton@GemButton(label = "Back", leftClick = goBackToProcessModelView(), disabled = false)
            ]
          )
      )
    ]
  );
}
