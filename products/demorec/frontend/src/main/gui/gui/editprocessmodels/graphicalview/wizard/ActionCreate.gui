package gui.editprocessmodels.graphicalview.wizard;

import DemoRec.Task;
import DemoRec.ProcessModel;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;

import gui.editprocessmodels.graphicalview.wizard.ActionEdit;

component ActionCreate(Task task, ProcessModel processModel, Event<Task> newTaskEvent) {
  actionEditComponent@ActionEdit(task = task, processModel = processModel);
  actionCreateButton@GemButton(width = "auto", disabled = false, label = "Save New Action", leftClick = createNewAction());
}
