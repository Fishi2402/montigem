package gui.editprocessmodels.graphicalview.wizard;

import DemoRec.ProcessModel;
import DemoRec.Task;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemGrid;

import gui.staticcontainer.NavContainer;

import gui.editprocessmodels.graphicalview.wizard.ActionCreate;
import gui.editprocessmodels.graphicalview.wizard.ActionEdit;

page DefineActions(ProcessModel processModel) {
  @NavContainer(
    content=[
      daMainContent@GemCard(
        title="Actions",
        component=

        @GemColumn(
          components=[
            modelHasActions@guard(true) {
              @iterate(Task task : processModel.subTasks) {
                editActions@GemGrid(
                  rowGap="5px",
                  x=["90%", "10%"],
                  rows=[
                    [
                      actionEditComponent@ActionEdit(task=task, processModel=processModel),
                      deleteActionButton@GemButton(width = "auto", disabled = false, label = "Delete", leftClick = deleteAction(task))
                    ]
                  ]
                );
              }
            },

            defineNewActionButton@GemButton(width = "auto", disabled = false, label = "Define New Action", leftClick = defineNewActionClicked()),

            defineANewAction@guard(true) {
              @ActionCreate(newTaskEvent=createNewAction(), processModel=processModel);
            },

            backNextRow@GemRow(
              colGap="5px",
              components=[
                backButton@GemButton(width = "auto", disabled = false, label = "< Back", leftClick = back()),
                nextButton@GemButton(width = "auto", disabled = false, label = "Next >", leftClick = next())
              ]
            )
          ]
        )
      )
    ]
  );
}
