package gui.editprocessmodels.header;

import DemoRec.ProcessModel;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

page TitleBar(String title, ProcessModel pm) {
  titleBarRow@GemRow(
    hAlign="space-between",
    vAlign="center",
    components=[

      titleText@GemText(value = title),

      viewButtons@GemRow(
        colGap="5px",
        components=[
          graphicalViewButton@GemButton(label = "Graphical View", leftClick = goToGraphicalView()),
          textualViewButton@GemButton(label = "Textual View", leftClick = goToTextualView())
        ]
      )

    ]
  );
}
