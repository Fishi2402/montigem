package gui.editprocessmodels.sidebar;

import DemoRec.ProcessModel;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;

page ProcessModelSelector(List<ProcessModel> allProcessModels) {
  @GemCard(
    title="Go To Process Model",
    component=
      @GemColumn(
        components=[
          @iterate(ProcessModel pm : allProcessModels) {
            selectProcessModelButton@GemButton(label=pm.name, leftClick=navigateToPMView(pm));
          },
          generateNewProcessModelButton@GemButton(label="Create New Process Model", leftClick=createNewProcessModel())
        ]
      )
  );
}
