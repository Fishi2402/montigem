package gui.eventlogs;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;
import mc.fenix.table.GemTableRow;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableRow;
import mc.fenix.basic.GemText;

import DemoRec.Eventlog;

component ShowEventlogs(List<Eventlog> logs) {
  @GemCard(
    titleComponent = @GemRow(hAlign = "space-between", components = [
      @GemText(value = "Event Logs")
    ]),
    component = @GemTable(
      headers = [@GemTableHeader(cols = [
        "Type", "Error type", "Details", "Timestamp"
      ])],
      body = [@iterate(Eventlog log : logs) {
        @GemTableRow(cols = [
          event@GemText(value = log.event),
          errortype@GemText(value = log.errortype),
          details@GemText(value = log.details),
          timestamp@GemText(value = formatDateTime(log.timestamp))
        ]);
      }]
    )
  );
}
