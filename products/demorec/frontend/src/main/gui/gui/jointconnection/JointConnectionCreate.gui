package gui.jointconnection;

import DemoRec.JointConnection;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentCreate;
import gui.jointconnection.JointConnectionEdit;

component JointConnectionCreate(JointConnection connection, Event<JointConnection> createJointConnection) {
  @GemCard(
    title = "Specify Connection",
    component = @GemColumn(
      rowGap="5px",
      components = [
        @JointConnectionEdit(connection=connection),
        buildConnection@GemButton(label = "Save Connection", leftClick = createNewConnection(), disabled=true, width="var(--smallDropDownWidth)")
      ]
    )
  );
}
