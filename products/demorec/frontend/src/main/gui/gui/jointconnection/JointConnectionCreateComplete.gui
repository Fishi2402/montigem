package gui.jointconnection;

import DemoRec.JointConnection;
import DemoRec.ProcessModel;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.component.ComponentCreate;
import gui.connectionkind.JointConnectionKindCreate;
import gui.jointconnection.JointConnectionEdit;

component JointConnectionCreateComplete(ProcessModel processModel, JointConnection connection, Event<JointConnection> createJointConnection) {
  @GemCard(
    title = "Create JointConnection",
    component = @GemColumn(
      rowGap="5px",
      components = [
        @JointConnectionEdit(connection=connection),

        selectJointConnectionKind@GemDropdownInput(
          labelText = "JointConnection Kind",
          options = null,
          entry = null,
          validity=checkJointConnectionKind(),
          width="var(--largeDropDownWidth)"
        ),

        createNewJointConnectionKind@guard(true) {
          @JointConnectionKindCreate(createJointConnectionKind=addNewJointConnectionKind());
        },

        buildConnection@GemButton(label = "Save Connection", leftClick = createNewConnection(), disabled=true, width="var(--smallDropDownWidth)")
      ]
    )
  );
}
