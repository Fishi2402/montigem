package gui.jointconnection;

import DemoRec.JointConnection;
import DemoRec.JointConnectionKind;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.component.ComponentCreate;
import gui.pack.ComponentsOfPack;
import gui.staticcontainer.NavContainer;
import gui.connectionkind.ChooseJointConnectionKind;
import gui.pospicker.PositionPicker;
import gui.imagescroller.ImageScroller;

component JointConnectionEdit(JointConnection connection, String imageUrl, String imagesApiUrl) {

  @GemRow(
    wrap="nowrap",
    colGap="5px",
    components=[
      condition@GemDropdownInput(
        labelText = "Condition",
        options = null,
        entry = connection.condition,
        width="var(--verySmallDropDownWidth)"),

      @GemColumn(
        rowGap="5px",
        components=[
          @GemRow(
            width="var(--coordinateWidth)",
            colGap="1rem",
            components=[
                xPos@GemTextInput(labelText = "X-Position", inputType = "number", entry = connection.xPos, width="var(--smallNumberWidth)"),
                yPos@GemTextInput(labelText = "Y-Position", inputType = "number", entry = connection.yPos, width="var(--smallNumberWidth)"),
                zPos@GemTextInput(labelText = "Z-Position", inputType = "number", entry = connection.zPos, width="var(--smallNumberWidth)")
              ]
          ),
          @GemTextInput(labelText = "Image URL", inputType = "text", entry = imageUrl),
          @ImageScroller(imagesApiUrl="/scans", imageSelected=selectImage()),
          @PositionPicker(imageUrl=imageUrl, x=connection.xPos, y=connection.yPos,z=connection.zPos)
        ]
      ),
      @GemTextInput(
        labelText = "Condition Description",
        inputType = "text",
        entry = connection.conditionDescription,
        width="var(--textWidth)"
      )
    ]
  );
}
