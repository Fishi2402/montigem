package gui.kind;

import DemoRec.ComponentKind;
import DemoRec.BatteryPack;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemAutocompleteInput;
import mc.fenix.arrange.GemColumn;

import gui.kind.CreateComponentKind;

page ChooseComponentKind(List<ComponentKind> availableKinds, ComponentKind currentKind,
      BatteryPack pack,
      Event<ComponentKind> chosenKind, boolean newKind =false) {

  @GemColumn(
    rowGap="5px",
    components=[
      selectComponentKind@GemAutocompleteInput(
          labelText = "Component Kind",
          options = getOptions(availableKinds, pack),
          entry = null,
          validity = checkKindChoice(),
          width="var(--smallDropDownWidth)"
        ),
        createComponentKind@guard(newKind) {
          @CreateComponentKind(newKind=addNewComponentKind());
        }
    ]
  );

}
