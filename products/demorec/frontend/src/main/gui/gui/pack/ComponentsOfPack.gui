package gui.pack;

import DemoRec.BatteryPack;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemTreeNode;
import mc.fenix.basic.GemButton;

import gui.pack.ComponentsTree;
import gui.pack.ConnectionsTree;

page ComponentsOfPack(BatteryPack pack) {

  @GemCard(
    title="BatteryPack",
    component=packNav@GemButton(label=pack.name, leftClick=navigateToPackEdit())
  );
  @GemCard(
    title = "Components",
    component = components@GemTreeNode(children = [
      @iterate(ComponentKind kind : pack.allKinds) {
        @ComponentsTree(kind=kind);
      }
    ])
  );

  @GemCard(
    title="Joint Connections",
    component=connections@GemTreeNode(children = [
      @iterate(JointConnectionKind connKind : pack.allConnections) {
        @ConnectionsTree(connKind=connKind);
      }
    ])
  );

}
