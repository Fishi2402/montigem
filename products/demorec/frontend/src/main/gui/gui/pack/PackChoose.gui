package gui.pack;

import DemoRec.BatteryPack;

import mc.fenix.basic.GemButton;
import mc.fenix.input.GemDropdownInput;

import gui.pack.PackCreate;

page PackChoose(List<BatteryPack> allPacks, boolean newPack=false, String choice, BatteryPack pack, Event<BatteryPack> chosenPack) {

  selectPack@GemDropdownInput(
    labelText = "Pack",
    options = getOpts(allPacks),
    entry = choice,
    width="15rem"
  );
  createPack@guard(newPack) {
    @PackCreate(newPack=addNewBatteryPack());
  }

}
