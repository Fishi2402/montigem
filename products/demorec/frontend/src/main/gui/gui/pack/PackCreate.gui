package gui.pack;

import DemoRec.BatteryPackType;
import DemoRec.BatteryPack;

import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.pack.PackEdit;

page PackCreate(BatteryPack pack, Event<BatteryPack> newPack) {

  @PackEdit(pack=pack);
  @GemButton(label="Add BatteryPack", leftClick=createNewBatteryPack(), disabled=false);

}
