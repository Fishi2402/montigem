package gui.pack;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemCheckbox;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentEdit;
import gui.pack.ChoosePackType;

page PackEdit(BatteryPack pack) {

  @GemCard(
    title = "Battery Pack",
    component = @GemColumn(
      rowGap="5px",
      components = [
        @GemRow(
          width="20em",
          colGap="5px",
          components=[
            @GemTextInput(labelText = "Health (%)", inputType = "number", entry = pack.health),
            @GemTextInput(labelText = "Charge (%)", inputType = "number", entry = pack.stateOfCharge)
          ]
        ),
        @GemRow(
          colGap="5px",
          vAlign="bottom",
          components=[
            @ChoosePackType(currentType=pack.type, chosenType=changePackType()),
            @GemButton(label = "Edit batterypack type", leftClick = editBatteryPackType(), height = "var(--gemButtonHeightAdjustedToInput)")
          ]
        ),
        @ComponentEdit(component=pack)
      ]
    )
  );
}
