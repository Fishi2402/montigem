package gui.pospicker;

import gui.pospicker.PositionPicker;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemText;

page PositionPickerPage(String imageUrl, String currentPos) {
  @GemTextInput(entry=imageUrl);
  @GemText(value=currentPos);
  @PositionPicker(imageUrl=imageUrl, positionSelected=changeCurrentPos());
}
