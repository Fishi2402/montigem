package gui.staticcontainer;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

component Navigation() {
  @GemRow(
    colGap="5px",
    components=[
      @GemButton(label="Processes", leftClick=navigateToProcesses()),
      @GemButton(label="Start new Process", leftClick=navigateToNewProcess()),
      @GemButton(label="Battery Packs", leftClick=navigateToBatteryPacks()),
      @GemButton(label="End Effectors", leftClick=navigateToEndEffectors()),
      @GemButton(label="Dimensions", leftClick=navigateToDimensions()),
      //@GemButton(label="Process Models", leftClick=navigateToProcessModels()),
      @GemButton(label="About", leftClick=navigateToAbout())
    ]
  );


}
