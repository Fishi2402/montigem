package gui.step;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemAutocompleteInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import DemoRec.ProcessStep;
import DemoRec.Process;
import DemoRec.MeasuringValue;

import gui.connectionkind.JointConnectionKindCreate;
import gui.measuringvalues.MeasuringValueEdit;

page ProcessStepCreate(ProcessStep step, Event<ProcessStep> create, boolean deconstruct = false,
  boolean newJointConnection = false, JointConnectionKind kindOfConnections = null) {
  @GemColumn(
    rowGap="5px",
    components=[
  stepCreationCard@GemCard(
      title = "New Step",
      component = @GemColumn(
        rowGap="10px",
        components = [
          deconstructionGuard@guard(true) {
            selectType@GemDropdownInput(
              labelText = "Step type",
              options = null,
              entry = step.type,
              validity=checkStepTypeSet(),
              width="var(--smallDropDownWidth)");
          },
          stepChooseJointConnectionKind@guard(true){
            isDeconstruction@guard(deconstruct) {
              selectJointConnectionKind@GemAutocompleteInput(
                  labelText = "Deconstructing Joint Connection",
                  options = null,
                  entry = null,
                  validity=checkJointConnectionKind(),
                  width="var(--largeDropDownWidth)");
            }
            createNewJointConnection@guard(deconstruct && newJointConnection) {
              @JointConnectionKindCreate(createJointConnectionKind=addNewJointConnectionKind());
            }
          },
          stepProcessStepRelated@guard(true) {
            @PartialStepEdit(step=step);
          },
          @GemRow(
            colGap="5px",
            vAlign="bottom",
            components=[
              amountOfConnsAndSteps@GemTextInput(
                  labelText="Connection & Step Copies",
                  inputType = "number",
                  entry=null,
                  width="var(--textWidth)"
              ),
              buildStep@GemButton(label = "Save Steps", leftClick = createNewStep(), disabled=true, height = "var(--gemButtonHeightAdjustedToInput)")
            ]
          )
        ]
      )
    )
  ]);

}
