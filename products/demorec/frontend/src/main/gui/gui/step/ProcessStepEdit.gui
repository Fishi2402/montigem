package gui.step;

import DemoRec.ProcessStep;
import DemoRec.Process;
import DemoRec.JointConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemCheckbox;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.step.PartialStepEdit;

import gui.measuringvalues.MeasuringValueEdit;

import gui.component.SubComponentView;
import gui.staticcontainer.NavContainer;

import gui.jointconnection.JointConnectionCreate;

page ProcessStepEdit(Process p, ProcessStep step) {

  @GemCard(
    title = "Edit Step " + step.index,
    component = @GemColumn(
      rowGap="5px",
      wrap="nowrap",
      components=[

        selectType@GemDropdownInput(
          labelText = "Type",
          options = null,
          entry = step.type),

        @PartialStepEdit(step=step),

        isDeconstruction@guard(true) {
          hasJointConnection@guard(true) {
            editJointConnectionLabel@GemText(value = "Edit Joint Connection");
            editJointConnectionRow@
            GemRow(
              wrap="nowrap",
              colGap="5px",
              components=[
                selectJointConnection@GemDropdownInput(
                    labelText = "Deconstructing Joint Connection",
                    options = null,
                    entry = null),
                createNewJointConnection@guard(true) {
                  @JointConnectionCreate(createJointConnection=addNewJointConnection());
                }
                else {
                  editJointConnectionButton@GemButton(width = "auto", disabled = false, label = "Edit this Joint Connection", leftClick = editJointConnection());
                }
            ]);
          } else {
            addJointConnectionButton@GemButton(width = "auto", disabled = false, label = "Add Joint Connection", leftClick = addJointConnection());
            addJointConnectionClicked@guard(true) {
              addJointConnectionLabel@GemText(value = "Add Joint Connection");
              editJointConnectionRow1@GemRow(
                wrap="nowrap",
                colGap="5px",
                components=[
                  selectJointConnection1@GemDropdownInput(
                      labelText = "Deconstructing Joint Connection",
                      options = null,
                      entry = null),
                  createNewJointConnection1@guard(true) {
                    @JointConnectionCreate(createJointConnection = addNewJointConnection());
                  }
                  else {
                    editJointConnectionButton1@GemButton(width = "auto", disabled = false, label = "Edit this Joint Connection", leftClick = editJointConnection());
                  }
              ]);
            }
          }
        },
        @GemButton(width = "auto", label = "Back to Process Overview", leftClick = backToProcessOverview())
    ])
  );

}

