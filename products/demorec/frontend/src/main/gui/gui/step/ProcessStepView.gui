package gui.step;

import DemoRec.ProcessStep;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;

component ProcessStepView(ProcessStep processStep) {

  @guard(processStep != null) {

    index@GemRow(
      colGap="5px",
      components=[
        indexLabel@GemText(value = "Index:"),
        indexValue@GemText(value = getIndex())
      ]
    );

    type@GemRow(
      colGap="5px",
      components=[
        typeLabel@GemText(value = "Type:"),
        typeValue@GemText(value = getType())
      ]
    );

    endEffector@GemRow(
     colGap="5px",
       components=[
        endEffectorLabel@GemText(value = "End Effector:"),
        endEffectorValue@GemText(value = getEndEffectorName())
       ]
    );

    hasJointConnection@guard(true) {
      jointConnection@GemRow(
        colGap="5px",
          components=[
            jointConnectionLabel@GemText(value = getJointConnectionLabelText()),
            jointConnectionValue@GemText(value = getJointConnectionComponents())
          ]
      );
    }

    description@GemRow(
      colGap="5px",
      components=[
        descriptionLabel@GemText(value = "Description:"),
        descriptionValue@GemText(value = getDescription())
      ]
    );

    duration@GemRow(
      colGap="5px",
      components=[
        durationLabel@GemText(value = "Duration:"),
        durationValue@GemText(value = getDuration())
      ]
    );

  }
}
