import java.time.LocalDate;
//import java.time.Duration;
//import java.net.URI; TODO locations were URI instead of String change in future if possible

classdiagram DemoRec {

  class BatteryPack extends DemoRecComponent {
    double stateOfCharge;
    Optional<double> health;
  }

  // OCL BatteryPack is not part of a composition

  //association [1] BatteryPack -> (consistsOf) DemoRecComponent [*]; Replaced by composedOf

  association [0..1] BatteryPack <-> (allComponents) DemoRecComponent [*];
  association [0..1] BatteryPack <-> (allConnections) JoinConnectionKind [*];

  class BatteryPackType {
    double capacity;
    double voltage;
    String bmsLocation;
    String vin;
    Optional<String> carBrand;
    Optional<String> carModel;
    Optional<String> carYear;
  }

  association [*] BatteryPack (inspectedInstances) <-> (type) BatteryPackType [1];

  class Process {
    LocalDate startedAt;
  }

  association [*] Process <-> (deconstructionOf) BatteryPack [1];

  class ProcessStep {
    double timeConsumption;
    ProcessStepType type;
    Optional<String> description;
    int index;
  }

  association [1] Process -> (consistsOf)  ProcessStep [*] {ordered};

  enum ProcessStepType {
    DECONSTRUCTION,
    OTHER;
  }

  class MeasuringValue {
    String value;
  }

  class Dimension {
    String unit;
    String name;
  }

  association [*] MeasuringValue -> (dimension) Dimension [1];
  association [*] ProcessStep -> (measured) MeasuringValue [*];
  association [*] ProcessStep -> (uses) EndEffector [1];
  association [*] ProcessStep <-> (deconstructs) JoinConnection [0..1];

  // TODO what characterizes an EndEffector? What about dimensions or form? Is the set of endeffectors already known?
  class EndEffector {
    String name;
  }

  class ComponentKind {
    String name;
    Optional<String> oENumber;
    Optional<String> humanDescription;

    Optional<double> width;
    Optional<double> length;
    Optional<double> height;
    Optional<double> weight;
  }

  class DemoRecComponent {
    String name;

    State condition;
    Optional<String> conditionDescription;

    Optional<double> xPos;
    Optional<double> yPos;
    Optional<double> zPos;
  }

  association [*] DemoRecComponent -> Photo [*];

  class Photo {
    String filename;
    String name;
    Long size;
  }

  association [*] DemoRecComponent <-> (isA) ComponentKind [1]; // 1.2

  class JoinConnection {
    State condition;
    Optional<String> conditionDescription;

    Optional<Double> xPos;
    Optional<Double> yPos;
    Optional<Double> zPos;
  }

  /**
   * Class representing the connection type, holding the connected components
   */
  class JoinConnectionKind {
    JoinConnectionType joinConnectionType;
    //Optional<String> name; TODO later
  }

  association [*] DemoRecComponent (connects) <-> (connectedBy) JoinConnectionKind [*];  // TODO should be 2..* on left side

  association [*] JoinConnection <->  JoinConnectionKind [1];

  enum JoinConnectionType {
    SCREW,
    GLUE,
    WELDING,
    PLUG,
    ELECTRICAL,
    UNDEFINED;
  }

  enum State {
    HEALTHY,
    OTHER;
  }
}
