package generalinfo;

import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;

import gui.staticcontainer.NavContainer;

page About() {

  @NavContainer(
      content=[
  @GemCard(
    title="Demolition Recycling",
    component = @GemText(value="The Demolition Recycling (DemoRec) project aims to automate the"+
    " dismantling process of electric vehicle batteries for recycling. To achieve full automation,"+
    "it necessitates comprehensive data on manual process flows. DemoRec employs models to specify"+
     " the structure of process data, ensuring its quality meets the requirements for subsequent"+
     " automation tasks.")
  )
  ]);

}
