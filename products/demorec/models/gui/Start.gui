package gui;

import DemoRec.Process;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;

import gui.pack.BatteryPackOverview;
import gui.navigation.Navigation;
import gui.footer.Footer;

page Start(List<Process> allProcesses) {
  @Navigation();
  @GemCard(
    title="All Processes",
    component=
      @GemColumn(
       components = [
         @iterate(Process p : allProcesses) {
           processRow@GemRow(
             wrap="nowrap",
             colGap="5px",
             components= [
               @GemColumn(
                 width="20%",
                 components= [
                   overViewLink@GemLink(url="gui/process/ProcessOverview/", text="Edit Process."),
                   @GemText(value="Deconstruction started on: "+p.startedAt)
                 ]),
               @BatteryPackOverview(pack=p.deconstructionOf)
             ]
           );
         }
       ]
     )
  );
  @Footer();
}
