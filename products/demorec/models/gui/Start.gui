package gui;

import DemoRec.Process;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemButton;

import gui.pack.BatteryPackOverview;
import gui.staticcontainer.NavContainer;

page Start(List<Process> allProcesses) {
  @NavContainer(
    content=[
      @GemCard(
        title="All Processes",
        component=
          @GemColumn(
           rowGap="15px",
           components = [
             @iterate(Process p : allProcesses) {
               processRow@GemRow(
                 wrap="nowrap",
                 colGap="5px",
                 components= [
                   @GemColumn(
                     width="20%",
                     rowGap= "15px",
                     components= [
                       editProcessButton@GemButton(label="Continue Process", leftClick=editProcess(p), disabled=false),
                       deleteProcessButton@GemButton(label="Delete Process", leftClick=deleteProcess(p), disabled=false),
                       @GemText(value="Deconstruction started on: "+p.startedAt)
                     ]),
                   @GemColumn(
                     width="80%",
                     components=[
                       @BatteryPackOverview(pack=p.deconstructionOf)
                     ]
                   )
                 ]
               );
             }
           ]
         )
      )
    ]
  );

}
