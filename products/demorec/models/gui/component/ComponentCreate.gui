package gui.component;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;
import DemoRec.JoinConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemCheckBoxInput;

import gui.component.PhotoDisplay;
import gui.component.PhotoDragNDrop;
import gui.navigation.Navigation;

component ComponentCreate(DemoRecComponent component, Event<DemoRecComponent> createComponent) {
  @GemCard(
    title = "Specify Component.",
    component = @GemColumn(
        wrap="nowrap",
        components=[
          @GemTextInput(labelText = "Component Name", inputType = "string", entry = component.name),
          @GemTextInput(labelText = "Unique ID", inputType = "string", entry = component.uniqueId),
          @GemTextInput(labelText = "OE-Number", inputType = "string", entry = component.oENumber),
          @GemTextInput(labelText = "Component Manufacturer", inputType = "string", entry = component.manufacturer),
          @GemTextInput(labelText = "Component Condition", inputType = "string", entry = component.condition),
          @GemTextInput(labelText = "Description for human identification", inputType = "string", entry = component.humanDescription),
          @GemTextInput(labelText = "X-Position", inputType = "number", entry = component.xPos),
          @GemTextInput(labelText = "Y-Position", inputType = "number", entry = component.yPos),
          @GemTextInput(labelText = "Z-Position", inputType = "number", entry = component.zPos),
          @GemTextInput(labelText = "Width (mm)", inputType = "number", entry = component.width),
          @GemTextInput(labelText = "Length (mm)", inputType = "number", entry = component.length),
          @GemTextInput(labelText = "Height (mm)", inputType = "number", entry = component.height),
          @GemTextInput(labelText = "Weight (kg)", inputType = "number", entry = component.weight),
          deconstructible@GemCheckBoxInput(labelText = "Deconstructible", checked=null),
          @PhotoDisplay(component=component),
          photoDragAndDrop@PhotoDragNDrop(attachedComponent = component),
          addComponent@GemButton(label = "Add Component", leftClick = createNewComponent, disabled=false)
      ])
  );
}
