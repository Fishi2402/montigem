package gui.component;

import DemoRec.DemoRecComponent;
import DemoRec.ComponentKind;
import DemoRec.BatteryPack;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemButton;

import gui.component.PhotoDisplay;
import gui.component.PhotoDragNDrop;
import gui.component.ComponentEdit;

component ComponentCreate(DemoRecComponent component, Event<DemoRecComponent> createComponent) {
  @GemCard(
    title = "Specify Component",
    component = @GemColumn(
        rowGap="5px",
        wrap="nowrap",
        components=[
          @ComponentEdit(component=component,showOptionalValues=false, editButton=false),
          addComponent@GemButton(label = "Add Component", leftClick = createNewComponent(), disabled=false)
      ])
  );
}
