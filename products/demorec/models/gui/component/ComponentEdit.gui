package gui.component;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;
import DemoRec.JoinConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemCheckbox;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.component.PhotoDisplay;
import gui.component.PhotoDragNDrop;
import gui.component.SubComponentView;
import gui.staticcontainer.NavContainer;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;

page ComponentEdit(DemoRecComponent component) {

  @NavContainer(
      content=[
  @GemCard(
    title = "Edit component",
    component = @GemColumn(
        wrap="nowrap",
        components=[
          @GemTextInput(labelText = "Component Name", inputType = "string", entry = component.name, disabled=true),
          @GemTextInput(labelText = "Component Condition", inputType = "string", entry = component.condition),
          @GemTextInput(labelText = "X-Position", inputType = "number", entry = component.xPos),
          @GemTextInput(labelText = "Y-Position", inputType = "number", entry = component.yPos),
          @GemTextInput(labelText = "Z-Position", inputType = "number", entry = component.zPos),
          @GemButton(label = "Edit component kind", leftClick = editComponentKind),
          @PhotoDisplay(component=component),
          photoDragAndDrop@PhotoDragNDrop(attachedComponent = component)
      ])
  ),
  @GemCard(
    title = "Subparts of component",
    component =
      @GemColumn(
        components=[
          @iterate(JoinConnection conn : component.composedOf) {
            @GemRow(
              wrap="nowrap",
              components=[
                @StatTable(width="100%", rows = [
                  @StatTableRow(left = @GemText(value = "Type of Connection"), right = @GemText(value = conn.joinConnectionType)),
                  @StatTableRow(left = @GemText(value = "State of Connection"), right = @GemText(value = conn.state))
                ])
            ]);
            @iterate(DemoRecComponent subComponent : conn.connects) {
              @SubComponentView(subComponent=subComponent);
            }
          }/*,
          buildConnection@GemButton(label = "Create new Connection.", leftClick = createNewConnection, disabled=true)/**/
        ]
      )
  )]);
}
