package gui.component;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;
import DemoRec.ComponentKind;
import DemoRec.JoinConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemCheckbox;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.component.PhotoDisplay;
import gui.component.PhotoDragNDrop;
import gui.component.SubComponentView;
import gui.kind.ChooseComponentKind;
import gui.staticcontainer.NavContainer;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;

page ComponentEdit(DemoRecComponent component, boolean showOptionalValues=true, boolean editButton=true) {

  @GemColumn(
    wrap="nowrap",
    rowGap="5px",
    components=[
      @GemRow(
        colGap="5px",
        components=[
          @ChooseComponentKind(currentKind= component.isA,chosenKind=changeToKind()),
          @guard(editButton) {
            @GemButton(label = "Edit component kind", leftClick = editComponentKind());
          }
        ]
      ),
      @GemTextInput(labelText = "Component Name", inputType = "string", entry = component.name),
      @guard(showOptionalValues) {
        condition@GemDropdownInput(
          labelText = "Component Condition",
          options = null,
          entry = component.condition);
        @GemRow(
          width="30em",
          colGap="5px",
          components=[
            @GemTextInput(labelText = "X-Position", inputType = "number", entry = component.xPos),
            @GemTextInput(labelText = "Y-Position", inputType = "number", entry = component.yPos),
            @GemTextInput(labelText = "Z-Position", inputType = "number", entry = component.zPos)
          ]
        );
        @PhotoDisplay(component=component);
        photoDragAndDrop@PhotoDragNDrop(createPhoto=addPhoto(), attachedComponent = component.name);
      }

  ]);
}
