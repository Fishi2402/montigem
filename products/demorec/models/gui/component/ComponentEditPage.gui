package gui.component;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;
import DemoRec.JoinConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentEdit;
import gui.staticcontainer.NavContainer;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;
import gui.pack.ComponentsOfPack;
import gui.staticcontainer.HorizontalStatTable;
import gui.staticcontainer.EvenlySpacedColumn;


page ComponentEditPage(DemoRecComponent component) {

  @NavContainer(
      content=[
  @ComponentEdit(component=component),
  @GemCard(
    title = "JoinConnections connected with this component",
    component =
      @GemColumn(
        components=[
          tableHeader@HorizontalStatTable(rows = [
            @EvenlySpacedColumn(element = @GemText(value = "Connection")),
            @EvenlySpacedColumn(element = @GemText(value = "Connection Condition")),
            @EvenlySpacedColumn(element = @GemText(value = "X")),
            @EvenlySpacedColumn(element = @GemText(value = "Y")),
            @EvenlySpacedColumn(element = @GemText(value = "Z"))
          ]),
          @iterate(JoinConnection connection : component.connectedBy) {
            @HorizontalStatTable(rows = [
              @EvenlySpacedColumn(element = connectionName@GemText(value = null)),
              @EvenlySpacedColumn(element = @GemText(value = connection.condition)),
              @EvenlySpacedColumn(element = @GemTextInput(labelText = "X-Position", inputType = "number", entry = connection.xPos)),
              @EvenlySpacedColumn(element = @GemTextInput(labelText = "Y-Position", inputType = "number", entry = connection.yPos)),
              @EvenlySpacedColumn(element = @GemTextInput(labelText = "Z-Position", inputType = "number", entry = connection.zPos))
            ]);
          }
        ]
      )
  )],
      leftSideBar=[
        @ComponentsOfPack(pack=component.batteryPack)
      ]);
}
