package gui.component;

import DemoRec.BatteryPack;
import DemoRec.DemoRecComponent;
import DemoRec.JoinConnection;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemButton;

page SubComponentView(DemoRecComponent subComponent) {

  @GemColumn(
    components=[
      @GemText(value="xPos is "+ subComponent.xPos),
      editSubcomponent@GemLink(url="override", text="Edit Subcomponent.")
    ]
  );
}
