package gui.dimension;

import DemoRec.Dimension;

import basic.GemText;
import arrange.GemRow;
import input.GemTextInput;
import basic.GemButton;

page DimensionCreate(Dimension dimension) {

  @GemRow(
    wrap="nowrap",
    colGap="5%",
    components=[
      @GemTextInput(
        labelText = "Name",
        inputType = "text",
        entry = dimension.name),
      @GemTextInput(
        labelText = "Unit",
        inputType = "text",
        entry = dimension.unit)
    ]
  );
  @GemButton(label="Save", leftClick = createDimension);

}
