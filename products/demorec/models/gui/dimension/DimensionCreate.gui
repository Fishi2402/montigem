package gui.dimension;

import DemoRec.Dimension;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;

page DimensionCreate(Dimension dimension) {

  @GemRow(
    wrap="nowrap",
    colGap="5%",
    components=[
      @GemTextInput(
        labelText = "Name",
        inputType = "text",
        entry = dimension.name),
      @GemTextInput(
        labelText = "Unit",
        inputType = "text",
        entry = dimension.unit)
    ]
  );
  @GemButton(label="Save", leftClick = createDimension);

}
