package gui.dimension;

import DemoRec.Dimension;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import gui.dimension.DimensionCreate;
import gui.staticcontainer.NavContainer;

page DimensionOverview(List<Dimension> dimensions) {

  @NavContainer(
      content=[
  @GemCard(
    title="Dimensions of values",
    component=@GemColumn(
      rowGap="1px",
      wrap="nowrap",
      components=[
        newDimension@DimensionCreate(),
        @iterate(Dimension dimension : dimensions) {
          @GemRow(wrap="nowrap",components= [
            @GemTextInput(inputType = "string", entry = dimension.name),
            @GemTextInput(inputType = "string", entry = dimension.unit)
          ]);
        }
      ]
    )
  )]);
}
