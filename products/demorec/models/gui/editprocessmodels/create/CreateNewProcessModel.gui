package gui.editprocessmodels.create;

import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemDropdownInput;

import gui.staticcontainer.NavContainer;

page CreateNewProcessModel() {
  @NavContainer(
    content=[
      @GemColumn(
        components=[
          aProcessHasNoProcessModel@guard(true) {
            selectUnderlyingProcess@GemDropdownInput(
              labelText = "Please select the underlying Process:",
              options = null,
              entry = null,
              disabled = false
            );
            createNewProcessModelButton@GemButton(label="Create Process Model", leftClick=createNewProcessModel());
          }
          else {
            noFreeProcessModelText@GemText(value = "Cannot create a new Process Model, because all Processes already have Process Models.");
          },

          backButton@GemButton(label="Back", leftClick=navigateToProcessModelLandingPage())
        ]
      )
    ]
  );
}
