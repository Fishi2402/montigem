package gui.editprocessmodels.graphicalview.wizard;

import DemoRec.ProcessModel;
import DemoRec.Task;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemGrid;

import gui.editprocessmodels.graphicalview.wizard.DependenciesEdit;

import gui.staticcontainer.NavContainer;

page DefineDependencies(ProcessModel processModel) {
  @NavContainer(
    content=[
      ddonlMainContent@GemCard(
        title="Dependencies",
        component=@GemColumn(
          components=[

            @GemGrid(
              rowGap="5px",
              x=["20%", "80%"],
              rows=[
                [
                  actionNameHeader@GemText(value = "Action"),
                  actionAddDependenciesHeader@GemText(value = "Add Dependencies")
                ],
                [
                  @iterate(Task task : processModel.subTasks) {
                    actionNameText@GemText(value = task.name);
                    dependsOnListEditComponent@DependenciesEdit(task = task);
                  }
                ]
              ]
            ),

            backNextRow@GemRow(
              colGap="5px",
              components=[
                backButton@GemButton(width = "auto", disabled = false, label = "< Back", leftClick = back()),
                nextButton@GemButton(width = "auto", disabled = false, label = "Finish", leftClick = next())
              ]
            )
          ]
        )
      )
    ]
  );
}
