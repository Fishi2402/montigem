package gui.editprocessmodels.graphicalview.wizard;

import DemoRec.Process;
import DemoRec.ProcessModel;
import DemoRec.Task;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;

import gui.staticcontainer.NavContainer;

page DefineProcessModel(ProcessModel processModel) {
  @NavContainer(
    content=[
      @GemCard(
        title="Process",
        component=@GemColumn(
          components=[

          @guard(processModel.underlyingProcess != null) {
              startedAtInfo@GemRow(
                 colGap="5px",
                 components=[
                   startedAtLabel@GemText(value = "Start Date:"),
                   startedAtValue@GemText(value = getProcessStartedAt())
                 ]
               );

              batteryPackInfo@GemRow(
                colGap="5px",
                components=[
                  batteryPackLabel@GemText(value = "Disassembled Battery Pack:"),
                  batteryPackValue@GemText(value = processModel.underlyingProcess.deconstructionOf.name)
                ]
              );
            },

            pmName@GemTextInput(labelText = "Name:", inputType = "string", placeholder = processModel.name, entry = processModel.name),

            pmDescription@GemTextareaInput(
              labelText = "Short Description:",
              entry = processModel.description,
              placeholder = processModel.description
            ),

            backNextRow@GemRow(
              colGap="5px",
              components=[
                backButton@GemButton(width = "auto", disabled = false, label = "Abort", leftClick = back()),
                nextButton@GemButton(width = "auto", disabled = false, label = "Next >", leftClick = next())
              ]
            )
          ]
        )
      )
    ]
  );
}
