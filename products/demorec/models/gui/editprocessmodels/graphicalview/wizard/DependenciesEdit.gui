package gui.editprocessmodels.graphicalview.wizard;

import DemoRec.Task;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemDropdownInput;

component DependenciesEdit(Task task, List<String> selectedDependencies) {
  selectDependsOn@GemRow(colGap="5px",
    components=[
      selectDependsOn@GemDropdownInput(
        labelText = "Select a Dependency:",
        options = null,
        entry = null,
        disabled = false
      ),
      addDependsOnButton@GemButton(width = "auto", disabled = false, label = "Add", leftClick = addDependency())
    ]
  );

  addedDependenciesRow@GemRow(
    wrap="nowrap",
    colGap="5px",
    components = [
      @iterate(String taskName : selectedDependencies) {
        @GemColumn(
          components = [removeDependencyButton@GemButton(label = taskName, leftClick = removeSelectedDependency(taskName), disabled = false)]
        );
      }
    ]
  );

  showWarningRow@GemRow(
    wrap="nowrap",
    colGap="5px",
    components = [
      warningText@GemText(value = getWarning())
    ]
  );
}
