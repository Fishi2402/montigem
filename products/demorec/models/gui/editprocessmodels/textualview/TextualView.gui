package gui.editprocessmodels.textualview;

import DemoRec.ProcessModel;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;

import gui.editprocessmodels.sidebar.ProcessModelSelector;
import gui.editprocessmodels.header.TitleBar;

import gui.staticcontainer.NavContainer;

import gui.editprocessmodels.textualview.ProcessModelEditor;
import gui.editprocessmodels.textualview.textualeditor.MonacoEditor;

page TextualView(ProcessModel pm) {
  @NavContainer(
    content=[

      vpmMainContent@GemCard(
        titleComponent= @TitleBar(title="Process Model - Textual View", pm=pm),
        component=

        @GemColumn(
          width="100%",
          rowGap="5px",
          wrap="nowrap",
          components=[
            downloadButtonsRow@GemRow(
              colGap="5px",
              components=[
                downloadModelButton@GemButton(label = "Download Model", leftClick = downloadModel()),
                downloadTagsButton@GemButton(label = "Download Tags", leftClick = downloadTags()),
                downloadInstructionsButton@GemButton(label = "Download Instructions", leftClick = downloadInstructions())
              ]
            ),
            modelEditor@ProcessModelEditor(codeChanged=getEditorsCurrentCode(), processModel=pm)
            //modelEditor@MonacoEditor(initialCode = setEditorsInitialCode(), language = "Workflow DSL", theme = "vs-dark", glyphMargin = true, showLightbulbIconMode = true, automaticLayout = true, semanticHighlightingEnabled = true, codeChanged = getEditorsCurrentCode())
          ]
        )
      )

    ],
    leftSideBar=[
      @ProcessModelSelector()
    ]
  );
}
