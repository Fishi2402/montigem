package gui.endeffector;

import DemoRec.EndEffector;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;

page EndEffectorCreate(EndEffector endEffector) {

  @GemColumn(
    rowGap="5px",
    components=[
      @GemTextInput(
        labelText = "Name",
        inputType = "text",
        entry = endEffector.name),
      @GemButton(label="Save", leftClick = createEndEffector())
    ]
  );


}
