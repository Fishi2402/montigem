package gui.endeffector;

import DemoRec.EndEffector;

import mc.fenix.table.GemTable;
import mc.fenix.table.TableTypes.TableColumn;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;

import gui.endeffector.EndEffectorCreate;
import gui.staticcontainer.NavContainer;

page EndEffectorOverview(List<EndEffector> endEffectors) {

  @NavContainer(
      content=[

/*
  endEffectorsTable@GemTable(
    canCreate=true,
    create=createEndEffector,
    rows = endEffectors,
    columns = [
      TableColumn("name", "Name")
    ]
  ),*/

  @GemCard(
    title="End Effectors",
    component=@GemColumn(
      rowGap="1px",
      wrap="nowrap",
      components=[
        newEffector@EndEffectorCreate(),
        @iterate(EndEffector endEffector : endEffectors) {
          @GemText(value=endEffector.name);
        }
      ]
    )
  )]);
}
