package gui.joinconnection;

import DemoRec.Process;
import DemoRec.ProcessStep;
import DemoRec.JoinConnection;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentEdit;
import gui.component.ComponentCreate;

import gui.staticcontainer.NavContainer;

page JoinConnectionEdit(Process p, ProcessStep step, JoinConnection connection, List<String> dummyComponentNames) {
  @NavContainer(
    content=[
      @GemCard(
        //title = "Edit Join Connection " + calculateDisplayValueOfJoinConnection(connection),
        title = "Edit Join Connection",

        component = @GemColumn(
            wrap="nowrap",
            components=[
              @GemTextInput(
                labelText = "State of Connection (%)",
                inputType = "number",
                placeholder = connection.state,
                entry = connection.state),

              selectTypeOfConnection@GemTextInput(
                labelText = "Type of Connection",
                inputType = "dropdown",
                options = null,
                entry = connection.joinConnectionType),

              selectSuperComponent@GemTextInput(
                labelText = "Part of Component",
                inputType = "dropdown",
                options = null,
                entry = null),

              @GemRow(
                wrap="nowrap",
                vAlign="center",
                hAlign="center",
                components= [
                  selectConnectsComponent@GemTextInput(
                      labelText = "Components connected by this connection",
                      inputType = "dropdown",
                      options = null,
                      entry = null,
                      keyRelease = tryToAddComponent),
                  addComponent@GemButton(label = "Add Component", leftClick = connectSelectedComponent, disabled=false)
                ]
              ),

              @GemRow(
                wrap="nowrap",
                colGap="5px",
                components = [
                  @iterate(String dummyComponentName : dummyComponentNames){
                    @GemColumn(
                      components = [removeComponent@GemButton(label = dummyComponentName, leftClick = removeSelectedComponent(dummyComponentName), disabled = false)]
                    );
                  }
                ]
              ),

              newCompGuard@guard(true) {
                @GemColumn(
                  components=[
                    @ComponentCreate(createComponent=addNewComponent)
                  ]
                );
              },

              @GemButton(label = "Back to Step Editing", leftClick = backToStepEditing)
            ]
        )
      )
    ]
  );
}
