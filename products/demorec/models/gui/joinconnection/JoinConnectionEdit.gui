package gui.joinconnection;

import DemoRec.JoinConnection;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;

import gui.component.ComponentCreate;
import gui.pack.ComponentsOfPack;
import gui.staticcontainer.NavContainer;

page JoinConnectionEdit(JoinConnection connection, boolean showOptionalAttributes=true) {

  @GemColumn(
    wrap="nowrap",
    rowGap="5px",
    components=[
      condition@GemTextInput(
        labelText = "Condition of Connection",
        inputType = "dropdown",
        options = null,
        entry = connection.condition),

      selectTypeOfConnection@GemTextInput(
        labelText = "Type of Connection",
        inputType = "dropdown",
        options = null,
        entry = connection.joinConnectionType),

      @GemRow(
        wrap="nowrap",
        vAlign="center",
        hAlign="center",
        components= [
          selectConnectsComponent@GemTextInput(
              labelText = "Components connected by this connection",
              inputType = "dropdown",
              options = null,
              entry = null,
              keyRelease = tryToAddComponent),
          addComponent@GemButton(label = "Add Component", leftClick = connectSelectedComponent, disabled=false)
        ]
      ),

      @GemRow(
        wrap="nowrap",
        colGap="5px",
        components = [
          @iterate(DemoRecComponent component : connection.connects){
            removeComponent@GemButton(label=component.name, leftClick=removeSelectedComponent(component), disabled=false);
          }
        ]
      ),

      newCompGuard@guard(true) {
        createComponentDialog@GemColumn(
          components=[
            @ComponentCreate(createComponent=addNewComponent)
          ]
        );
      },
      optionalPos@guard(showOptionalAttributes) {
        @GemRow(
          width="30em",
          colGap="5px",
          components=[
            xPos@GemTextInput(labelText = "X-Position", inputType = "number", entry = connection.xPos),
            yPos@GemTextInput(labelText = "Y-Position", inputType = "number", entry = connection.yPos),
            zPos@GemTextInput(labelText = "Z-Position", inputType = "number", entry = connection.zPos)
          ]
        );
      }
    ]
  );
}
