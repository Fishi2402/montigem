package gui.joinconnection;

import DemoRec.JoinConnection;
import DemoRec.JoinConnectionKind;
import DemoRec.DemoRecComponent;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;

import gui.component.ComponentCreate;
import gui.pack.ComponentsOfPack;
import gui.staticcontainer.NavContainer;
import gui.connectionkind.ChooseJoinConnectionKind;

page JoinConnectionEdit(JoinConnection connection) {

  @GemRow(
    wrap="nowrap",
    colGap="5px",
    components=[
      condition@GemDropdownInput(
        labelText = "Condition of Connection",
        options = null,
        entry = connection.condition,
        width="var(--smallNumberWidth)"),

      @GemRow(
        width="30em",
        colGap="5px",
        components=[
            xPos@GemTextInput(labelText = "X-Position", inputType = "number", entry = connection.xPos, width="var(--smallNumberWidth)"),
            yPos@GemTextInput(labelText = "Y-Position", inputType = "number", entry = connection.yPos, width="var(--smallNumberWidth)"),
            zPos@GemTextInput(labelText = "Z-Position", inputType = "number", entry = connection.zPos, width="var(--smallNumberWidth)")
          ]
      ),
      @GemTextInput(
        labelText = "Condition Description",
        inputType = "text",
        entry = connection.conditionDescription,
        width="var(--textWidth)"
      )
    ]
  );
}
