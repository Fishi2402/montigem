package gui.kind;

import DemoRec.ComponentKind;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.arrange.GemColumn;

import gui.kind.CreateComponentKind;

page ChooseComponentKind(List<ComponentKind> availableKinds, ComponentKind currentKind, Event<ComponentKind> chosenKind) {

  @GemColumn(
    rowGap="5px",
    components=[
      selectComponentKind@GemDropdownInput(
          labelText = "Component Kind",
          options = null,
          entry = null,
          validity = checkKindChoice(),
          width="var(--smallDropDownWidth)"
        ),
        createComponentKind@guard(true) {
          @CreateComponentKind(newKind=addNewComponentKind());
        }
    ]
  );

}
