package gui.kind;

import DemoRec.ComponentKind;

import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;

import gui.kind.EditComponentKind;

page CreateComponentKind(ComponentKind kind, Event<ComponentKind> newKind) {

  @GemColumn(
    rowGap="5px",
    components=[
      @EditComponentKind(componentKind=kind,showOptionalValues=false),
      @GemButton(label="Add ComponentKind", leftClick=createNewComponentKind, disabled=false)
    ]
  );

}
