package gui.kind;

import DemoRec.ComponentKind;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemCheckbox;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;

import gui.component.PhotoDisplay;
import gui.component.PhotoDragNDrop;
import gui.component.SubComponentView;
import gui.staticcontainer.NavContainer;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;

page Edit(ComponentKind componentKind) {

  @NavContainer(
      content=[
  @GemCard(
    title = "Edit component kind",
    component = @GemColumn(
        wrap="nowrap",
        components=[
         @GemTextInput(labelText = "Component Kind Name", inputType = "string", entry = componentKind.name),
         @GemTextInput(labelText = "OE-Number", inputType = "string", entry = componentKind.oENumber),
         @GemTextInput(labelText = "Description for human identification", inputType = "string", entry = componentKind.humanDescription),
         @GemTextInput(labelText = "Width (mm)", inputType = "number", entry = componentKind.width),
         @GemTextInput(labelText = "Length (mm)", inputType = "number", entry = componentKind.length),
         @GemTextInput(labelText = "Height (mm)", inputType = "number", entry = componentKind.height),
         @GemTextInput(labelText = "Weight (kg)", inputType = "number", entry = componentKind.weight)
      ])
  )
  ]);
}
