package gui.kind;

import DemoRec.ComponentKind;
import DemoRec.BatteryPack;

import gui.kind.EditComponentKind;
import gui.staticcontainer.NavContainer;
import gui.pack.ComponentsOfPack;

page EditComponentKindPage(BatteryPack pack, ComponentKind kind) {

  @NavContainer(
    content=[@EditComponentKind(componentKind=kind, showOptionalValues=true)],
    leftSideBar=[@ComponentsOfPack(pack=pack)]
    );
}
