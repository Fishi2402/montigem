package gui.measuringvalues;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import DemoRec.MeasuringValue;
import DemoRec.Dimension;

page MeasuringValueCreate(MeasuringValue measuringValue, Event<MeasuringValue> measuringValueEvent) {
  @GemRow(
    wrap="nowrap",
    colGap="5px",
    components=[
      @GemTextInput(labelText = "Value", inputType = "string", entry = measuringValue.value),
      selectDimensionUnit@GemDropdownInput(
        labelText = "Unit",
        options = null,
        entry = null
      ),
      addMeasuringValue@GemButton(label = "Add Value", leftClick = createNewMeasuringValue(), disabled=false)
    ]
  );
}
