package gui.measuringvalues;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import DemoRec.ProcessStep;
import DemoRec.MeasuringValue;

import gui.measuringvalues.MeasuringValueCreate;

page MeasuringValueEdit(ProcessStep step) {
  @GemCard(
    title = "Measured Values",
    component = @GemColumn(
      colGap="10px",
      components = [
        addNewMeasuringValue@MeasuringValueCreate(measuringValueEvent = attachMeasuringValue()),
        @iterate(MeasuringValue measuringValue : step.measured) {
          displayedMeasuringValueRow@GemRow(
            wrap="nowrap",
            colGap="5px",
            vAlign="bottom",
            components=[
              displayedMeasuringValue@GemTextInput(labelText = "Value", inputType = "string", entry = measuringValue.value),
              displayedMeasuringValueDimensionUnit@GemDropdownInput(
                labelText = "Unit",
                options = null,
                entry = null,
                width="var(--verySmallDropDownWidth)"
              ),
              displayedMeasuringValueDeleteButton@GemButton(label = "Delete", leftClick = deleteMeasuringValue(measuringValue), height="var(--gemButtonHeightAdjustedToInput)")
            ]
          );
        }
      ]
    )
  );
}
