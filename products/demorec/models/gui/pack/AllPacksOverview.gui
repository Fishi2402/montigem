package gui.pack;

import DemoRec.BatteryPack;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;

import gui.pack.BatteryPackOverview;
import gui.staticcontainer.NavContainer;

page AllPacksOverview(List<BatteryPack> allPacks) {
  @NavContainer(
    content=[
     @GemColumn(
        colGap="5px",
        components = [
          @iterate(BatteryPack pack : allPacks) {
            @BatteryPackOverview(pack=pack);
          }
      ])
    ]
  );

}
