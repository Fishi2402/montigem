package gui.pack;

import DemoRec.BatteryPack;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemButton;

import gui.pack.PackTypeOverview;
import gui.component.PhotoDisplay;
import gui.component.ComponentTreeView;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;

component BatteryPackOverview(BatteryPack pack) {
  @GemRow(
    colGap = "5px",
    components = [
      @GemColumn(
        width="20%",
        components=[
          @PhotoDisplay(component=pack)
        ]
      ),
      @GemColumn(
        width="30%",
        rowGap = "15px",
        components=[
          editPackBtn@GemButton(label = "Edit Pack", leftClick = editPack()),
          @GemText(value=pack.name),
          @StatTable(rows = [
            @StatTableRow(left = @GemText(value = "Health (%)"), right = @GemText(value = pack.health)),
            @StatTableRow(left = @GemText(value = "Charge (%)"), right = @GemText(value = pack.stateOfCharge))
          ])
        ]
      ),
      @GemColumn(
        components=[
          @PackTypeOverview(type=pack.type)
        ]
      )
      /*
      @GemColumn(
        width="20%",
        components=[
          tree@ComponentTreeView(component=pack)
        ]
      )
      /**/
  ]);
}
