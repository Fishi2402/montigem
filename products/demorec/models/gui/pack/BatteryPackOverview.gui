package gui.pack;

import DemoRec.BatteryPack;

import arrange.GemRow;
import arrange.GemColumn;
import basic.GemText;
import basic.GemLink;

import gui.pack.PackTypeOverview;
import gui.component.PhotoDisplay;
import gui.component.ComponentTreeView;

component BatteryPackOverview(BatteryPack pack) {
  @GemRow(
    colGap="5px",
    wrap="nowrap",
    components = [
      @GemColumn(
        width="30%",
        components=[
          @GemText(value="Description "+pack.description),
          @GemText(value="State of Charge "+pack.stateOfCharge),
          @GemText(value="State of Health (%) "+pack.health)
        ]
      ),
      editPack@GemLink(url="override", text="Edit Pack."),
      @PhotoDisplay(component=pack),
      @PackTypeOverview(type=pack.type),
      @ComponentTreeView(component=pack)
  ]);
}
