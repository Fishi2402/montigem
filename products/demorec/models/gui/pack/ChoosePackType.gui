package gui.pack;

import DemoRec.BatteryPackType;

import mc.fenix.input.GemDropdownInput;

import gui.pack.PackTypeCreate;

page ChoosePackType(BatteryPackType currentType, Event<BatteryPackType> chosenType) {

  selectPackType@GemDropdownInput(
    labelText = "Pack Type",
    options = null,
    entry = null,
    width="var(--smallDropDownWidth)"
  );
  createPackType@guard(true) {
    @PackTypeCreate(newType=addNewBatteryPackType());
  }

}
