package gui.pack;

import DemoRec.BatteryPackType;

import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemAutocompleteInput;

import gui.pack.PackTypeCreate;

page ChoosePackType(List<BatteryPackType> bPackTypes, BatteryPackType currentType,
    Event<BatteryPackType> chosenType, boolean newPackType = false) {

  selectPackType@GemAutocompleteInput(
    labelText = "Pack Type",
    options = getOpts(bPackTypes),
    entry = null,
    width="var(--smallDropDownWidth)"
  );
  @guard(newPackType) {
    @PackTypeCreate(newType=addNewBatteryPackType());
  }

}
