package gui.pack;

import DemoRec.BatteryPackType;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.input.GemTextInput;

page PackTypeEdit(BatteryPackType type) {

  @GemCard(
    title = "Battery Pack Type",
    component = @GemColumn(
      rowGap="5px",
      components = [
        @GemTextInput(labelText = "Voltage (V)", inputType = "number", entry = type.voltage),
        @GemTextInput(labelText = "Capacity (kWh)", inputType = "number", entry = type.capacity),
        @GemTextInput(labelText = "BMS Location", inputType = "string", entry = type.bmsLocation),
        @GemTextInput(labelText = "VIN", inputType = "string", entry = type.vin),
        @GemTextInput(labelText = "Car Brand", inputType = "string", entry = type.carBrand),
        @GemTextInput(labelText = "Car Model", inputType = "string", entry = type.carModel),
        @GemTextInput(labelText = "Year of Production", inputType = "string", entry = type.carYear)
      ]
    )
  );
}
