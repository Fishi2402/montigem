package gui.pack;

import DemoRec.BatteryPack;
import DemoRec.BatteryPackType;

import gui.staticcontainer.NavContainer;
import gui.pack.ComponentsOfPack;
import gui.pack.PackTypeEdit;

page PackTypeEditPage(BatteryPack pack, BatteryPackType type) {

  @NavContainer(
      content=[@PackTypeEdit(type=type)],
      leftSideBar=[@ComponentsOfPack(pack=pack)]
  );
}
