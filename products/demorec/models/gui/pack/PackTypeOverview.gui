package gui.pack;

import DemoRec.BatteryPackType;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import gui.staticcontainer.StatTable;
import gui.staticcontainer.StatTableRow;

component PackTypeOverview(BatteryPackType type) {
  @StatTable(rows = [
    @StatTableRow(left = @GemText(value = "Car "), right = @GemText(value=type.carModel+" ("+type.carYear+") "+type.carBrand)),
    @StatTableRow(left = @GemText(value = "Voltage (V)"), right = @GemText(value = type.voltage)),
    @StatTableRow(left = @GemText(value = "Capacity (kWh)"), right = @GemText(value = type.capacity)),
    @StatTableRow(left = @GemText(value = "BMS located at "), right = @GemText(value = type.bmsLocation)),
    @StatTableRow(left = @GemText(value = "VIN"), right = @GemText(value = type.vin))
  ]);
}
