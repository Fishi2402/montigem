package gui.pack;

import DemoRec.BatteryPackType;

import basic.GemText;
import arrange.GemCard;
import arrange.GemColumn;
import arrange.GemRow;

component PackTypeOverview(BatteryPackType type) {

  @GemColumn(
    rowGap="1px",
    wrap="nowrap",
    components=[
      @GemText(value="Voltage (V) "+type.voltage),
      @GemText(value="Capacity (kWh) "+type.capacity),
      @GemText(value="BMS located at "+type.bmsLocation),
      @GemText(value="VIN "+type.vin),
      @GemRow(
        wrap="nowrap",
        colGap="2px",
        components=[
          @GemText(value=type.carBrand),
          @GemText(value=type.carModel),
          @GemText(value=type.carYear)])
    ]
  );
}
