package gui.process;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import gui.staticcontainer.NavContainer;
import gui.pack.PackEdit;

import DemoRec.BatteryPack;
import DemoRec.Process;
import DemoRec.BatteryPackType;

page ProcessCreate(Process p, BatteryPack pack) {
  @NavContainer(
    content=[
  @GemCard(
    title = "Process",
    component = @GemColumn(
      rowGap="5px",
      components = [
        startedAt@GemTextInput(
            labelText = "Started",
            inputType = "date",
            entry = p.startedAt
            ),
        selectBPack@GemTextInput(
          labelText = "Battery Pack",
          inputType = "dropdown",
          options = null,
          entry = null
        )
      ]
    )
  ),
  guardBPack@guard(true) {
    @PackEdit(pack=pack);
  },
  @GemButton(label = "Start Process", leftClick = sendEverything())
  ]);
}
