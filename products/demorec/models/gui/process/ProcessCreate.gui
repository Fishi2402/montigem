package gui.process;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;

import gui.component.PhotoDragNDrop;
import gui.component.PhotoDisplay;
import gui.staticcontainer.NavContainer;

import DemoRec.BatteryPack;
import DemoRec.Process;
import DemoRec.BatteryPackType;

page ProcessCreate(Process p, BatteryPack pack, BatteryPackType type) {
  @NavContainer(
    content=[
  @GemCard(
    title = "Process",
    component = @GemColumn(
      components = [
        startedAt@GemTextInput(
            labelText = "Started",
            inputType = "date",
            entry = p.startedAt
            ),
        selectBPack@GemTextInput(
          labelText = "Battery Pack",
          inputType = "dropdown",
          options = null,
          entry = null
        )
      ]
    )
  ),
  guardBPack@guard(true) {
    @GemCard(
      title = "Battery Pack",
      component = @GemColumn(
        components = [
          packName@GemTextInput(labelText = "Component Name", inputType = "string", entry = pack.name, placeholder="Override"),
          @GemTextInput(labelText = "Health (%)", inputType = "number", entry = pack.health),
          @GemTextInput(labelText = "Charge (%)", inputType = "number", entry = pack.stateOfCharge),
          @GemTextInput(labelText = "OE-Number", inputType = "string", entry = pack.oENumber),
          @GemTextInput(labelText = "Component Condition", inputType = "string", entry = pack.condition),
          @GemTextInput(labelText = "Description for human identification", inputType = "string", entry = pack.humanDescription),
          @GemTextInput(labelText = "X-Position", inputType = "number", entry = pack.xPos),
          @GemTextInput(labelText = "Y-Position", inputType = "number", entry = pack.yPos),
          @GemTextInput(labelText = "Z-Position", inputType = "number", entry = pack.zPos),
          @GemTextInput(labelText = "Width (mm)", inputType = "number", entry = pack.width),
          @GemTextInput(labelText = "Length (mm)", inputType = "number", entry = pack.length),
          @GemTextInput(labelText = "Height (mm)", inputType = "number", entry = pack.height),
          @GemTextInput(labelText = "Weight (kg)", inputType = "number", entry = pack.weight),
          @PhotoDisplay(component=pack),
          photoDragAndDrop@PhotoDragNDrop(attachedComponent = pack),
          selectBPackType@GemTextInput(
            labelText = "Battery Pack Type",
            inputType = "dropdown",
            options = null,
            entry = null
          )
        ]
      )
    );
    guardBPackType@guard(true) {
      @GemCard(
        title = "Battery Pack Type",
        component = @GemColumn(
          components = [
            @GemTextInput(labelText = "Voltage (V)", inputType = "number", entry = type.voltage),
            @GemTextInput(labelText = "Capacity (kWh)", inputType = "number", entry = type.capacity),
            @GemTextInput(labelText = "BMS Location", inputType = "string", entry = type.bmsLocation),
            @GemTextInput(labelText = "VIN", inputType = "string", entry = type.vin),
            @GemTextInput(labelText = "Car Brand", inputType = "string", entry = type.carBrand),
            @GemTextInput(labelText = "Car Model", inputType = "string", entry = type.carModel),
            @GemTextInput(labelText = "Year of Production", inputType = "string", entry = type.carYear)
          ]
        )
      );
    }
  },
  @GemButton(label = "Start Process", leftClick = sendEverything)
  ]);
}
