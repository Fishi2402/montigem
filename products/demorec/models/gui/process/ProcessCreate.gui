package gui.process;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import gui.staticcontainer.NavContainer;
import gui.pack.PackChoose;

import DemoRec.Process;
import DemoRec.BatteryPackType;

page ProcessCreate(Process p) {
  @NavContainer(
    content=[
  @GemCard(
    title = "Process",
    component = @GemColumn(
      rowGap="5px",
      components = [
        startedAt@GemTextInput(
            labelText = "Started",
            inputType = "date",
            entry = p.startedAt
            ),
        @PackChoose(pack=p.deconstructionOf, chosenPack=changePack())
      ]
    )
  ),
  @GemButton(label = "Start Process", leftClick = sendEverything())
  ]);
}
