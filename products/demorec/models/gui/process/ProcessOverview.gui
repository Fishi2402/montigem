package gui.process;

import DemoRec.Process;
import DemoRec.ProcessStep;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;

import gui.staticcontainer.NavContainer;
import gui.step.ProcessStepCreate;
import gui.pack.BatteryPackOverview;


page ProcessOverview(Process p) {

  @NavContainer(
      content=[
  @GemCard(
      title="Deconstruction Process of Pack",
      component=@BatteryPackOverview(pack=p.deconstructionOf)
    ),
  @GemCard(
    title="Process Steps",
    component=@GemColumn(
      components = [
        stepCreate@ProcessStepCreate(create = attachStep),
        @iterate(ProcessStep step : p.consistsOf) {
          @GemRow(colGap="5px",
            components=[
              @GemText(value="Step "+step.index),
              @GemText(value=step.type),
              @GemText(value=" took "),
              @GemText(value=step.timeConsumption+ " seconds."),
              /*@guard(true) { // ensure that step.description is not null
                @GemText(value=step.description);
              },*/
              sensorValues@GemText(value=" Value"),
              editStep@GemLink(url="gui/process/ProcessStepCreate/", text="Edit Step")
            ]
          );
        }
      ]
    )
  )]);
}
