package gui.process;

import DemoRec.Process;
import DemoRec.ProcessStep;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemLink;
import mc.fenix.basic.GemButton;


import gui.staticcontainer.NavContainer;
import gui.step.ProcessStepCreate;
import gui.step.StepTable;
import gui.pack.BatteryPackOverview;
import gui.pack.ComponentsOfPack;
import gui.joinconnection.JoinConnectionCreate;
import gui.component.ComponentCreate;


page ProcessOverview(Process p) {

  @NavContainer(
      content=[
        @GemCard(
          title="Deconstruction Process of Pack",
          component=@BatteryPackOverview(pack=p.deconstructionOf)
        ),
        @GemColumn(
          rowGap="15px",
          components = [
            stepCreate@ProcessStepCreate(create = attachStep()),
            @StepTable(process=p)
          ]
        )
      ],
      leftSideBar=[
        @ComponentsOfPack(pack=p.deconstructionOf)
      ]);
}
