package gui.staticcontainer;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemGrid;
import mc.fenix.basic.GemButton;

import gui.staticcontainer.Navigation;
import gui.staticcontainer.Footer;

component NavContainer(List<GUIViewElement> content, List<GUIViewElement> leftSideBar) {
  @GemColumn(
    components=[
      @Navigation(),
      @GemRow(
        hAlign="center",
        components=[
          @GemGrid(
            hAlign="space-between",
            x=["20rem", "70rem", "20rem"],
            cols=[
              [@GemColumn(rowGap= "5px", components=[
                  @GemButton(label="Toggle SideBar", leftClick=toggleSideBar()),
                  @GemColumn(components=leftSideBar)
              ])],
              [@GemColumn(rowGap = "5px", components = [
                mainCol@GemColumn(components = content)
              ])]
            ]
          )
        ]
      )
    ]
  );
  @Footer();
}
