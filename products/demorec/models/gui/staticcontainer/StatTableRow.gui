package gui.staticcontainer;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

component StatTableRow(GUIViewElement left, GUIViewElement right) {
  @GemRow(components = [
    leftComponent@GemColumn(width = "15ch", components = [left]),
    rightComponent@GemColumn(width = "fit-content", components = [right])
  ]);
}
