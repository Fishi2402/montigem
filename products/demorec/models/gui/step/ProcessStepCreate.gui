package gui.step;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import DemoRec.ProcessStep;
import DemoRec.Process;
import DemoRec.MeasuringValue;

import gui.connectionkind.JoinConnectionKindCreate;
import gui.measuringvalues.MeasuringValueEdit;

page ProcessStepCreate(ProcessStep step, Event<ProcessStep> create) {
  @GemColumn(
    rowGap="5px",
    components=[
  stepCreationCard@GemCard(
      title = "New Step",
      component = @GemColumn(
        rowGap="10px",
        components = [
          deconstructionGuard@guard(true) {
            selectType@GemDropdownInput(
              labelText = "Step type",
              options = null,
              entry = null,
              width="var(--smallDropDownWidth)");
          },
          stepChooseJoinConnectionKind@guard(true){
            isDeconstruction@guard(true) {
              selectJoinConnection@GemDropdownInput(
                  labelText = "Deconstructing Join Connection",
                  options = null,
                  entry = null,
                  width="var(--largeDropDownWidth)");
            }
            createNewJoinConnection@guard(true) {
              @JoinConnectionKindCreate(createJoinConnectionKind=addNewJoinConnectionKind());
            }
          },
          stepProcessStepRelated@guard(true) {
            @GemColumn(
              rowGap="5px",
              components=[
                @GemRow(
                  wrap="noWrap",
                  colGap="5px",
                  vAlign="bottom",
                  components = [
                    @GemColumn(
                      width="var(--smallDropDownWidth)",
                      components = [
                        timeConsumption@GemTextInput(
                          labelText = "Time Consumption (s)",
                          inputType = "number",
                          entry = step.timeConsumption,
                          width="var(--smallDropDownWidth)"
                        )
                      ]
                    ),
                    @GemColumn(
                      width="var(--smallNumberWidth)",
                      components = [
                        timerGuard@guard(true) {
                          startTimerButton@GemButton(label = "Timer", leftClick = startTimer(), disabled=true, height="var(--gemButtonHeightAdjustedToInput)");
                        } else {
                          stopTimerButton@GemButton(label = "Stop", leftClick = stopTimer(), disabled=false, height="var(--gemButtonHeightAdjustedToInput)");
                        }
                      ]
                    ),
                    @GemColumn(
                      hAlign="center",
                      vAlign="bottom",
                      width="var(--smallNumberWidth)",
                      components = [
                        passedTime@GemText(value="override")
                      ]
                    )
                  ]
                ),
                @GemTextInput(
                    labelText = "Description (mandatory for Other)",
                    inputType = "text",
                    entry = step.description,
                    width="var(--largeDropDownWidth)"),
                selectEndeffector@GemDropdownInput(
                    labelText = "Used Endeffector in this step",
                    options = null,
                    entry = null,
                    width="var(--smallDropDownWidth)"),
                @MeasuringValueEdit(step = step)
              ]
            );
          },
          @GemRow(
            colGap="5px",
            vAlign="bottom",
            components=[
              amountOfConnsAndSteps@GemTextInput(
                  labelText="Connection & Step Copies",
                  inputType = "number",
                  entry=null,
                  width="var(--textWidth)"
              ),
              buildStep@GemButton(label = "Save Steps", leftClick = createNewStep(), disabled=true, height = "var(--gemButtonHeightAdjustedToInput)")
            ]
          )
        ]
      )
    )
  ]);

}
