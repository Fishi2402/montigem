package gui.step;

import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import DemoRec.ProcessStep;
import DemoRec.Process;
import DemoRec.MeasuringValue;

import gui.joinconnection.JoinConnectionCreate;
import gui.measuringvalues.MeasuringValueEdit;

page ProcessStepCreate(ProcessStep step, Event<ProcessStep> create) {
  @GemColumn(
    rowGap="5px",
    components=[
  stepCreationCard@GemCard(
      title = "New Step",
      component = @GemColumn(
        rowGap="10px",
        components = [
          deconstructionGuard@guard(true) {
            selectType@GemTextInput(
              labelText = "Step type",
              inputType = "dropdown",
              options = null,
              entry = null);
          },
          stepChooseJoinConnection@guard(true){
            isDeconstruction@guard(true) {
              selectJoinConnection@GemTextInput(
                  labelText = "Deconstructing Join Connection",
                  inputType = "dropdown",
                  options = null,
                  entry = null);
            }
            createNewJoinConnection@guard(true) {
              @JoinConnectionCreate(createJoinConnection=addNewJoinConnection);
            }
          },
          stepProcessStepRelated@guard(true) {
            @GemRow(
              colGap="5px",
              components= [
                @GemColumn(
                  components=[
                    @GemRow(
                      wrap="noWrap",
                      colGap="5%",
                      components = [
                        @GemColumn(
                          width="30%",
                          components = [
                            timerGuard@guard(true) {
                              startTimerButton@GemButton(label = "Start", leftClick = startTimer(), disabled=true);
                            } else {
                              stopTimerButton@GemButton(label = "Stop", leftClick = stopTimer(), disabled=false);
                            }
                          ]
                        ),
                        @GemColumn(
                          hAlign="center",
                          vAlign="center",
                          width="10%",
                          components = [
                            passedTime@GemText(value="override")
                          ]
                        ),
                        @GemColumn(
                          width="50%",
                          components = [
                            timeConsumption@GemTextInput(
                              labelText = "Time Consumption in seconds",
                              inputType = "number",
                              entry = step.timeConsumption
                            )
                          ]
                        )
                      ]
                    ),
                    @GemTextInput(
                        labelText = "Description (optional)",
                        inputType = "text",
                        entry = step.description),
                    selectEndeffector@GemTextInput(
                        labelText = "Used Endeffector in this step",
                        inputType = "dropdown",
                        options = null,
                        entry = null)
                  ]
                ),
                @GemColumn(
                  components=[@MeasuringValueEdit(step = step)]
                )
              ]
            );
          },
          @GemRow(
            colGap="5px",
            components=[
              amountOfConnsAndSteps@GemTextInput(
                  labelText="Number of Connection/Step Copies",
                  inputType = "number",
                  entry=null
              ),
              buildStep@GemButton(label = "Save Steps", leftClick = createNewStep(), disabled=true)
            ]
          )
        ]
      )
    )
  ]);

}
