package gui.step;

import DemoRec.ProcessStep;
import DemoRec.Process;

import gui.staticcontainer.NavContainer;
import gui.pack.ComponentsOfPack;
import gui.step.ProcessStepEdit;

page ProcessStepEditPage(Process p, ProcessStep step) {

  @NavContainer(
    content=[@ProcessStepEdit(p=p, step=step)],
    leftSideBar=[@ComponentsOfPack(pack=p.deconstructionOf)]
    );
}
