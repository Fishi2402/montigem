package gui.step;

import DemoRec.Process;
import DemoRec.ProcessStep;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemGrid;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;

import gui.staticcontainer.HorizontalStatTable;
import gui.staticcontainer.EvenlySpacedColumn;

component StepTable(Process process) {

  @GemGrid(
    rowGap="5px",
    x=["4rem","8rem","8rem","8rem","6rem","8rem","8rem","8rem","4rem"],
    rows=[
      [
        @GemText(value = "Edit"),
        @GemText(value = "Type"),
        @GemText(value = "Description"),
        @GemText(value = "Endeffector"),
        @GemText(value = "Duration (s)"),
        @GemText(value = "Values"),
        @GemText(value = "Connection"),
        @GemText(value = "Components"),
        @GemText(value = "Deletion")
      ],
      [
        @iterate(ProcessStep step : getReverseProcessSteps()) {
          editStepButton@GemButton(label = "Edit " + step.index, leftClick = editStep(step));
          @GemText(value = step.type);
          @GemText(value = step.description);
          @GemText(value = step.uses.name);
          @GemText(value = step.timeConsumption);
          measuredValuesCount@GemText(value = null);
          @GemText(value = getConnectionType(step));
          @GemText(value = getComponents(step));
          deleteProcessStep@GemButton(label="Delete", leftClick=deleteStep(step), disabled=false);
      }
      ]
    ]
  );
}

