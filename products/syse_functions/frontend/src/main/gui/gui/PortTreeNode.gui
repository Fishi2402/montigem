package gui;

import gui.ChannelTreeNode;
import FunctionStructure4Fenix.Function;
import FunctionStructure4Fenix.Port;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemTreeNode;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemCheckBoxInput;

component PortTreeNode(Port port, List<Function> selectedFunctions, List<Channel> selectedChannels, List<Port> selectedPorts, Boolean selected) {
    @GemTreeNode(content =
      @GemRow(components = [
        @GemText(value = "Port: " + port.name),
        portSelection@GemCheckBoxInput(checked = selected)
      ]),
    children = [
    @ChannelTreeNode(channel = port.channel, selectedFunctions = selectedFunctions, selectedChannels = selectedChannels, selectedPorts = selectedPorts)
  ]);
}
