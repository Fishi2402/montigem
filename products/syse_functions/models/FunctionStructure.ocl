ocl FunctionsStructure {

/*
  Die Dekompositions-Struktur (Architektur) einer Funktion
  ist eine Baumstruktur, also kein loop und kein DAG.
  Wir erlauben aber unzusammenhängende Komponenten (Wald).
  
  TODO: Bem BR: nachfolgende Spezifikation könnte richtig sein, 
  aber sie ist auch unnötig, weil "composition" im CD 
  das per Konstruktion bereits festschreibt.
  Also löschen.
  
  context Function f inv loopFreeHierarchy:
    !f in f.subfunctions.subfunctions**; 

  context Function f,g,h inv singleContainment:
    f in g.subfunctions && f in h.subfunctions implies g==h; 
*/


/*
  Assoziationen von Input Port zu Output Port setzt voraus, 
  dass sich die zugehörigen Funktionen entweder auf gleicher
  Hierarchiestufe befinden oder dass es einen validen "Pfad" 
  gibt, welcher sich durch die Hierarchie zieht (Stichwort
  gleiches Portobjekt bei Verknüpfung zw. äußerer und 
  interer Funktion)
  
  Dafür folgende Constraints:
*/

  /*
    In each component structure there is only one feed 
    for an inpout port: either a sister-component or from the outside:
  */
  context Function f, InPort p inv validPortStructureInDecomposition:
      p in f.inPort implies 
          p in f.owner.inPort xor
          p in f.owner.subFunction.outPort;

  /*
    OutPorts are present in the signature of a containing
    function f, when they are defined inside and used outside
  */
  context Function f inv validOutPortPath:
      let externals = { OutPort p in f.outPort | 
                  p.in.setminus(f.owner.subfunction**) != {} }
      in
        f.owner.outPort.contains(externals);


// TODO BR: ... ob das stimmt: ich wage das zu bezweifeln. Aber eine Prüfung wäre sinnvoll

}


