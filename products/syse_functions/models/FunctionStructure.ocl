ocl FunctionsStructure {
/*
  Die Dekompositions-Struktur (Architektur) einer Funktion
  ist eine Baumstruktur (innerhalb einer Funktion darf
  es Zykel geben)
*/
/*
  context Function inv treeStructure:
    azyklisch
*/

/*
  Assoziationen zwischen zwei Funktionen gibt es nur innerhalb
  der gleichen Hierarchiestufe in einer äußeren Funktion
*/
/*
  context Function f inv hierarchy:
    forall sf1 in f.subfunctions:
      for all inport in sf1.inPorts:
        inport.out.isPresent() implies
          exists Function sf2 in f.subfunctions:
            exists outport in sf2.outPorts:
              inport.out == outport
*/
}



