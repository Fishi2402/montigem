ocl FunctionStructure4Fenix {

  /*
    Ensure that the emulation of the qualified associations only allows
    structures that where
    possible before:
    Each Port represents either the in or the out qualifier from a
    Function to a Channel, but not
    both at the same time.
  */
  context Port p inv PortInXorOut:
    (ownerIn.isPresent() && ownerOut.isEmpty())
    || (ownerIn.isEmpty() && ownerOut.isPresent());
}
