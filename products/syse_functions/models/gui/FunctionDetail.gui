package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;

import gui.Navigation;

import FunctionStructure4Fenix.Function;
import FunctionStructure4Fenix.Port;
import FunctionStructure4Fenix.Value;

page FunctionDetail (Function f) {
  @GemRow(width = "100%", components = [
    @Navigation(),
    @GemColumn(width = "100%", component =
      @GemCard(title = f.name, component =
        @GemRow(width = "100%", colGap="10px", components = [
          ports@GemColumn(width = "30%", components = [
            @GemText(value = "Ports"),
            @iterate(Port p : f.in) {
              @GemText(value = "Input Port " + p.channel.category.type.mctype + " " + p.name);
            },
            @iterate(Port p : f.out) {
              @GemText(value = "Output Port " + p.name);
            }
          ]),
          channels@GemColumn(width = "40%", components = [
            @GemText(value = "Channels"),
            @iterate(Port p : f.in) {
              @GemRow(components = [
                @GemText(value = p.name + " : "),
                // Klappt noch nicht, weil immer Promises zurückgegeben werden
                //              @iterate(Value v : p.channel.functionStream.value) {
                //                valueText@GemText(value = "");
                //              }
                valueTextIn@GemText(value = "")
              ]);
            },
            @iterate(Port p : f.out) {
              @GemRow(components = [
                @GemText(value = p.name + " : "),
                valueTextOut@GemText(value = "")
              ]);
            }
          ]),
          subFunctions@GemColumn(width = "15%", components = [
            @GemText(value = "Sub Functions"),
            @iterate(Function sf : f.subFunction) {
              @GemRow(width = "auto", rowGap="10px", colGap="10px", components = [
                @GemText(value = sf.name),
                @GemButton(label = "Details", leftClick = goToFunctionDetailsSub(sf))
              ]);
            }
          ])
          //,
          //@guard(f.owner != null) {
          //  superFunction@GemColumn(width = "15%", components = [
          //    @GemText(value = "Super Function"),
          //    @GemRow(width = "auto", rowGap="10px", colGap="10px", components = [
          //      @GemText(value = f.owner.name),
          //      @GemButton(label = "Details", leftClick = goToFunctionDetailsSuper(f.owner))
          //    ])
          //  ]);
          //}
        ])
      )
    )
  ]);
}
