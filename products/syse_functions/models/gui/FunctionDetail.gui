package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;

import gui.Navigation;
import gui.FunctionTreeNode;

import FunctionStructure4Fenix.Function;
import FunctionStructure4Fenix.Port;
import FunctionStructure4Fenix.Value;
import FunctionStructure4Fenix.Channel;

import mc.fenix.functiondisplay.FunctionDisplay;
import mc.fenix.functiondisplay.FunctionStructure4Fenix.Function4Display;
import mc.fenix.functiondisplay.FunctionStructure4Fenix.Channel4Display;
import mc.fenix.functiondisplay.FunctionStructure4Fenix.Port4Display;


import mc.fenix.charts.GemLineChart;
import mc.fenix.charts.GemLineChartTypes.GemLineChartData;

page FunctionDetail (Function f, List<Function> selectedFunctions, List<Port> selectedPorts, List<Channel> selectedChannels, Channel selectedChannel, List<Function4Display> functions4Display, List<Channel4Display> channels4Display, List<Port4Display> ports4Display) {
  @GemRow(width = "100%", colGap="10px", components = [
    @Navigation(),
    @GemRow(height = "50%", components = [
      @GemColumn(width = "100%", component =
        @GemCard(title = f.name, component =
          @GemColumn(width = "100%", components = [
            @guard(f.owner != null) {
              @GemRow(components = [
                owningFunctionButton@GemButton(label = "Back To Owning Function \"" + f.owner.name + "\"",
                leftClick = goToFunctionDetailsSuper(f))
              ]);
            },
            @GemRow(width = "100%", colGap="10px", components = [
              ports@GemColumn(width = "auto", components = [
                @GemText(value = "Ports", size = "large"),
                @iterate(Port p : f.in) {
                  @GemText(value = "Input Port " + " " + p.name);
                },
                @iterate(Port p : f.out) {
                  @GemText(value = "Output Port " + p.name);
                }
              ]),
              datatypes@GemColumn(width = "auto", components = [
                @GemText(value = "Datatype", size = "large"),
                @iterate(Port p : f.in) {
                  @GemText(value = p.channel.category.type.mctype);
                },
                @iterate(Port p : f.out) {
                  @GemText(value = p.channel.category.type.mctype);
                }
              ]),
              channelValues@GemColumn(width = "auto", components = [
                @GemText(value = "Values", size = "large"),
                @iterate(Port p : f.in) {
                  @GemRow(components = [
                    // @GemText(value = p.name + " : "),
                    // Klappt noch nicht, weil im genererierten HTML Promises zurückgegeben werden
                    //              @iterate(Value v : p.channel.functionStream.value) {
                    //                valueText@GemText(value = "");
                    //              }
                    valueTextIn@GemText(value = "")
                  ]);
                },
                @iterate(Port p : f.out) {
                  @GemRow(components = [
                    valueTextOut@GemText(value = "?")
                  ]);
                }
              ]),
              subFunctions@GemColumn(width = "auto", components = [
                @GemText(value = "Sub Functions", size = "large"),
                @iterate(Function sf : f.subFunction) {
                  @GemRow(width = "auto", rowGap="10px", colGap="10px", components = [
                    @GemText(value = sf.name),
                    @GemButton(label = "Details", leftClick = goToFunctionDetailsSub(sf))
                  ]);
                }
              ]),
              @GemColumn(width = "auto",
              component = @FunctionTreeNode(func = f,
                selectedFunctions = selectedFunctions,
                selectedChannels = selectedChannels,
                selectedPorts = selectedPorts
              )
              )
            ]),
            @GemRow(width = "100%", component =
              funcDisplay@FunctionDisplay(data = transformData(f),
                functionClick = goToFunction4DisplayDetails(),
                outsideClick = goToFunctionDetailsSuper2(f),
                channelClick = toggleChannelSelection(),
                portClick = togglePortSelection(),
                selectedFunctions = functions4Display,
                selectedChannels = channels4Display,
                selectedPorts = ports4Display
              )
            ),
            @GemRow(height = "50%", components = [
              evalguard@guard(selectedChannel != null) {
                @GemRow(height = "100%", components = [
                  channelValues2@GemText(value = ""),
                  channelLineChart@GemLineChart(data = null)
                ]);
              }
            ])
          ])
        )
      )
    ])

  ]);
}
