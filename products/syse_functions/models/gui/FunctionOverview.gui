package gui;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;

import gui.Navigation;

import FunctionStructure4Fenix.Function;

page FunctionOverview (List<Function> functions) {
  @GemRow(components = [
    @Navigation(),
    @GemColumn(components = [
      @iterate(Function f: functions) {
        @GemRow(width = "auto", rowGap="10px", colGap="10px", components = [
          @GemText(value = f.name),
          @GemButton(label = "Details", leftClick = goToFunctionDetails(f))
        ]);
      }
    ])
  ]);
}
