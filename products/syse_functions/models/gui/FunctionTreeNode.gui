package gui;
import gui.PortTreeNode;
import FunctionStructure4Fenix.Function;
import FunctionStructure4Fenix.Port;
import FunctionStructure4Fenix.Channel;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemTreeNode;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import mc.fenix.input.GemCheckBoxInput;

component FunctionTreeNode(Function func, List<Function> selectedFunctions, List<Channel> selectedChannels, List<Port> selectedPorts, Boolean selected) {
  @GemTreeNode(
  content =
    @GemRow(components = [
      @GemText(value = func.name),
      functionSelection@GemCheckBoxInput(checked = selected),
      @GemButton(label = "Go to Function", leftClick = goToFunctionDetails(func))
    ]),
  children = [
    @GemTreeNode(
      content = @GemText(value = "Subfunctions"),
      children = [
        @iterate(Function f: func.subFunction) {
          @FunctionTreeNode(func = f, selectedFunctions = selectedFunctions, selectedChannels = selectedChannels, selectedPorts = selectedPorts);
        }
      ]),
    @GemTreeNode(content = @GemText(value = "In Ports"),
      children = [
        @iterate(Port p: func.in) {
          @PortTreeNode(port = p, selectedFunctions = selectedFunctions, selectedChannels = selectedChannels, selectedPorts = selectedPorts);
        }
      ]),
    @GemTreeNode(content = @GemText(value = "Out Ports"),
      children = [
        @iterate(Port p: func.out) {
          @PortTreeNode(port = p, selectedFunctions = selectedFunctions, selectedChannels = selectedChannels, selectedPorts = selectedPorts);
        }
      ])
  ]);
}
