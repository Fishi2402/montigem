{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {

    "@umlp/basic": {
      "projectType": "library",
      "root": "projects/umlp/basic",
      "sourceRoot": "projects/umlp/basic/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/umlp/basic/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/umlp/basic/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/umlp/basic/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/umlp/basic/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
