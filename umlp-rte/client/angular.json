{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:library": {
      "entryFile": "index",
      "prefix": "gem"
    }
  },
  "projects": {
    "@umlp/basic": {
      "projectType": "library",
      "root": "projects/umlp/mc/fenix/basic",
      "sourceRoot": "projects/umlp/mc/fenix/basic/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/umlp/mc/fenix/basic/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/umlp/mc/fenix/basic/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/umlp/mc/fenix/basic/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/umlp/mc/fenix/basic/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
