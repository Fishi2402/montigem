package input;

import input.GemTextInputTypes.GemTextInputValidity;

//This component represents an input field with an optional label.
//It is designed to be used in forms or other contexts where user input is required.

component GemTextInput(
  String id,
  String labelText,
  String inputType,
  List<String> options,
  ?String entry,
  boolean disabled = false,
  String placeholder = "",
  GemTextInputValidity validity,
  Event keyRelease,
  Event keyPress
)
