package mc.fenix.arrange;

/**
  GemGrid is a container which arranges input elements in a grid pattern.
*/
component GemGrid(
  /**
    Height of the component in `px`, `%`, `vh`. By default collapses to a
    minimal possible height with respect to content.
  */
  String height = "auto",
  /**
    Width of the component in `px`, `%`, `vh`. By default collapses to a
    minimal possible height with respect to content.
  */
  String width = "auto",
  /**
    Horizontal alignment of the embedded components. Invalid values are ignored.
    Possible values:
    `"left"`, `"center"`, `"right"`: Set position of the elements inside the container.
    `"stretch"`: Stretch elements proportionally to fill space if the elements' size is not specified.
    `"space-between"`: Distribute empty space equally between the elements.
    `"space-around"`: Distribute empty space around each element equally.
    `"space-evenly"`: Distribute empty space around the elements and make those gaps equal size.
  */
  String hAlign = "stretch",
  /**
    Vertical alignment of the embedded components. Invalid values are ignored.
    Possible values:
    `"top"`, `"center"`, `"bottom"`: Set position of the elements inside the container.
    `"stretch"`: Stretch elements proportionally to fill space if the elements' size is not specified.
    `"space-between"`: Distribute empty space equally between the elements.
    `"space-around"`: Distribute empty space around the elements equally.
    `"space-evenly"`: Distribute empty space around the elements and make those gaps equal size.
  */
  String vAlign = "stretch",
  /**
    Gap between rows of elements in the container in `px`, `%`, `vh`, etc.
  */
  String rowGap = "0",
  /**
    Gap between columns of elements in the container in `px`, `%`, `vh`, etc.
  */
  String colGap = "0",
  /**
    Specifies widths of grid columns. The amount of columns is equal to the length of the list.
  */
  List<String> x,
  /**
    Specifies heights of grid rows. The amount of rows is equal to the length of the list.
  */
  List<String> y,
  /**
    Rows of a grid. The length of the longest row defines the amount of columns, unless `x` is specified.
    If `rows` and `cols` are defined, `rows` are used.
  */
  List<List<GUIViewElement>> rows,
  /**
    Columns of a grid. The length of the longest column defines the amount of rows, unless `y` is specified.
  */
  List<List<GUIViewElement>> cols,
  /**
    Cells of a grid. Normally set to a list of `GemGridCell` component that can specify the space
    occupied by a cell. The cells may overlap.
    If `cells`, `rows` and `cols` are defined, `cells` are used.
  */
  List<GUIViewElement> cells
)
