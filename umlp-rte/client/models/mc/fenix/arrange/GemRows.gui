package mc.fenix.arrange;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

component GemRows(List<GUIViewElement> components, String height) {
  @GemRow(hAlign = "left",  component =
    @iterate(GUIViewElement comp : components) {
      @GemColumn(style="gem-rows-item", height=height, component = comp);
    }
  );
}
