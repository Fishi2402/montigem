package mc.fenix.basic;

/**
  The image component embeds image on a page.
*/
component GemImage(
  /**
    Height of the component in `px`, `%`, `vh`. By default takes up all
    available space while preserving aspect ratio.
  */
  String height = "auto",
  /**
    Width of the component in `px`, `%`, `vh`. By default takes up all
    available space while preserving aspect ratio.
  */
  String width = "auto",
  /**
    The path to the image file. It can be a URL or a relative path.
    The relative path starts from the root folder (typically `src/`).
  */
  String source,
  /**
    The text that is shown if image could not be loaded.
  */
  String alt = "",
  /** **Deprecated.** */
  String style = ""
)
