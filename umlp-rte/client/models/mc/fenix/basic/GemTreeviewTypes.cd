package mc.fenix.basic;

import java.util.List;

/**
  Types used in a GemTreeview component.
*/
classdiagram GemTreeviewTypes {

  /**
    Tree node description.
  */
  public class GemTreeviewEntry {
    /** Whether the tree node is expanded or not. */
    boolean expanded;
    /** The displayed name of the entry. */
    String name;
    /** The internal representation of the entry, e.g. for use in the leftClick event */
    String value;
    /** The children of the node. */
    List<GemTreeviewEntry> children;
  }

}
