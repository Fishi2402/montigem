package mc.fenix.input;

/**
  The component is a checkbox with a label. It is used whenever an input for a
  binary choice is required, e.g., agreeing to terms and conditions or opting in
  to a newsletter.
*/
component GemCheckBoxInput(
  /**
    A unique id ensures proper screen reader functionality for the checkbox
    description.
  */
  String id,
  /** The position of the label, can be `"left"` or `"right"`. */
  String labelPosition = "right",
  /** The text of the checkbox label. */
  String labelText = "",
  /** Whether the input field is disabled. */
  boolean disabled = false,
  /** Indicates if the checkbox is checked (`true`) or not (`false`). */
  ?boolean checked
)
