package mc.fenix.input;

/**
  Types used in a GemTextInput component.
*/
classdiagram GemTextInputTypes {

  /**
    An object representing the validation status of the field.
  */
  public class GemTextInputValidity {
    /**
      The validation status.
      Possible values:
      `"Error"`: There is a problem or issue that needs attention.
      `"Unchecked"`: The input has not been inspected.
      `"Success"`: Positive validation result.
      `"Warning"`: There is a potential issue that should be noted.
    */
    String status;
    /** A message to be displayed as a tooltip with the status */
    String message;
  }

  /**
    An object representing a dropdown option.
  */
  public class Option {
    /**
      Value behind the option in a dropdown. An option typically represents an
      object, e.g. person, via human-readable name. The value is an identifier
      that represents the object in the logic implementation.
    */
    String value;
    /** Human-readable name representing the option. */
    String display;
    +Option(String value);
    +Option(String value, String display);
  }

}
