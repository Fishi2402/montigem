package mc.fenix.networkgraph;
import java.util.List;
import java.util.Optional;

classdiagram NetworkGraphTypes {

  public class Graph {
    List<GraphNode> nodes;
    List<GraphEdge> edges;
  }

  public class GraphNode {
    String id;
    Integer value;
    String label;
    Integer size;
    String color;
    String group;
    Optional<String> vertexShape; // Allowed values are triangle, square, circle defaul is circle
  }

  public class GraphEdge {
    String from;
    String to;
    Integer weight;
  }

}
