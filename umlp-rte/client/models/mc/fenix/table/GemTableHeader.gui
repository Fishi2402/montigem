package mc.fenix.table;

/**
  A table row that identifies the head of the table, adds some default styling to text content.
*/
component GemTableHeader(
  /**
    Columns of a table header row.
  */
  List<String> cols,
  /**
    Cells of a table header. Normally set to a list of `GemTableHeaderCell` component that can specify
    if a cell spans over multiple columns or rows.
    If `cells` and `cols` are defined, `cells` are used.
  */
  List<GUIViewElement> cells
)
