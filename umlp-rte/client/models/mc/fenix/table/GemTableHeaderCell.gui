package mc.fenix.table;

/**
  GemTableHeaderCell controls dimensions that content should occupy within a GemTable's header.
*/
component GemTableHeaderCell(
  /**
    Number of collumns a cell should cover
  */
  int colSpan = 1,
  /**
    Number of rows a cell should cover
  */
  int rowSpan = 1,
  GUIViewElement content
)
