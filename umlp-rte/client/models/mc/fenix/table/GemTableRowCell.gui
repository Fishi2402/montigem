package mc.fenix.table;

/**
  GemTableRowCell controls dimensions that content should occupy within a GemTable's body.
*/
component GemTableRowCell(
  /**
    Number of columns a cell should cover
  */
  int colSpan = 1,
  /**
    Number of rows a cell should cover
  */
  int rowSpan = 1,
  GUIViewElement content
)
