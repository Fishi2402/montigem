package table;

/**
  Types used in a GemTable component
*/
classdiagram TableTypes {

  /**
    Table column description
  */
  public class TableColumn {
    /**
      Name of a object property to read the value for the column from.
      Example: Given objects of type `class Person { String name; }` the value of prop would be
      `"name"` to display names of persons in each row for the column.
    */
    String prop;
    /**
      Name of the column. Typically describes the `TableColumn#prop` that will be displayed in the
      column.
    */
    String name;

    TableColumn(String prop, String name);
  }

}
