package arrange.src.lib.gemdashboard;

import arrange.src.lib.gemrow.GemRow;
import arrange.src.lib.gemcolumn.GemColumn;

component GemDashboard(List<GUIViewElement> components) {
  @GemRow(style = "gem-dashboard", hAlign = "spaceEvenly", component =
    @iterate (GUIViewElement c : components) {
      @GemColumn(style = "gem-dashboard-item", width = "30%", component = c);
    }
  );
}
