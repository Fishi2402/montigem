{
  "compileOnSave": false,
  "compilerOptions": {
     "rootDir": ".",
    "noUnusedLocals": false,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": "./projects",
  },
  "exclude": ["node_modules", "tmp"]
}
