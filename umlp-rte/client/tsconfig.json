/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@umlp/common": [
        "./projects/umlp/mc/fenix/common/src"
      ],
      "@umlp/commonj2ts": [
        "./projects/umlp/mc/fenix/commonj2ts/src"
      ],
      "@umlp/arrange": [
        "./projects/umlp/mc/fenix/arrange/src"
      ],
      "@umlp/basic": [
        "./projects/umlp/mc/fenix/basic/src"
      ],
      "@umlp/charts": [
        "./projects/umlp/mc/fenix/charts/src"
      ],
      "@umlp/composite": [
        "./projects/umlp/mc/fenix/composite/src"
      ],
      "@umlp/experimental": [
        "./projects/umlp/mc/fenix/experimental/src"
      ],
      "@umlp/input": [
        "./projects/umlp/mc/fenix/input/src"
      ],
      "@umlp/table": [
        "./projects/umlp/mc/fenix/table/src"
      ],
      "@umlp/theme": [
        "./projects/umlp/mc/fenix/theme/src"
      ],
      "@umlp/networkgraph": [
        "./projects/umlp/mc/fenix/networkgraph/src"
      ]
    },
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
