/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "*": [
        "./projects/common/*",
        "./projects/commonj2ts/*",
        "./projects/arrange/*",
        "./projects/basic/*",
        "./projects/charts/*",
        "./projects/composite/*",
        "./projects/experimental/*",
        "./projects/input/*",
        "./projects/table/*",
        "./projects/theme/*",
        "./projects/networkgraph/*"
      ],
      "@umlp/common": [
        "./projects/common"
      ],
      "@umlp/commonj2ts": [
        "./projects/commonj2ts"
      ],
      "@umlp/arrange": [
        "./projects/arrange"
      ],
      "@umlp/basic": [
        "./projects/basic"
      ],
      "@umlp/charts": [
        "./projects/charts"
      ],
      "@umlp/composite": [
        "./projects/composite"
      ],
      "@umlp/experimental": [
        "./projects/experimental"
      ],
      "@umlp/input": [
        "./projects/input"
      ],
      "@umlp/table": [
        "./projects/table"
      ],
      "@umlp/theme": [
        "./projects/theme"
      ],
      "@umlp/networkgraph": [
        "./projects/networkgraph"
      ]
    },
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": [
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
