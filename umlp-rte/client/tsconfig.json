/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@umlp/common": [
        "./projects/common"
      ],
      "@umlp/commonj2ts": [
        "./projects/commonj2ts"
      ],
      "@umlp/arrange": [
        "./projects/arrange"
      ],
      "@umlp/basic": [
        "./projects/basic"
      ],
      "@umlp/charts": [
        "./projects/charts"
      ],
      "@umlp/input": [
        "./projects/input"
      ],
      "@umlp/table": [
        "./projects/table"
      ],
      "@umlp/theme": [
        "./projects/theme"
      ],
      "@umlp/navigation": [
        "./projects/networkgraph"
      ],
      "@umlp/networkgraph": [
        "./projects/networkgraph"
      ],
      "*": [
        "./projects/common/src/*",
        "./projects/commonj2ts/src/*",
        "./projects/functiondisplay/src/*",
        "./projects/arrange/src/*",
        "./projects/basic/src/*",
        "./projects/charts/src/*",
        "./projects/input/src/*",
        "./projects/table/src/*",
        "./projects/theme/src/*",
        "./projects/navigation/src/*",
        "./projects/networkgraph/src/*",

        "./projects/common/build/gui/*",
        "./projects/commonj2ts/build/gui/*",
        "./projects/functiondisplay/build/gui/*",
        "./projects/arrange/build/gui/*",
        "./projects/basic/build/gui/*",
        "./projects/charts/build/gui/*",
        "./projects/input/build/gui/*",
        "./projects/table/build/gui/*",
        "./projects/theme/build/gui/*",
        "./projects/navigation/build/gui/*",
        "./projects/networkgraph/build/gui/*",

        "./projects/common/build/cd/*",
        "./projects/commonj2ts/build/cd/*",
        "./projects/functiondisplay/build/cd/*",
        "./projects/arrange/build/cd/*",
        "./projects/basic/build/cd/*",
        "./projects/charts/build/cd/*",
        "./projects/input/build/cd/*",
        "./projects/table/build/cd/*",
        "./projects/theme/build/cd/*",
        "./projects/navigation/build/cd/*",
        "./projects/networkgraph/build/cd/*"
      ]
    },
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": [
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
