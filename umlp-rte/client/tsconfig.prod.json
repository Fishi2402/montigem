/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "paths": {
      "*": [
        "./projects/common/*",
        "./projects/commonj2ts/*",
        "./projects/arrange/*",
        "./projects/basic/*",
        "./projects/charts/*",
        "./projects/composite/*",
        "./projects/experimental/*",
        "./projects/input/*",
        "./projects/table/*",
        "./projects/theme/*",
        "./projects/networkgraph/*"
      ],
      "@umlp/arrange": [
        "./build/dist/arrange/mc/fenix/arrange"
      ],
      "@umlp/basic": [
        "./build/dist/basic/mc/fenix/basic"
      ],
      "@umlp/charts": [
        "./build/dist/charts/mc/fenix/charts"
      ],
      "@umlp/common": [
        "./build/dist/common/mc/fenix/common"
      ],
      "@umlp/commonj2ts": [
        "./build/dist/commonj2ts/mc/fenix/commonj2ts"
      ],
      "@umlp/composite": [
        "./build/dist/composite/mc/fenix/composite"
      ],
      "@umlp/experimental": [
        "./build/dist/experimental/mc/fenix/experimental"
      ],
      "@umlp/input": [
        "./build/dist/input/mc/fenix/input"
      ],
      "@umlp/table": [
        "./build/dist/table/mc/fenix/table"
      ],
      "@umlp/theme": [
        "./build/dist/theme/mc/fenix/theme"
      ],
      "@umlp/networkgraph": [
        "./build/dist/networkgraph/mc/fenix/networkgraph"
      ]
    },
    "baseUrl": "./"
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
