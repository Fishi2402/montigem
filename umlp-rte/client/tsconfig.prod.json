/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "paths": {
      "@umlp/arrange": [
        "./build/dist/arrange/mc/fenix/arrange"
      ],
      "@umlp/basic": [
        "./build/dist/basic/mc/fenix/basic"
      ],
      "@umlp/charts": [
        "./build/dist/charts/mc/fenix/charts"
      ],
      "@umlp/common": [
        "./build/dist/common/mc/fenix/common"
      ],
      "@umlp/commonj2ts": [
        "./build/dist/commonj2ts/mc/fenix/commonj2ts"
      ],
      "@umlp/composite": [
        "./build/dist/composite/mc/fenix/composite"
      ],
      "@umlp/experimental": [
        "./build/dist/experimental/mc/fenix/experimental"
      ],
      "@umlp/input": [
        "./build/dist/input/mc/fenix/input"
      ],
      "@umlp/table": [
        "./build/dist/table/mc/fenix/table"
      ],
      "@umlp/theme": [
        "./build/dist/theme/mc/fenix/theme"
      ],
      "@umlp/navigation": [
        "./build/dist/navigation/mc/fenix/navigation"
      ],
      "@umlp/networkgraph": [
        "./build/dist/networkgraph/mc/fenix/networkgraph"
      ],
      "*": [
        "./projects/common/src/*",
        "./projects/commonj2ts/src/*",
        "./projects/functiondisplay/src/*",
        "./projects/arrange/src/*",
        "./projects/basic/src/*",
        "./projects/charts/src/*",
        "./projects/input/src/*",
        "./projects/table/src/*",
        "./projects/theme/src/*",
        "./projects/navigation/src/*",
        "./projects/networkgraph/src/*",

        "./projects/common/build/gui/*",
        "./projects/commonj2ts/build/gui/*",
        "./projects/functiondisplay/build/gui/*",
        "./projects/arrange/build/gui/*",
        "./projects/basic/build/gui/*",
        "./projects/charts/build/gui/*",
        "./projects/input/build/gui/*",
        "./projects/table/build/gui/*",
        "./projects/theme/build/gui/*",
        "./projects/navigation/build/gui/*",
        "./projects/networkgraph/build/gui/*",

        "./projects/common/build/cd/*",
        "./projects/commonj2ts/build/cd/*",
        "./projects/functiondisplay/build/cd/*",
        "./projects/arrange/build/cd/*",
        "./projects/basic/build/cd/*",
        "./projects/charts/build/cd/*",
        "./projects/input/build/cd/*",
        "./projects/table/build/cd/*",
        "./projects/theme/build/cd/*",
        "./projects/navigation/build/cd/*",
        "./projects/networkgraph/build/cd/*"
      ]
    },
    "baseUrl": "./"
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
