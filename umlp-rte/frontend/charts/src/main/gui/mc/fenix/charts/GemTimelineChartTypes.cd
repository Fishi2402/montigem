package mc.fenix.charts;

import java.util.Optional;
import java.time.LocalDateTime;

classdiagram GemTimelineChartTypes {
  class TimelineData {
    -> (timeLine) Timeline [*];
  }

  class Timeline {
    Long identifier;
    String name;
    Optional<String> color;
    boolean hidden;
    boolean deactivated;
  }

  class TimelineBlock {
    LocalDateTime start;
    LocalDateTime end;
    String lane;
  }

  association [0..1] Timeline <-> (block) TimelineBlock [*];

}
