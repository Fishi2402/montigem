/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "target": "es2017",
    "module": "es2020",
    "declaration": false,
    "declarationMap": true,
    "inlineSources": true,
    "strict": false,
    "noImplicitReturns": true,
    "types": [
      "jasmine"
    ],
    "baseUrl": "./",
    "paths": {
      "@umlp-rte/target/*": ["src/lib/target/umlp/backendrte/*"],
      "@umlp-rte/hwc/*":    ["src/lib/hwc/umlp/frontendrte/*"]
    }
  },
  "files": [
    "src/test.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.ts"
  ]
}
