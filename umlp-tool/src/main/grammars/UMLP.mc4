/* Alpha-version: This is intended to become a MontiCore stable grammar. */

/**
 * Grammar for the UMLP Language 
 *
 * TODO: Explanations
 * 
 */
grammar UMLP extends de.monticore.CD4Code {

  start CDCompilationUnit;

  /**
   * This rule allows additional keywords for classdiagram
   */
  replacekeyword "classdiagram": "umlp", "ontology", "classdiagram";

  /**
   * This rule allows additional keywords for class
   */
  replacekeyword "class": "entity", "class";

  nokeyword "umlp";

}
