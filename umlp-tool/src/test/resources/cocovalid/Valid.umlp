umlp Valid {

  class A {
    int a;
  }

  class B {
    boolean isTrue;
    /String derivedAttr;
  }

  class C extends B {
    /String derivedAttr;
  }

  interface I;

  enum E;

  association [*] A -> B [0..1];
  association [1] B -> A;
  association A [String] -> B [*];
  association B [[a]] -> A [*];
  association B -> String;
}
