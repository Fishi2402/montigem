umlp A {
  class Foo {
    int fooAttr;
    // Optional<int> optFooAttr;
    // List<int> ListFooAttr;
  }
  public class Bar;
  association Foo -> Bar [0..1];

  public derived class DFoo {
    String dFooAttr;
  }

  class Foo2;
  class Bar2;
  association owns2 Foo2 -> Bar2 [*];

  class Foo3;
  class Bar3;
  association Foo3 -> Bar3 [1];

  class Foo4;
  class Bar4;
  association Foo4 <-> Bar4;

}
