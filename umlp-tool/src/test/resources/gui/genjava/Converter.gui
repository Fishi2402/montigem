package genjava;

import Domain.Person;
import Domain.MaritalStatus;

import util.P;

page Converter(
  Person person,
  Person $per$son,
  Person _per_son,
  boolean test1,
  Boolean test2
) {
  @P(p = person);
  @P(p = $per$son);
  @P(p = _per_son);
  @P(b = test1);
  @P(b = test2);
  @P(s = person.name);
  @P(b = $per$son.employed);
  @P(m = MaritalStatus.MARRIED);
  @P(b = true);
}
