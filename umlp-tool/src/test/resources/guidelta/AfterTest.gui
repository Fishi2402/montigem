package guidelta;

page AfterTest() adapts BaseModel{

    after exampleText: @guard(true){
       @Text(value = "after Text")
    };

    after exampleGuard: @iterate(j from 0 to 5){
       @Text(value = "after Guard" + j)
    };

    after exampleIterate: [@Text(value = "after Iterate 1"), @Text(value = "after Iterate 2")];
}