package guidelta;

page ReplaceTest() adapts BaseModel{

    replace exampleText: @guard(true){
       newGuard@Text(value = "Guard replaces Text")
    };

    replace exampleGuard: @iterate(j from 0 to 5){
       newIterate@Text(value = "Iterate replaces Guard")
    };

    replace exampleIterate: [newComponent1@Text(value = "Text replaces Iterate 1"), newComponent2@Text(value = "Text replaces Iterate 2")];
}