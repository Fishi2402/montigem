package guivariability;

page ReplaceTest() adapts BaseModel{

    replace exampleText: newGuard@guard(true){
       @Text(value = "Guard replaces Text");
    };

    replace exampleGuard: newIterate@iterate(j from 0 to 5){
       @Text(value = "Iterate replaces Guard");
    };

    replace exampleIterate: [newComponent1@Text(value = "Text replaces Iterate 1"), newComponent2@Text(value = "Text replaces Iterate 2")];
}
