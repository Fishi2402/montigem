package de.myWorld;

umlp Cars {

  class Person {
//    String surname, forename;  // TODO: should this be allowed?
    int age;
    -> Contact [0..1];
  }

  class Contact {
    String city;
    int zip;
    String street;
    List<String> email;
  }

  class Car {
    String plate;
  }

  association Person -> Car [*];

}

