umlp RestaurantOrg {

  package actors {
    class Person {
      String name;
      String lastName;
      Date birthday;
      String address;
    }
     class Customer extends Person {
       Date reservationDate;
     }
     class Employee extends Person{
       int id;
       String contract;
     }
  }

  class Restaurant {
    String name;
    String address;
  }

  class Job {
    String jobName;
    int roleID;
  }

  class ServingPersonel extends Job;
  class Waiter extends ServingPersonel;
  class KitchenPersonel extends Job;
  class SousChef extends KitchenPersonel;

  association service [*] human.Customer <-> ServingPersonel [*] ;
  association [*] human.Person (visitedBy) <-> (visits) Restaurant [*] ;
  aggregation [1] Restaurant  -> (staff) Employee [*] ;
  association Person -> Job [0..1];

}
