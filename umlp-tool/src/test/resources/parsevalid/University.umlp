package monticore;
umlp University {

  abstract class Person {
    String Name;
    String nationality;
  }

  class Contact {
    String city;
    int zip;
    String street;
    String email;
  }

  package uni {
    class Student extends Person {
      int semester;
      List<Course> courses;
      StudentStatus status;
      -> Contact [1..*] {ordered};
    }

    class Course {
      String name;
      Person professor;
      Course requirement;
      double grade;
    }

    class SportHall ;

    enum StudentStatus { ENROLLED, EXMATRICULATED, GRADUATED; }
  }

  composition Student -> Course [*];
  association contactBook Person [String] -> Contact;
  association [0..2] Person (parent) <-> (children) Student [*];
  aggregation Course -> SportHall [0..*] ;

}
